        "s7p": { "type": "p", "settings": { "text": "The R&D department should continuously research opportunities for new products. Research should include:" } },
        "s7l": { "type": "list", "settings": { "items": "Starbucks\nDunkin'\nCoffee Industry Trends\nTikTok\nReddit\nInstagram\nPinterest\nSeasonal Trends\nCustomer Requests\nEmerging Food Trends" } },
        "s7p2": { "type": "p", "settings": { "text": "Submit new flavor ideas to management for approval before formulation begins.\nOnce approved:" } },
        "s7l2": { "type": "list", "settings": { "items": "Research the target flavor profile.\nDevelop multiple sample versions if necessary.\nEvaluate each version.\nDocument all changes.\nRecommend the strongest formulation." } },
        "s8": { "type": "sec", "settings": { "num": "8", "title": "Quality Standards" } },
        "s8p": { "type": "p", "settings": { "text": "Every finished flavor should strive to achieve the following:" } },
        "s8l": { "type": "list", "settings": { "items": "Authentic taste\nExcellent aroma\nBalanced sweetness\nPleasant mouthfeel\nClean finish\nStrong performance in intended applications\nConsistency from batch to batch\nHigh customer satisfaction" } },
        "s9": { "type": "sec", "settings": { "num": "9", "title": "Final Approval" } },
        "s9p": { "type": "p", "settings": { "text": "No formulation may move into production without approval from Syruvia Management.\nApproved formulas become the official production standard until future improvements are approved." } },
        "s10": { "type": "sec", "settings": { "num": "10", "title": "Core Philosophy" } },
        "s10p": { "type": "p", "settings": { "text": "Every decision made by the R&D department should support one simple goal:" } },
        "s10c": { "type": "callout", "settings": { "text": "Create the best possible syrup while staying true to the flavor customers know and love." } },
        "s10p2": { "type": "p", "settings": { "text": "Research should guide decisions.\nCustomer feedback should shape improvements.\nQuality should always come before speed.\nEvery new formula should make Syruvia a stronger and more trusted brand." } }
