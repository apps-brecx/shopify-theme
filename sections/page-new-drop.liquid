{%- comment -%}
  Syruvia New Fall Flavors page (Caramel Apple, Date, Pistachio Date).
  Product-page design system (pd): Archivo Black + Archivo + Josefin italic accents,
  ink 2px borders, hard ink offset shadows, cream #FFF8EE, paper #FFFBF4 cards,
  coral #FF6B5C accent. Strip, banner slot (desktop + mobile), fall hero with
  dropping leaves, marquee, sticky-stacking flavor duos (Regular + Sugar-Free with
  New Release tags), Shop all, flavor story cards with tasting notes, flying
  ingredient illustrations, closing CTA.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@500;700;800;900&family=Josefin+Sans:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&display=swap">

{%- assign S = section.settings -%}

<style>
#nd-{{ section.id }}{
  --ink:#1a1a1a;--bg:#FFF8EE;--paper:#FFFBF4;--coral:{{ S.c_accent | default: '#C8681E' }};--gray:#3a3a3a;
  --rad:20px;--rule:2px solid var(--ink);
  --display:'Archivo Black','Archivo',-apple-system,sans-serif;
  --body:'Archivo',-apple-system,sans-serif;
  --script:'Josefin Sans',-apple-system,sans-serif;
  background:var(--bg);color:var(--ink);font-family:var(--body);font-weight:500;
  font-size:16px;line-height:1.6;overflow-x:clip;position:relative;
}
#nd-{{ section.id }} *{box-sizing:border-box;margin:0;}
#nd-{{ section.id }} img{max-width:100%;display:block;}
#nd-{{ section.id }} a{color:inherit;}
#nd-{{ section.id }} .wrap{max-width:1120px;margin:0 auto;padding:0 22px;}
#nd-{{ section.id }} .eyebrow{
  font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.2em;text-transform:uppercase;
  display:inline-block;padding:7px 16px;border:1.5px solid var(--ink);border-radius:999px;background:var(--paper);color:var(--ink);line-height:1.2;
}
#nd-{{ section.id }} .h2{
  font-family:var(--display);font-weight:400;font-size:clamp(28px,4.2vw,50px);line-height:.95;
  letter-spacing:-.005em;text-transform:uppercase;margin:14px 0 0;color:var(--ink);text-wrap:balance;
}
#nd-{{ section.id }} .h2 em,#nd-{{ section.id }} h1 em,#nd-{{ section.id }} .endh em{
  font-family:var(--script);font-weight:300;font-style:italic;text-transform:none;letter-spacing:0;color:var(--coral);display:inline-block;
}
#nd-{{ section.id }} .btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  font-family:var(--display);font-weight:400;font-size:15px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;
  background:var(--ink);color:var(--paper);border:2px solid var(--ink);border-radius:999px;
  padding:0 30px;height:60px;cursor:pointer;white-space:nowrap;
  box-shadow:5px 5px 0 var(--ink);transition:transform .12s ease,box-shadow .12s ease,background .12s ease;
}
#nd-{{ section.id }} .btn:hover{background:var(--coral);transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--ink);}
#nd-{{ section.id }} .btn:active{transform:translate(3px,3px);box-shadow:none;}
#nd-{{ section.id }} .btn--ghost{background:var(--paper);color:var(--ink);box-shadow:4px 4px 0 var(--ink);}
#nd-{{ section.id }} .btn--ghost:hover{background:var(--coral);color:var(--paper);}
#nd-{{ section.id }} .nd-rev{opacity:0;transform:translateY(22px);transition:opacity .65s ease,transform .65s ease;}
#nd-{{ section.id }} .nd-rev.in{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){#nd-{{ section.id }} .nd-rev{opacity:1;transform:none;transition:none;}}

/* ---------- strip ---------- */
#nd-{{ section.id }} .nd-strip{background:var(--ink);color:var(--paper);text-align:center;padding:11px 16px;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.18em;text-transform:uppercase;}

/* ---------- banner, full screen width ---------- */
#nd-{{ section.id }} .nd-banner{padding:0;width:100vw;margin-left:calc(50% - 50vw);}
#nd-{{ section.id }} .nd-banner .bwrap{display:block;width:100%;overflow:hidden;border:0;border-bottom:var(--rule);background:var(--paper);text-decoration:none;}
#nd-{{ section.id }} .nd-banner img{width:100%;height:auto;}
#nd-{{ section.id }} .nd-banner .hint{
  display:flex;align-items:center;justify-content:center;text-align:center;aspect-ratio:21/6;padding:24px;
  color:var(--gray);font-family:var(--script);font-size:14px;line-height:1.5;border:2px dashed var(--ink);border-radius:var(--rad);margin:16px 22px;opacity:.65;
}
#nd-{{ section.id }} .bm{display:none;}
@media (max-width:749px){
  #nd-{{ section.id }} .bm{display:block;}
  #nd-{{ section.id }} .bd.hasm{display:none;}
}

/* ---------- hero ---------- */
#nd-{{ section.id }} .nd-hero{position:relative;text-align:center;padding:clamp(40px,6vw,72px) 0 clamp(36px,5vw,56px);overflow:hidden;}
#nd-{{ section.id }} .nd-hero h1{
  font-family:var(--display);font-weight:400;text-transform:uppercase;color:var(--ink);
  font-size:clamp(36px,8.5vw,78px);line-height:.95;letter-spacing:-.01em;margin-top:20px;text-wrap:balance;
}
#nd-{{ section.id }} .nd-hero h1 .ln{display:block;overflow:hidden;}
#nd-{{ section.id }} .nd-hero h1 .ln span{display:block;transform:translateY(112%);transition:transform .9s cubic-bezier(.16,1,.3,1);}
#nd-{{ section.id }} .nd-hero.go h1 .ln span{transform:none;}
#nd-{{ section.id }} .nd-hero .script{
  font-family:var(--script);font-style:italic;font-weight:400;color:var(--coral);font-size:clamp(19px,4.2vw,28px);
  margin-top:12px;display:inline-block;transform:rotate(-2deg) translateY(12px);opacity:0;transition:opacity .7s ease .3s,transform .7s ease .3s;
}
#nd-{{ section.id }} .nd-hero.go .script{opacity:1;transform:rotate(-2deg);}
#nd-{{ section.id }} .nd-hero .sub{
  max-width:520px;margin:18px auto 0;font-family:var(--script);font-weight:400;font-size:16px;line-height:1.65;color:var(--gray);
  opacity:0;transform:translateY(12px);transition:opacity .7s ease .45s,transform .7s ease .45s;
}
#nd-{{ section.id }} .nd-hero.go .sub{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){#nd-{{ section.id }} .nd-hero h1 .ln span,#nd-{{ section.id }} .nd-hero .script,#nd-{{ section.id }} .nd-hero .sub{transform:none;opacity:1;transition:none;}#nd-{{ section.id }} .nd-hero .script{transform:rotate(-2deg);}}
#nd-{{ section.id }} .nd-leaves{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;}

/* ---------- Fall Mood toggle animation ---------- */
#nd-{{ section.id }} .fmb{
  --fsw:clamp(220px,30vw,320px);--fmoff:#E2D6C2;--fmoffink:#B9A891;--fmline:#E3D5BE;--fmmut:#9A8672;
  --fmdur:{{ S.fmb_dur | default: 9 }}s;
  position:relative;overflow:visible;display:flex;align-items:center;justify-content:center;
  padding:clamp(22px,4vw,40px) 0 10px;
}
#nd-{{ section.id }} .fmb-glow{
  position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none;
  background:radial-gradient(52% 78% at 50% 50%, rgba(200,104,30,.26) 0%, rgba(200,104,30,.06) 46%, rgba(255,248,238,0) 76%);
  opacity:.2;animation:ndfmglow-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-stage{position:relative;display:flex;flex-direction:column;align-items:center;gap:clamp(26px,4vw,40px);animation:ndfmbreathe-{{ section.id }} var(--fmdur) ease-in-out infinite;}
#nd-{{ section.id }} .fmb-head{
  margin:0;font-family:var(--display);font-weight:400;text-transform:uppercase;text-align:center;
  font-size:clamp(42px,9.5vw,96px);line-height:.98;letter-spacing:-.01em;color:var(--fmoffink);
  animation:ndfmhead-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-switchwrap{position:relative;width:var(--fsw);height:calc(var(--fsw) * .5);display:flex;align-items:center;justify-content:center;}
#nd-{{ section.id }} .fmb-switch{
  width:100%;height:100%;border-radius:9999px;position:relative;background:var(--fmoff);
  border:2px solid var(--ink);box-shadow:inset 0 4px 12px rgba(59,42,29,.1);
  animation:ndfmtrack-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-knob{
  position:absolute;top:7.5%;left:7.5%;width:42.5%;height:85%;border-radius:9999px;background:#FFFDF9;
  border:2px solid var(--ink);box-shadow:3px 3px 0 rgba(26,26,26,.25);
  animation:ndfmknob-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-ring{
  position:absolute;left:50%;top:50%;width:calc(var(--fsw) * .6);height:calc(var(--fsw) * .6);
  margin:calc(var(--fsw) * -.3) 0 0 calc(var(--fsw) * -.3);border-radius:50%;border:2px solid var(--coral);
  opacity:0;animation:ndfmring-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-ring2{animation-delay:.2s;}
#nd-{{ section.id }} .fmb-spark{
  position:absolute;left:50%;top:50%;width:7px;height:7px;margin:-3.5px 0 0 -3.5px;border-radius:50%;
  opacity:0;animation:ndfmspark-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-spark.s0{background:var(--coral);animation-delay:.06s;}
#nd-{{ section.id }} .fmb-spark.s1{background:#D99A2B;animation-delay:.1s;width:5px;height:5px;}
#nd-{{ section.id }} .fmb-spark.s2{background:#8C3A1E;animation-delay:.13s;width:4px;height:4px;}
#nd-{{ section.id }} .fmb-spark.s3{background:#6E7746;animation-delay:.17s;}
#nd-{{ section.id }} .fmb-spark.s4{background:#D99A2B;animation-delay:.2s;width:5px;height:5px;}
#nd-{{ section.id }} .fmb-spark.s5{background:var(--coral);animation-delay:.24s;width:4px;height:4px;}
#nd-{{ section.id }} .fmb-spark.s6{background:#6E7746;animation-delay:.27s;}
#nd-{{ section.id }} .fmb-spark.s7{background:#D99A2B;animation-delay:.31s;width:5px;height:5px;}
#nd-{{ section.id }} .fmb-sub{
  margin:0;display:inline-flex;align-items:center;gap:16px;font-family:var(--script);font-style:italic;font-weight:400;
  font-size:clamp(17px,2.6vw,24px);color:var(--fmmut);white-space:nowrap;
  animation:ndfmsub-{{ section.id }} var(--fmdur) linear infinite;
}
#nd-{{ section.id }} .fmb-sub strong{font-weight:600;color:var(--fmmut);animation:ndfmbrand-{{ section.id }} var(--fmdur) linear infinite;}
#nd-{{ section.id }} .fmb-rule{width:44px;height:1.5px;background:var(--fmline);}
@keyframes ndfmglow-{{ section.id }}{0%,6%{opacity:.05;}24%{opacity:.22;}37%,93%{opacity:1;}100%{opacity:.05;}}
@keyframes ndfmbreathe-{{ section.id }}{0%{transform:scale(.985);}22%{transform:scale(.99);}28%{transform:scale(1.015);}38%{transform:scale(1);}100%{transform:scale(1.005);}}
@keyframes ndfmhead-{{ section.id }}{0%{opacity:0;transform:translateY(24px);color:var(--fmoffink);}3%{opacity:0;transform:translateY(24px);}13%{opacity:1;transform:translateY(0);color:var(--fmoffink);}24%{color:var(--fmoffink);}37%,93%{opacity:1;transform:translateY(0);color:var(--ink);}100%{opacity:0;color:var(--ink);}}
@keyframes ndfmtrack-{{ section.id }}{0%,22%{background:var(--fmoff);}28%{background:var(--coral);}37%,100%{background:var(--coral);box-shadow:inset 0 4px 12px rgba(59,42,29,.03),0 14px 60px rgba(200,104,30,.4);}}
@keyframes ndfmknob-{{ section.id }}{0%,22%{transform:translateX(0) scaleX(1);}25%{transform:translateX(90%) scaleX(1.14);}27.5%{transform:translateX(120%) scaleX(1.06);}30%{transform:translateX(115%) scaleX(1);}32%,100%{transform:translateX(117.6%) scaleX(1);}}
@keyframes ndfmring-{{ section.id }}{0%,22%{opacity:0;transform:scale(.5);}23%{opacity:.32;transform:scale(.5);}33%{opacity:0;transform:scale(1.42);}100%{opacity:0;transform:scale(1.42);}}
@keyframes ndfmspark-{{ section.id }}{0%,22%{opacity:0;transform:translate(0,0);}27%{opacity:.85;}34%{opacity:0;transform:translate(calc(var(--dx) * var(--fsw) * .62), calc(var(--dy) * var(--fsw) * .48));}100%{opacity:0;transform:translate(calc(var(--dx) * var(--fsw) * .62), calc(var(--dy) * var(--fsw) * .48));}}
@keyframes ndfmsub-{{ section.id }}{0%,6%{opacity:0;transform:translateY(14px);}17%,93%{opacity:1;transform:translateY(0);}100%{opacity:0;}}
@keyframes ndfmbrand-{{ section.id }}{0%,24%{color:var(--fmmut);}37%,100%{color:var(--coral);}}
@media (prefers-reduced-motion:reduce){
  #nd-{{ section.id }} .fmb-glow,#nd-{{ section.id }} .fmb-stage,#nd-{{ section.id }} .fmb-head,#nd-{{ section.id }} .fmb-switch,#nd-{{ section.id }} .fmb-knob,#nd-{{ section.id }} .fmb-sub,#nd-{{ section.id }} .fmb-sub strong,#nd-{{ section.id }} .fmb-ring,#nd-{{ section.id }} .fmb-spark{animation:none !important;}
  #nd-{{ section.id }} .fmb-glow{opacity:1;}
  #nd-{{ section.id }} .fmb-head{color:var(--ink);}
  #nd-{{ section.id }} .fmb-switch{background:var(--coral);}
  #nd-{{ section.id }} .fmb-knob{transform:translateX(117.6%);}
  #nd-{{ section.id }} .fmb-sub strong{color:var(--coral);}
  #nd-{{ section.id }} .fmb-ring,#nd-{{ section.id }} .fmb-spark{opacity:0;}
}

/* ---------- marquee ---------- */
#nd-{{ section.id }} .nd-mq{overflow:hidden;background:var(--coral);border-top:var(--rule);border-bottom:var(--rule);padding:12px 0;}
#nd-{{ section.id }} .nd-mq .row{display:flex;width:max-content;animation:ndmq 30s linear infinite;}
#nd-{{ section.id }} .nd-mq .half{display:flex;align-items:center;white-space:nowrap;font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--paper);}
#nd-{{ section.id }} .nd-mq .half span{padding:0 18px;}
@keyframes ndmq{to{transform:translateX(-50%);}}
@media (prefers-reduced-motion:reduce){#nd-{{ section.id }} .nd-mq .row{animation:none;}}

/* ---------- flavor duos (sticky stacking) ---------- */
#nd-{{ section.id }} .nd-shop{padding:clamp(44px,6vw,72px) 0 clamp(30px,4vw,48px);}
#nd-{{ section.id }} .duos{display:grid;gap:clamp(24px,4vw,40px);}
#nd-{{ section.id }} .duo{
  position:sticky;top:calc(86px + var(--i)*18px);z-index:calc(2 + var(--i));
  background:var(--paper);border:var(--rule);border-radius:var(--rad);
  box-shadow:0 -12px 28px rgba(26,26,26,.08),5px 5px 0 var(--ink);
  padding:clamp(20px,3.5vw,32px);
}
#nd-{{ section.id }} .duo .dhead{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;text-align:center;margin-bottom:clamp(16px,2.5vw,24px);}
#nd-{{ section.id }} .duo .dhead h2{font-family:var(--display);font-weight:400;text-transform:uppercase;color:var(--ink);font-size:clamp(22px,4.4vw,36px);line-height:.95;letter-spacing:-.005em;}
#nd-{{ section.id }} .duo .newtag{
  font-family:var(--display);font-weight:400;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;
  background:var(--coral);color:var(--paper);border:2px solid var(--ink);border-radius:999px;padding:7px 14px;
  box-shadow:2px 2px 0 var(--ink);transform:rotate(-2deg);
}
#nd-{{ section.id }} .duo .dtag{width:100%;font-family:var(--script);font-style:italic;font-weight:400;color:var(--gray);font-size:15px;}
#nd-{{ section.id }} .duo .cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
#nd-{{ section.id }} .card{
  position:relative;display:flex;flex-direction:column;background:var(--bg);border:var(--rule);
  border-radius:calc(var(--rad) - 4px);overflow:hidden;box-shadow:3px 3px 0 var(--ink);
  transition:transform .12s ease,box-shadow .12s ease;
}
@media(hover:hover){#nd-{{ section.id }} .card:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--ink);}}
#nd-{{ section.id }} .card .ph{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:var(--fbg,var(--paper));border-bottom:var(--rule);padding:20px;text-decoration:none;position:relative;}
#nd-{{ section.id }} .card .ph img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .3s ease;}
@media(hover:hover){#nd-{{ section.id }} .card:hover .ph img{transform:scale(1.05) rotate(-1.5deg);}}
#nd-{{ section.id }} .card .flag{
  position:absolute;top:10px;left:10px;z-index:2;font-family:var(--display);font-weight:400;font-size:10px;
  letter-spacing:.08em;text-transform:uppercase;background:var(--coral);color:var(--paper);border:2px solid var(--ink);
  border-radius:999px;padding:6px 11px;box-shadow:2px 2px 0 var(--ink);
}
#nd-{{ section.id }} .card .b{display:flex;flex-direction:column;gap:7px;padding:16px;text-align:center;flex:1;}
#nd-{{ section.id }} .card .kick{font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--coral);}
#nd-{{ section.id }} .card .t{font-family:var(--display);font-weight:400;font-size:15px;line-height:1.1;text-transform:uppercase;color:var(--ink);text-decoration:none;}
#nd-{{ section.id }} .card .pr{font-family:var(--display);font-weight:400;font-size:16px;color:var(--ink);}
#nd-{{ section.id }} .card .pr s{opacity:.4;font-size:13px;margin-left:6px;}
#nd-{{ section.id }} .card form{margin-top:auto;}
#nd-{{ section.id }} .card .atc{
  width:100%;font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  background:var(--ink);color:var(--paper);border:2px solid var(--ink);border-radius:999px;height:52px;padding:0 16px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;box-shadow:3px 3px 0 var(--ink);
  transition:transform .12s ease,box-shadow .12s ease,background .12s ease;
}
@media(hover:hover){#nd-{{ section.id }} .card .atc:hover{background:var(--coral);transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--ink);}}
#nd-{{ section.id }} .card .atc:active{transform:translate(2px,2px);box-shadow:none;}
#nd-{{ section.id }} .card .atc[disabled]{background:var(--gray);opacity:.7;cursor:not-allowed;transform:none;box-shadow:3px 3px 0 var(--ink);}
#nd-{{ section.id }} .shopall{text-align:center;padding:clamp(26px,4vw,44px) 22px 0;}
@media (max-width:649px){
  #nd-{{ section.id }} .duo{top:calc(78px + var(--i)*14px);}
  #nd-{{ section.id }} .duo .cards{gap:10px;}
  #nd-{{ section.id }} .card .b{padding:12px 8px;}
  #nd-{{ section.id }} .card .t{font-size:12px;}
  #nd-{{ section.id }} .card .atc{font-size:10.5px;height:44px;}
  #nd-{{ section.id }} .card .flag{display:none;}
}

/* ---------- flavor story cards ---------- */
#nd-{{ section.id }} .panels{padding:clamp(48px,7vw,84px) 0;display:grid;gap:clamp(30px,5vw,52px);}
#nd-{{ section.id }} .phead{text-align:center;margin-bottom:clamp(4px,1vw,8px);}
#nd-{{ section.id }} .panel{
  position:relative;border:var(--rule);border-radius:var(--rad);overflow:hidden;
  background:{{ S.panel_bg | default: '#FFD1A9' }};color:var(--ink);box-shadow:5px 5px 0 var(--ink);
}
#nd-{{ section.id }} .panel .bar{height:12px;background:var(--pac,#FF6B5C);border-bottom:var(--rule);}
#nd-{{ section.id }} .panel .inner{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(20px,3.5vw,40px);align-items:center;padding:clamp(24px,4vw,44px) clamp(22px,4vw,48px);}
#nd-{{ section.id }} .panel .num{
  display:inline-block;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.14em;text-transform:uppercase;
  background:var(--pac,#FF6B5C);color:var(--paper);border:2px solid var(--ink);border-radius:999px;padding:6px 14px;box-shadow:2px 2px 0 var(--ink);
}
#nd-{{ section.id }} .panel h2{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(28px,5.4vw,50px);line-height:.95;letter-spacing:-.005em;margin-top:14px;color:var(--ink);}
#nd-{{ section.id }} .panel .tag{font-family:var(--script);font-style:italic;font-weight:400;font-size:clamp(16px,2.4vw,20px);color:var(--coral);margin-top:8px;display:inline-block;transform:rotate(-1.5deg);}
#nd-{{ section.id }} .panel .desc{margin-top:14px;font-family:var(--script);font-weight:400;font-size:15.5px;line-height:1.7;color:var(--gray);max-width:480px;}
#nd-{{ section.id }} .panel .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;}
#nd-{{ section.id }} .panel .chip{
  font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  border:1.5px solid var(--ink);color:var(--ink);border-radius:999px;padding:6px 12px;background:rgba(255,255,255,.4);
}
#nd-{{ section.id }} .panel .pbtn{
  display:inline-flex;align-items:center;justify-content:center;margin-top:22px;
  font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;
  background:var(--ink);color:var(--paper);border:2px solid var(--ink);border-radius:999px;height:52px;padding:0 26px;
  box-shadow:4px 4px 0 var(--ink);transition:transform .12s ease,box-shadow .12s ease,background .12s ease;
}
#nd-{{ section.id }} .panel .pbtn:hover{background:var(--coral);transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink);}
#nd-{{ section.id }} .panel .pbtn:active{transform:translate(3px,3px);box-shadow:none;}
#nd-{{ section.id }} .panel .media{position:relative;}
#nd-{{ section.id }} .panel .photo{
  position:relative;border-radius:calc(var(--rad) - 6px);overflow:hidden;border:0;background:transparent;box-shadow:none;
  aspect-ratio:7/6;display:flex;align-items:center;justify-content:center;
}
#nd-{{ section.id }} .panel .photo img{width:100%;height:100%;object-fit:cover;}
#nd-{{ section.id }} .panel .photo .hint{
  display:flex;align-items:center;justify-content:center;min-height:240px;text-align:center;padding:22px;
  font-family:var(--script);font-size:13.5px;line-height:1.5;color:var(--gray);opacity:.75;
  border:2px dashed var(--ink);border-radius:calc(var(--rad) - 10px);
}
#nd-{{ section.id }} .panel.alt .inner{grid-template-columns:1fr 1.15fr;}
#nd-{{ section.id }} .panel.alt .txt{order:2;}
#nd-{{ section.id }} .panel.alt .media{order:1;}
@media (max-width:799px){
  #nd-{{ section.id }} .panel .inner,#nd-{{ section.id }} .panel.alt .inner{grid-template-columns:1fr;text-align:center;padding-bottom:30px;}
  #nd-{{ section.id }} .panel.alt .txt{order:1;}
  #nd-{{ section.id }} .panel.alt .media{order:2;}
  #nd-{{ section.id }} .panel .desc{margin-left:auto;margin-right:auto;}
  #nd-{{ section.id }} .panel .chips{justify-content:center;}
  #nd-{{ section.id }} .panel .media{margin-top:6px;}
}

/* ---------- flying ingredients ---------- */
#nd-{{ section.id }} .flyers{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;overflow:hidden;}
#nd-{{ section.id }} .fly{position:absolute;will-change:transform;animation:ndfly 7s ease-in-out infinite;filter:drop-shadow(2px 3px 0 rgba(26,26,26,.18));}
#nd-{{ section.id }} .fly svg{display:block;width:100%;height:auto;}
@keyframes ndfly{0%,100%{transform:translateY(0) rotate(var(--r,0deg));}50%{transform:translateY(-16px) rotate(calc(var(--r,0deg) + 6deg));}}
@media (prefers-reduced-motion:reduce){#nd-{{ section.id }} .fly{animation:none;}}
#nd-{{ section.id }} .nd-hero,#nd-{{ section.id }} .nd-banner,#nd-{{ section.id }} .nd-shop,#nd-{{ section.id }} .shopall,#nd-{{ section.id }} .panels,#nd-{{ section.id }} .nd-end,#nd-{{ section.id }} .nd-mq,#nd-{{ section.id }} .nd-strip{position:relative;z-index:2;}
@media (max-width:749px){
  #nd-{{ section.id }} .fly.mhide{display:none;}
}

/* ---------- closing ---------- */
#nd-{{ section.id }} .nd-end{padding:clamp(30px,5vw,52px) 22px clamp(64px,9vw,110px);}
#nd-{{ section.id }} .nd-end .card2{
  max-width:680px;margin:0 auto;background:var(--paper);color:var(--ink);border:var(--rule);
  border-radius:var(--rad);box-shadow:6px 6px 0 var(--ink);padding:clamp(36px,6vw,60px) 28px;text-align:center;
}
#nd-{{ section.id }} .nd-end .endh{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(26px,5.4vw,44px);line-height:.98;color:var(--ink);text-wrap:balance;}
#nd-{{ section.id }} .nd-end p{margin:16px auto 0;max-width:420px;font-family:var(--script);font-weight:400;font-size:15.5px;line-height:1.65;color:var(--gray);}
#nd-{{ section.id }} .nd-end .btn{margin-top:26px;}

/* ---------- font enforcement over theme globals (same approach as pd-fixes) ---------- */
#nd-{{ section.id }} h1,
#nd-{{ section.id }} .h2,
#nd-{{ section.id }} .fmb-head{
  font-family:'Archivo Black','Archivo',-apple-system,sans-serif !important;
  font-weight:400 !important;text-transform:uppercase !important;
}
#nd-{{ section.id }} h1:not(.fmb-head),
#nd-{{ section.id }} .h2,
#nd-{{ section.id }} .duo .dhead h2,
#nd-{{ section.id }} .panel h2,
#nd-{{ section.id }} .endh{
  font-family:'Archivo Black','Archivo',-apple-system,sans-serif !important;
  font-weight:400 !important;text-transform:uppercase !important;letter-spacing:-.005em !important;color:var(--ink) !important;
}
#nd-{{ section.id }} h1.fmb-head{margin:0 !important;font-size:clamp(42px,9.5vw,96px) !important;line-height:.98 !important;letter-spacing:-.01em !important;}
#nd-{{ section.id }} .nd-hero h1 .ln1 span{
  display:inline-flex !important;align-items:center !important;gap:16px !important;
  font-size:clamp(16px,3.4vw,26px) !important;letter-spacing:.3em !important;line-height:1.2 !important;
  color:var(--coral) !important;padding-left:.3em;
}
#nd-{{ section.id }} .nd-hero h1 .ln1 span::before,#nd-{{ section.id }} .nd-hero h1 .ln1 span::after{content:'';width:clamp(24px,4vw,44px);height:2px;background:var(--ink);flex:none;}
#nd-{{ section.id }} .nd-hero h1 .ln2 span{
  font-size:clamp(44px,10.5vw,100px) !important;letter-spacing:-.01em !important;line-height:.95 !important;
  padding-top:6px;
}
#nd-{{ section.id }} .h2{font-size:clamp(28px,4.2vw,50px) !important;line-height:.95 !important;}
#nd-{{ section.id }} .duo .dhead h2{font-size:clamp(22px,4.4vw,36px) !important;line-height:.95 !important;}
#nd-{{ section.id }} .panel h2{font-size:clamp(28px,5.4vw,50px) !important;line-height:.95 !important;}
#nd-{{ section.id }} .endh{font-size:clamp(26px,5.4vw,44px) !important;line-height:.98 !important;}
#nd-{{ section.id }} .h2 em,#nd-{{ section.id }} h1 em,#nd-{{ section.id }} .endh em{
  font-family:'Josefin Sans',sans-serif !important;font-weight:300 !important;font-style:italic !important;
  text-transform:none !important;letter-spacing:0 !important;color:var(--coral) !important;
}
#nd-{{ section.id }} .eyebrow,
#nd-{{ section.id }} .btn,
#nd-{{ section.id }} .card .atc,
#nd-{{ section.id }} .card .t,
#nd-{{ section.id }} .card .kick,
#nd-{{ section.id }} .card .pr,
#nd-{{ section.id }} .card .flag,
#nd-{{ section.id }} .duo .newtag,
#nd-{{ section.id }} .panel .num,
#nd-{{ section.id }} .panel .chip,
#nd-{{ section.id }} .panel .pbtn,
#nd-{{ section.id }} .nd-strip,
#nd-{{ section.id }} .nd-mq .half{
  font-family:'Archivo Black','Archivo',-apple-system,sans-serif !important;font-weight:400 !important;text-transform:uppercase !important;
}
#nd-{{ section.id }} .nd-hero .script,
#nd-{{ section.id }} .nd-hero .sub,
#nd-{{ section.id }} .duo .dtag,
#nd-{{ section.id }} .panel .tag,
#nd-{{ section.id }} .panel .desc,
#nd-{{ section.id }} .nd-end p{
  font-family:'Josefin Sans',-apple-system,sans-serif !important;
}
#nd-{{ section.id }} .nd-hero .script,#nd-{{ section.id }} .panel .tag{font-style:italic !important;color:var(--coral) !important;}
</style>

{%- capture svg_apple -%}
<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 14c-9 0-18 6-18 18 0 11 8 20 18 20s18-9 18-20c0-12-9-18-18-18z" fill="#C0392B" stroke="#1a1a1a" stroke-width="2.5"/><rect x="30" y="5" width="4" height="10" rx="2" fill="#1a1a1a"/><ellipse cx="40" cy="9" rx="6" ry="3.5" fill="#5F7042" stroke="#1a1a1a" stroke-width="2" transform="rotate(-18 40 9)"/><path d="M15 27c1-8 8-13 17-13s16 5 17 13c0 3-3 5-6 3-2-1-2 4-5 4s-3-5-6-5-3 4-6 4-3-3-6-3-5-1-5-3z" fill="#E8A34C" stroke="#1a1a1a" stroke-width="2.5"/></svg>
{%- endcapture -%}
{%- capture svg_date -%}
<svg viewBox="0 0 48 64" aria-hidden="true"><ellipse cx="24" cy="32" rx="15" ry="24" fill="#6B4423" stroke="#1a1a1a" stroke-width="2.5"/><path d="M18 16c-3 5-4 12-3 20" stroke="#8A5A30" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M28 14c3 6 4 16 2 26" stroke="#8A5A30" stroke-width="2.5" fill="none" stroke-linecap="round"/><ellipse cx="29" cy="22" rx="3" ry="6" fill="rgba(255,255,255,.25)" transform="rotate(15 29 22)"/></svg>
{%- endcapture -%}
{%- capture svg_pist -%}
<svg viewBox="0 0 64 56" aria-hidden="true"><ellipse cx="26" cy="30" rx="16" ry="22" fill="#D9B98A" stroke="#1a1a1a" stroke-width="2.5" transform="rotate(-24 26 30)"/><ellipse cx="38" cy="28" rx="14" ry="20" fill="#EBD3A8" stroke="#1a1a1a" stroke-width="2.5" transform="rotate(22 38 28)"/><ellipse cx="32" cy="30" rx="8" ry="14" fill="#7A8C4F" stroke="#1a1a1a" stroke-width="2.5"/></svg>
{%- endcapture -%}
{%- capture svg_drop -%}
<svg viewBox="0 0 32 44" aria-hidden="true"><path d="M16 2c6 10 12 17 12 26a12 12 0 0 1-24 0C4 19 10 12 16 2z" fill="#E8A34C" stroke="#1a1a1a" stroke-width="2.5"/><ellipse cx="12" cy="28" rx="3" ry="5" fill="rgba(255,255,255,.35)"/></svg>
{%- endcapture -%}

<div id="nd-{{ section.id }}">

  {%- if S.show_flyers -%}
  <div class="flyers" aria-hidden="true">
    <span class="fly" style="left:2.5%;top:5%;width:64px;--r:-8deg;animation-delay:0s">{{ svg_apple }}</span>
    <span class="fly" style="right:5%;top:8%;width:32px;--r:6deg;animation-delay:.9s">{{ svg_drop }}</span>
    <span class="fly mhide" style="right:2.5%;top:16%;width:56px;--r:14deg;animation-delay:1.6s">{{ svg_pist }}</span>
    <span class="fly" style="left:4%;top:24%;width:42px;--r:-12deg;animation-delay:.4s">{{ svg_date }}</span>
    <span class="fly mhide" style="right:3%;top:33%;width:54px;--r:10deg;animation-delay:2.2s">{{ svg_apple }}</span>
    <span class="fly" style="left:2%;top:41%;width:28px;--r:6deg;animation-delay:1.1s">{{ svg_drop }}</span>
    <span class="fly mhide" style="right:4.5%;top:50%;width:48px;--r:18deg;animation-delay:.7s">{{ svg_date }}</span>
    <span class="fly" style="left:3%;top:58%;width:58px;--r:-16deg;animation-delay:1.9s">{{ svg_pist }}</span>
    <span class="fly mhide" style="right:2.5%;top:66%;width:34px;--r:-6deg;animation-delay:.2s">{{ svg_drop }}</span>
    <span class="fly" style="left:3.5%;top:74%;width:50px;--r:12deg;animation-delay:1.4s">{{ svg_apple }}</span>
    <span class="fly mhide" style="left:2%;top:88%;width:38px;--r:-10deg;animation-delay:2.6s">{{ svg_date }}</span>
    <span class="fly" style="right:3%;top:84%;width:52px;--r:8deg;animation-delay:.5s">{{ svg_pist }}</span>
  </div>
  {%- endif -%}

  {%- if S.topbar_text != blank -%}
  <div class="nd-strip">{{ S.topbar_text }}</div>
  {%- endif -%}

  {%- if S.banner != blank or request.design_mode -%}
  <div class="nd-banner">
    {%- if S.banner != blank -%}
      {%- if S.banner_link != blank -%}<a class="bwrap" href="{{ S.banner_link }}">{%- else -%}<div class="bwrap">{%- endif -%}
        <img class="bd{% if S.banner_m != blank %} hasm{% endif %}" src="{{ S.banner | image_url: width: 2400 }}" alt="{{ S.banner_alt | escape }}">
        {%- if S.banner_m != blank -%}<img class="bm" src="{{ S.banner_m | image_url: width: 1000 }}" alt="{{ S.banner_alt | escape }}">{%- endif -%}
      {%- if S.banner_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- else -%}
      <div class="bwrap"><div class="hint">Upload a banner here (desktop and mobile versions in section settings). Add a link to make the whole banner clickable.</div></div>
    {%- endif -%}
  </div>
  {%- endif -%}

  <header class="nd-hero" data-nd-hero>
    {%- if S.show_leaves -%}<canvas class="nd-leaves" data-nd-leaves></canvas>{%- endif -%}
    <div class="wrap" style="position:relative;z-index:2">
      <span class="eyebrow">{{ S.hero_eyebrow }}</span>
      {%- if S.fmb_show -%}
      <div class="fmb" role="img" aria-label="{{ S.fmb_head | default: 'Fall Mood On!' | escape }}">
        <div class="fmb-glow" aria-hidden="true"></div>
        <div class="fmb-stage">
          <h1 class="fmb-head">{{ S.fmb_head | default: 'Fall Mood On!' }}</h1>
          <div class="fmb-switchwrap" aria-hidden="true">
            <div class="fmb-ring"></div>
            <div class="fmb-ring fmb-ring2"></div>
            {%- assign fdxs = "-1.05,0.15,1.1,-0.6,0.85,-1.35,1.35,0.45" | split: "," -%}
            {%- assign fdys = "-0.9,-1.35,-0.75,-1.45,-1.4,-0.35,-0.25,-1.5" | split: "," -%}
            {%- for i in (0..7) -%}
            <span class="fmb-spark s{{ i }}" style="--dx:{{ fdxs[i] }};--dy:{{ fdys[i] }};"></span>
            {%- endfor -%}
            <div class="fmb-switch"><div class="fmb-knob"></div></div>
          </div>
          <p class="fmb-sub">
            <span class="fmb-rule" aria-hidden="true"></span>
            <span>{{ S.fmb_sub | default: 'Powered by' }} <strong>{{ S.fmb_brand | default: 'Pump(kin)!' }}</strong></span>
            <span class="fmb-rule" aria-hidden="true"></span>
          </p>
        </div>
      </div>
      {%- endif -%}
      {%- if S.hero_script != blank -%}<span class="script">{{ S.hero_script }}</span>{%- endif -%}
      {%- if S.hero_sub != blank -%}<p class="sub">{{ S.hero_sub }}</p>{%- endif -%}
    </div>
  </header>

  {%- if S.show_tick and S.tick_text != blank -%}
  <div class="nd-mq" aria-hidden="true">
    <div class="row">
      <div class="half">{%- for i in (1..4) -%}<span>{{ S.tick_text }}</span>{%- endfor -%}</div>
      <div class="half">{%- for i in (1..4) -%}<span>{{ S.tick_text }}</span>{%- endfor -%}</div>
    </div>
  </div>
  {%- endif -%}

  <section class="nd-shop wrap" id="nd-shop">
    <div class="duos">
      {%- assign di = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'flavor' -%}
          {%- assign prod = block.settings.product -%}
          {%- assign prod_sf = block.settings.product_sf -%}
          <div class="duo nd-rev" style="--i:{{ di }};--fbg:{{ block.settings.bg | default: '#C8681E' }}" {{ block.shopify_attributes }}>
            <div class="dhead">
              <h2>{{ block.settings.name }}</h2>
              <span class="newtag">{{ S.new_tag | default: 'New Release' }}</span>
              {%- if block.settings.tag != blank -%}<span class="dtag">{{ block.settings.tag }}</span>{%- endif -%}
            </div>
            <div class="cards">
              {%- if prod != blank -%}
              <div class="card">
                <a class="ph" href="{{ prod.url }}">
                  <span class="flag">{{ S.new_tag | default: 'New Release' }}</span>
                  {%- if prod.featured_image -%}<img src="{{ prod.featured_image | image_url: width: 640 }}" alt="{{ prod.title | escape }}" loading="lazy">{%- endif -%}
                </a>
                <div class="b">
                  <span class="kick">{{ S.reg_label | default: 'Regular' }}</span>
                  <a class="t" href="{{ prod.url }}">{{ prod.title | replace: '(USA)', '' | replace: ' Syrup', '' | strip }}</a>
                  <span class="pr">{{ prod.price | money }}{% if prod.compare_at_price > prod.price %}<s>{{ prod.compare_at_price | money }}</s>{% endif %}</span>
                  {%- if prod.available -%}
                  {%- form 'product', prod -%}
                    <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
                    <button type="submit" class="atc">{{ S.atc_label | default: 'Add to cart' }}</button>
                  {%- endform -%}
                  {%- else -%}
                  <form><button type="button" class="atc" disabled>{{ S.coming_label | default: 'Coming soon' }}</button></form>
                  {%- endif -%}
                </div>
              </div>
              {%- endif -%}
              {%- if prod_sf != blank -%}
              <div class="card">
                <a class="ph" href="{{ prod_sf.url }}">
                  <span class="flag">{{ S.new_tag | default: 'New Release' }}</span>
                  {%- if prod_sf.featured_image -%}<img src="{{ prod_sf.featured_image | image_url: width: 640 }}" alt="{{ prod_sf.title | escape }}" loading="lazy">{%- endif -%}
                </a>
                <div class="b">
                  <span class="kick">{{ S.sf_label | default: 'Sugar-Free · 0g' }}</span>
                  <a class="t" href="{{ prod_sf.url }}">{{ prod_sf.title | replace: '(USA)', '' | replace: ' Syrup', '' | strip }}</a>
                  <span class="pr">{{ prod_sf.price | money }}{% if prod_sf.compare_at_price > prod_sf.price %}<s>{{ prod_sf.compare_at_price | money }}</s>{% endif %}</span>
                  {%- if prod_sf.available -%}
                  {%- form 'product', prod_sf -%}
                    <input type="hidden" name="id" value="{{ prod_sf.selected_or_first_available_variant.id }}">
                    <button type="submit" class="atc">{{ S.atc_label | default: 'Add to cart' }}</button>
                  {%- endform -%}
                  {%- else -%}
                  <form><button type="button" class="atc" disabled>{{ S.coming_label | default: 'Coming soon' }}</button></form>
                  {%- endif -%}
                </div>
              </div>
              {%- endif -%}
            </div>
          </div>
          {%- assign di = di | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if S.shopall_label != blank -%}
    <div class="shopall"><a class="btn btn--ghost" href="{{ S.shopall_url | default: '/collections/all' }}">{{ S.shopall_label }}</a></div>
    {%- endif -%}
  </section>

  <div class="panels wrap" id="nd-flavors">
    <div class="phead nd-rev">
      <span class="eyebrow">{{ S.story_kick | default: 'Get to know them' }}</span>
      <h2 class="h2">{{ S.story_title | default: 'The flavors, <em>up close</em>' }}</h2>
    </div>
    {%- assign pi = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'flavor' -%}
        {%- assign pi = pi | plus: 1 -%}
        {%- assign prod = block.settings.product -%}
        <article class="panel nd-rev{% cycle '', ' alt', '' %}" style="--pac:{{ block.settings.bg | default: '#FF6B5C' }}" {{ block.shopify_attributes }}>
          <div class="bar"></div>
          <div class="inner">
            <div class="txt">
              <span class="num">New · 0{{ pi }}</span>
              <h2>{{ block.settings.name }}</h2>
              {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
              {%- if block.settings.desc != blank -%}<p class="desc">{{ block.settings.desc }}</p>{%- endif -%}
              {%- if block.settings.notes != blank -%}
              <div class="chips">
                {%- assign notes = block.settings.notes | split: ',' -%}
                {%- for n in notes -%}<span class="chip">{{ n | strip }}</span>{%- endfor -%}
              </div>
              {%- endif -%}
              {%- if prod != blank -%}
              <a class="pbtn" href="{{ prod.url }}">{{ S.panel_btn | default: 'Shop' }} {{ block.settings.name }}</a>
              {%- endif -%}
            </div>
            <div class="media">
              <div class="photo">
                {%- if block.settings.img != blank -%}
                  <img src="{{ block.settings.img | image_url: width: 1100 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                {%- elsif request.design_mode -%}
                  <div class="hint">{{ block.settings.hint }}</div>
                {%- else -%}
                  <div class="hint" style="border:0">{{ block.settings.tag }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <section class="nd-end">
    <div class="card2 nd-rev">
      <h2 class="endh">{{ S.end_title }}</h2>
      {%- if S.end_sub != blank -%}<p>{{ S.end_sub }}</p>{%- endif -%}
      {%- if S.end_cta != blank -%}<a class="btn" href="{{ S.end_url | default: '/collections/all' }}">{{ S.end_cta }}</a>{%- endif -%}
    </div>
  </section>

</div>

<script>
(function(){
  var root=document.getElementById('nd-{{ section.id }}');
  if(!root)return;
  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hero=root.querySelector('[data-nd-hero]');
  if(hero){requestAnimationFrame(function(){requestAnimationFrame(function(){hero.classList.add('go');});});}
  var revs=root.querySelectorAll('.nd-rev');
  if('IntersectionObserver' in window && !reduced){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
    },{threshold:.1,rootMargin:'0px 0px -5% 0px'});
    Array.prototype.forEach.call(revs,function(el){io.observe(el);});
  }else{
    Array.prototype.forEach.call(revs,function(el){el.classList.add('in');});
  }

  /* fall leaves dropping in hero */
  var lc=root.querySelector('[data-nd-leaves]');
  if(lc && !reduced){
    var ctx=lc.getContext('2d'),W,H,leaves=[],running=true;
    var tones=['rgba(226,143,38,.45)','rgba(192,57,43,.32)','rgba(140,70,30,.35)','rgba(200,104,30,.4)'];
    var size=function(){
      var r=lc.parentElement.getBoundingClientRect();
      W=lc.width=r.width;H=lc.height=r.height;
    };
    size();window.addEventListener('resize',size);
    for(var i=0;i<16;i++){
      leaves.push({
        x:Math.random()*2000,y:Math.random()*1200,
        rx:4+Math.random()*5,ry:2+Math.random()*2.5,
        v:.3+Math.random()*.5,w:Math.random()*Math.PI*2,
        rot:Math.random()*Math.PI*2,rv:(Math.random()-.5)*.02,
        c:tones[i%4]
      });
    }
    var draw=function(){
      if(!running)return;
      ctx.clearRect(0,0,W,H);
      leaves.forEach(function(f){
        f.y+=f.v;f.w+=.01;f.x+=Math.sin(f.w)*.5;f.rot+=f.rv;
        if(f.y>H+8){f.y=-8;f.x=Math.random()*W;}
        ctx.save();
        ctx.translate(f.x%W,f.y);ctx.rotate(f.rot);
        ctx.fillStyle=f.c;
        ctx.beginPath();ctx.ellipse(0,0,f.rx,f.ry,0,0,6.283);ctx.fill();
        ctx.restore();
      });
      requestAnimationFrame(draw);
    };
    document.addEventListener('visibilitychange',function(){
      running=!document.hidden;if(running)requestAnimationFrame(draw);
    });
    draw();
  }
})();
</script>

