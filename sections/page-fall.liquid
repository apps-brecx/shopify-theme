{%- comment -%}
  Syruvia Fall Mood page, "Powered by Pump(kin)!".
  House style: Archivo Black + Josefin Sans, cream bg, brown rules, orange, chunky
  bordered cards with hard offset shadows (same design language as the Pouches page).
  Prefix: fm-. Notice strip, hero with drifting leaves, marquee, statement, stat tiles,
  lineup, cozy boxes (sticky on mobile), picture band, cozy menu rows, giant type, closing.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Josefin+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&display=swap">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Josefin+Sans:wght@300;400;600;700&display=swap"></noscript>

{%- liquid
  assign S = section.settings
  assign coll = collections[S.collection_handle]
  assign end_url = S.end_url
  if end_url == blank and coll != blank
    assign end_url = coll.url
  endif
  if end_url == blank
    assign end_url = '/collections/all'
  endif
-%}

<style>
#fm-{{ section.id }}{
  --bg:{{ S.c_butter | default: '#FFFBF4' }};
  --brand:{{ S.c_espresso | default: '#3c2415' }};
  --orange:{{ S.c_pump | default: '#e28f26' }};
  --gold:{{ S.c_gold | default: '#FCE2A0' }};
  --paper:#ffffff;
  --ink:#1a1a1a;
  --rad:16px;
  --rule:1.5px solid var(--brand);
  --display:'Archivo Black','Josefin Sans',system-ui,sans-serif;
  --serif:'Josefin Sans',system-ui,sans-serif;
  background:var(--bg);color:var(--ink);font-family:var(--serif);
  font-size:16px;line-height:1.6;overflow-x:clip;position:relative;
}
#fm-{{ section.id }} *{box-sizing:border-box;margin:0;}
#fm-{{ section.id }} img{max-width:100%;display:block;}
#fm-{{ section.id }} a{color:inherit;}
#fm-{{ section.id }} .wrap{max-width:1120px;margin:0 auto;padding:0 22px;}

/* ---------- house type ---------- */
#fm-{{ section.id }} .eyebrow{
  font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.18em;text-transform:uppercase;
  display:inline-block;padding:6px 14px;border:var(--rule);border-radius:999px;background:var(--paper);color:var(--brand);
}
#fm-{{ section.id }} .h2{
  font-family:var(--display);font-weight:400;font-size:clamp(26px,5vw,44px);line-height:1;
  letter-spacing:-.005em;text-transform:uppercase;margin:14px 0 0;color:var(--brand);text-wrap:balance;
}
#fm-{{ section.id }} .h2 em{font-style:normal;color:var(--orange);}
#fm-{{ section.id }} .sub-p{margin-top:14px;font-size:15.5px;line-height:1.7;color:rgba(26,26,26,.78);}
#fm-{{ section.id }} .btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  font-family:var(--display);font-weight:400;font-size:13.5px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;
  padding:16px 30px;border:var(--rule);border-radius:999px;cursor:pointer;
  transition:transform .14s ease,box-shadow .14s ease,background .14s ease;
  background:var(--brand);color:var(--bg);box-shadow:3px 3px 0 rgba(60,36,21,.25);
}
#fm-{{ section.id }} .btn--ghost{background:var(--paper);color:var(--brand);box-shadow:none;}
@media(hover:hover){
  #fm-{{ section.id }} .btn:hover{transform:translateY(-2px);box-shadow:4px 5px 0 rgba(60,36,21,.28);}
  #fm-{{ section.id }} .btn--ghost:hover{background:#FFF3DC;}
}
#fm-{{ section.id }} .btnrow{display:flex;gap:12px;flex-wrap:wrap;}
@media(max-width:560px){#fm-{{ section.id }} .btnrow .btn{width:100%;}}

/* ---------- reveal ---------- */
#fm-{{ section.id }} .fm-rev{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease;}
#fm-{{ section.id }} .fm-rev.in{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){#fm-{{ section.id }} .fm-rev{opacity:1;transform:none;transition:none;}}

/* ---------- notice strip ---------- */
#fm-{{ section.id }} .fm-strip{
  background:var(--brand);color:var(--bg);text-align:center;border-bottom:var(--rule);
  padding:10px 16px;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.16em;text-transform:uppercase;
}

/* ---------- hero ---------- */
#fm-{{ section.id }} .fm-hero{position:relative;overflow:hidden;padding:clamp(54px,8vw,96px) 0 0;text-align:center;}
#fm-{{ section.id }} .fm-hero h1{
  font-family:var(--display);font-weight:400;text-transform:uppercase;color:var(--brand);
  font-size:clamp(46px,12vw,104px);line-height:.95;letter-spacing:-.01em;margin-top:20px;
}
#fm-{{ section.id }} .fm-hero h1 .ln{display:block;overflow:hidden;}
#fm-{{ section.id }} .fm-hero h1 .ln span{display:block;transform:translateY(112%);transition:transform .9s cubic-bezier(.16,1,.3,1);}
#fm-{{ section.id }} .fm-hero.go h1 .ln span{transform:none;}
#fm-{{ section.id }} .fm-hero .script{
  font-family:var(--serif);font-style:italic;font-weight:600;color:var(--orange);
  font-size:clamp(20px,4.6vw,34px);margin-top:12px;display:inline-block;
  transform:rotate(-2deg) translateY(12px);opacity:0;transition:opacity .7s ease .3s,transform .7s ease .3s;
}
#fm-{{ section.id }} .fm-hero.go .script{opacity:1;transform:rotate(-2deg);}
#fm-{{ section.id }} .fm-hero .sub{
  max-width:520px;margin:18px auto 0;font-size:15.5px;line-height:1.7;color:rgba(26,26,26,.75);
  opacity:0;transform:translateY(12px);transition:opacity .7s ease .45s,transform .7s ease .45s;
}
#fm-{{ section.id }} .fm-hero .btnrow{justify-content:center;margin-top:26px;opacity:0;transform:translateY(12px);transition:opacity .7s ease .6s,transform .7s ease .6s;}
#fm-{{ section.id }} .fm-hero.go .sub,#fm-{{ section.id }} .fm-hero.go .btnrow{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){
  #fm-{{ section.id }} .fm-hero h1 .ln span,#fm-{{ section.id }} .fm-hero .script,#fm-{{ section.id }} .fm-hero .sub,#fm-{{ section.id }} .fm-hero .btnrow{transform:none;opacity:1;transition:none;}
  #fm-{{ section.id }} .fm-hero .script{transform:rotate(-2deg);}
}
#fm-{{ section.id }} .fm-hero .frame{
  margin:clamp(34px,5vw,54px) auto 0;position:relative;overflow:hidden;max-width:1120px;
  border:var(--rule);border-radius:calc(var(--rad) + 8px) calc(var(--rad) + 8px) 0 0;border-bottom:0;
  box-shadow:4px 4px 0 rgba(60,36,21,.14);aspect-ratio:21/9;background:var(--paper);
}
#fm-{{ section.id }} .fm-hero .frame img{width:100%;height:118%;object-fit:cover;will-change:transform;}
#fm-{{ section.id }} .fm-hero .frame .hint{
  position:absolute;top:14px;left:14px;right:14px;bottom:14px;display:flex;align-items:center;justify-content:center;text-align:center;
  padding:24px;color:rgba(60,36,21,.55);font-size:13.5px;line-height:1.5;
  border:1.5px dashed var(--brand);border-radius:var(--rad);opacity:.75;
}
@media (max-width:749px){
  #fm-{{ section.id }} .fm-hero .frame{aspect-ratio:4/5;margin-left:16px;margin-right:16px;}
}

/* ---------- marquee ---------- */
#fm-{{ section.id }} .fm-mq{overflow:hidden;background:var(--orange);border-top:var(--rule);border-bottom:var(--rule);padding:11px 0;}
#fm-{{ section.id }} .fm-mq .row{display:flex;width:max-content;animation:fmmq 32s linear infinite;}
#fm-{{ section.id }} .fm-mq .half{display:flex;align-items:center;white-space:nowrap;font-family:var(--display);font-weight:400;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#fff;}
#fm-{{ section.id }} .fm-mq .half span{padding:0 18px;}
@keyframes fmmq{to{transform:translateX(-50%);}}
@media (prefers-reduced-motion:reduce){#fm-{{ section.id }} .fm-mq .row{animation:none;}}

/* ---------- statement + stat tiles ---------- */
#fm-{{ section.id }} .fm-intro{padding:clamp(60px,9vw,110px) 0;text-align:center;}
#fm-{{ section.id }} .fm-intro .big{
  font-family:var(--display);font-weight:400;text-transform:uppercase;color:var(--brand);
  font-size:clamp(30px,6.4vw,58px);line-height:1;letter-spacing:-.005em;margin-top:16px;text-wrap:balance;
}
#fm-{{ section.id }} .fm-intro .big em{font-style:normal;color:var(--orange);}
#fm-{{ section.id }} .fm-intro p{max-width:600px;margin:18px auto 0;font-size:15.5px;line-height:1.75;color:rgba(26,26,26,.78);}
#fm-{{ section.id }} .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:820px;margin:clamp(28px,4vw,44px) auto 0;}
#fm-{{ section.id }} .stat{border:var(--rule);border-radius:calc(var(--rad) + 4px);box-shadow:4px 4px 0 rgba(60,36,21,.18);padding:22px 12px 18px;text-align:center;background:var(--paper);}
#fm-{{ section.id }} .stat .l{font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);display:block;}
#fm-{{ section.id }} .stat .v{font-family:var(--display);font-weight:400;font-size:clamp(15px,2.2vw,19px);text-transform:uppercase;color:var(--brand);display:block;margin-top:8px;line-height:1.2;}
@media (max-width:649px){#fm-{{ section.id }} .stats{grid-template-columns:1fr;max-width:340px;}}

/* ---------- lineup ---------- */
#fm-{{ section.id }} .fm-shop{padding:0 0 clamp(64px,9vw,110px);}
#fm-{{ section.id }} .headrow{text-align:center;margin-bottom:clamp(28px,4vw,44px);}
#fm-{{ section.id }} .fm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:18px;}
#fm-{{ section.id }} .fm-card{
  position:relative;display:flex;flex-direction:column;background:var(--paper);border:var(--rule);
  border-radius:calc(var(--rad) + 6px);overflow:hidden;box-shadow:3px 3px 0 rgba(60,36,21,.12);
  transition:transform .18s ease,box-shadow .18s ease;
}
@media(hover:hover){#fm-{{ section.id }} .fm-card:hover{transform:translateY(-4px);box-shadow:5px 7px 0 rgba(60,36,21,.16);}}
#fm-{{ section.id }} .fm-card .ph{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:var(--bg);border-bottom:var(--rule);padding:22px;text-decoration:none;position:relative;}
#fm-{{ section.id }} .fm-card .ph img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .3s ease;}
@media(hover:hover){#fm-{{ section.id }} .fm-card:hover .ph img{transform:scale(1.05) rotate(-1.5deg);}}
#fm-{{ section.id }} .fm-card .flag{
  position:absolute;top:10px;left:10px;z-index:2;font-family:var(--display);font-weight:400;font-size:10px;
  letter-spacing:.12em;text-transform:uppercase;background:var(--orange);color:#fff;border:var(--rule);
  border-radius:999px;padding:6px 12px;box-shadow:2px 2px 0 rgba(60,36,21,.2);
}
#fm-{{ section.id }} .fm-card.soon .ph img{filter:grayscale(.3);opacity:.7;}
#fm-{{ section.id }} .fm-card .veil{
  position:absolute;left:10px;right:10px;bottom:10px;background:rgba(255,255,255,.94);color:var(--brand);border:var(--rule);
  text-align:center;font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  padding:8px;border-radius:999px;
}
#fm-{{ section.id }} .fm-card .b{display:flex;flex-direction:column;gap:8px;padding:18px 18px 20px;text-align:center;flex:1;}
#fm-{{ section.id }} .fm-card .kick{font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);}
#fm-{{ section.id }} .fm-card .t{font-family:var(--display);font-weight:400;font-size:16px;line-height:1.15;text-transform:uppercase;color:var(--brand);text-decoration:none;}
#fm-{{ section.id }} .fm-card .pr{font-family:var(--display);font-weight:400;font-size:17px;color:var(--brand);}
#fm-{{ section.id }} .fm-card .pr s{opacity:.45;font-size:14px;margin-left:7px;}
#fm-{{ section.id }} .fm-card form{margin-top:auto;}
#fm-{{ section.id }} .fm-card .atc{
  width:100%;font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;
  background:var(--brand);color:var(--bg);border:var(--rule);border-radius:999px;padding:14px 18px;cursor:pointer;
  transition:transform .14s ease,box-shadow .14s ease;box-shadow:2px 2px 0 rgba(60,36,21,.22);
}
@media(hover:hover){#fm-{{ section.id }} .fm-card .atc:hover{transform:translateY(-2px);box-shadow:3px 4px 0 rgba(60,36,21,.26);}}
#fm-{{ section.id }} .fm-card .atc[disabled]{background:var(--bg);color:var(--brand);opacity:.65;cursor:default;box-shadow:none;}
#fm-{{ section.id }} .seeall-row{text-align:center;margin-top:clamp(26px,4vw,40px);}
@media (max-width:749px){
  #fm-{{ section.id }} .fm-grid{grid-template-columns:1fr;gap:14px;}
  #fm-{{ section.id }} .fm-card{flex-direction:row;align-items:stretch;}
  #fm-{{ section.id }} .fm-card .ph{width:132px;min-width:132px;aspect-ratio:1/1;border-bottom:none;border-right:var(--rule);padding:12px;}
  #fm-{{ section.id }} .fm-card .b{padding:14px;justify-content:center;}
  #fm-{{ section.id }} .fm-card .t{font-size:14.5px;}
  #fm-{{ section.id }} .fm-card .veil{left:6px;right:auto;bottom:6px;padding:6px 10px;}
}

/* ---------- cozy boxes ---------- */
#fm-{{ section.id }} .fm-cozy{padding:0 0 clamp(64px,9vw,110px);}
#fm-{{ section.id }} .boxes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:clamp(28px,4vw,44px);}
#fm-{{ section.id }} .box{
  background:var(--bxbg,var(--paper));color:var(--bxtx,var(--ink));border:var(--rule);
  border-radius:calc(var(--rad) + 4px);box-shadow:4px 4px 0 rgba(60,36,21,.18);padding:28px 20px;text-align:center;
}
#fm-{{ section.id }} .box .n{
  display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;
  background:var(--paper);color:var(--brand);border:var(--rule);font-family:var(--display);font-size:15px;
  margin-bottom:14px;box-shadow:2px 2px 0 rgba(60,36,21,.2);
}
#fm-{{ section.id }} .box h3{font-family:var(--display);font-weight:400;font-size:clamp(17px,2.2vw,21px);text-transform:uppercase;line-height:1.15;}
#fm-{{ section.id }} .box p{margin-top:10px;font-size:14.5px;line-height:1.6;opacity:.85;}
@media (max-width:849px){
  #fm-{{ section.id }} .boxes{grid-template-columns:1fr;gap:16px;}
  #fm-{{ section.id }} .box{position:sticky;top:calc(96px + (var(--i,0) * 16px));box-shadow:0 -8px 22px rgba(60,36,21,.14);}
}

/* ---------- picture band ---------- */
#fm-{{ section.id }} .fm-band{padding:0 0 clamp(64px,9vw,110px);}
#fm-{{ section.id }} .fm-band .media{
  position:relative;overflow:hidden;border:var(--rule);border-radius:calc(var(--rad) + 8px);
  box-shadow:4px 4px 0 rgba(60,36,21,.14);aspect-ratio:21/9;background:var(--paper);
}
#fm-{{ section.id }} .fm-band .media img{width:100%;height:118%;object-fit:cover;will-change:transform;}
#fm-{{ section.id }} .fm-band .cap{
  position:absolute;left:0;right:0;bottom:18px;text-align:center;color:#fff;font-style:italic;font-weight:600;
  font-size:clamp(15px,2.2vw,20px);text-shadow:0 1px 12px rgba(0,0,0,.45);padding:0 20px;
}
#fm-{{ section.id }} .fm-band .hint{
  position:absolute;top:14px;left:14px;right:14px;bottom:14px;display:flex;align-items:center;justify-content:center;text-align:center;
  color:rgba(60,36,21,.55);font-size:13.5px;border:1.5px dashed var(--brand);border-radius:var(--rad);padding:20px;opacity:.75;
}
@media (max-width:749px){#fm-{{ section.id }} .fm-band .media{aspect-ratio:4/5;}}

/* ---------- cozy menu rows ---------- */
#fm-{{ section.id }} .fm-menu{padding:0 0 clamp(64px,9vw,110px);}
#fm-{{ section.id }} .mrow{
  position:relative;display:grid;grid-template-columns:1fr 150px;gap:20px;align-items:center;
  background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 8px);
  box-shadow:4px 4px 0 rgba(60,36,21,.14);padding:clamp(24px,4vw,36px);margin-top:clamp(30px,4.5vw,44px);
}
#fm-{{ section.id }} .mrow .schip{
  position:absolute;top:-15px;left:24px;z-index:2;font-family:var(--display);font-weight:400;font-size:11px;
  letter-spacing:.12em;text-transform:uppercase;background:var(--orange);color:#fff;border:var(--rule);
  border-radius:999px;padding:7px 15px;box-shadow:2px 2px 0 rgba(60,36,21,.2);
}
#fm-{{ section.id }} .mrow h3{font-family:var(--display);font-weight:400;font-size:clamp(19px,3vw,26px);text-transform:uppercase;color:var(--brand);line-height:1.1;}
#fm-{{ section.id }} .mrow h3 .no{color:var(--orange);margin-right:10px;}
#fm-{{ section.id }} .mrow p{margin-top:10px;font-size:14.5px;line-height:1.65;color:rgba(26,26,26,.78);max-width:560px;}
#fm-{{ section.id }} .mrow .im{aspect-ratio:1/1;border:var(--rule);border-radius:var(--rad);overflow:hidden;background:var(--bg);box-shadow:3px 3px 0 rgba(60,36,21,.12);}
#fm-{{ section.id }} .mrow .im img{width:100%;height:100%;object-fit:cover;}
#fm-{{ section.id }} .mrow .im .hint{
  display:flex;align-items:center;justify-content:center;height:100%;padding:10px;text-align:center;
  font-size:11px;line-height:1.4;color:rgba(60,36,21,.55);border:1.5px dashed var(--brand);border-radius:calc(var(--rad) - 4px);margin:6px;opacity:.75;
}
@media (max-width:649px){
  #fm-{{ section.id }} .mrow{grid-template-columns:1fr;text-align:center;}
  #fm-{{ section.id }} .mrow .schip{left:50%;transform:translateX(-50%);}
  #fm-{{ section.id }} .mrow .im{max-width:200px;margin:0 auto;}
  #fm-{{ section.id }} .mrow p{margin-left:auto;margin-right:auto;}
}

/* ---------- giant type ---------- */
#fm-{{ section.id }} .fm-giant{overflow:hidden;background:var(--bg);border-top:var(--rule);border-bottom:var(--rule);padding:clamp(26px,4vw,44px) 0;}
#fm-{{ section.id }} .fm-giant .row{display:flex;width:max-content;animation:fmmq 44s linear infinite;}
#fm-{{ section.id }} .fm-giant .half{display:flex;white-space:nowrap;}
#fm-{{ section.id }} .fm-giant .word{
  font-family:var(--display);font-weight:400;text-transform:uppercase;
  font-size:clamp(44px,9vw,92px);line-height:1;padding:0 28px;color:transparent;
  -webkit-text-stroke:1.5px var(--brand);
}
#fm-{{ section.id }} .fm-giant .word.fill{color:var(--orange);-webkit-text-stroke:0;}
@media (prefers-reduced-motion:reduce){#fm-{{ section.id }} .fm-giant .row{animation:none;}}

/* ---------- closing ---------- */
#fm-{{ section.id }} .fm-end{padding:clamp(64px,9vw,120px) 22px;}
#fm-{{ section.id }} .fm-end .card{
  max-width:680px;margin:0 auto;background:var(--brand);color:var(--bg);border:var(--rule);
  border-radius:calc(var(--rad) + 10px);box-shadow:5px 5px 0 rgba(60,36,21,.2);
  padding:clamp(36px,6vw,60px) 28px;text-align:center;
}
#fm-{{ section.id }} .fm-end h2{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(26px,5.4vw,44px);line-height:1.05;text-wrap:balance;}
#fm-{{ section.id }} .fm-end h2 em{font-style:normal;color:var(--gold);}
#fm-{{ section.id }} .fm-end p{margin:16px auto 0;max-width:420px;font-size:15px;line-height:1.65;color:rgba(255,251,244,.85);}
#fm-{{ section.id }} .fm-end .btn{margin-top:26px;background:var(--orange);color:#fff;}

/* ---------- leaves ---------- */
#fm-{{ section.id }} .fm-leaves{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;}
</style>

<div id="fm-{{ section.id }}">

  {%- if S.topbar_text != blank -%}
  <div class="fm-strip">{{ S.topbar_text }}</div>
  {%- endif -%}

  <header class="fm-hero" data-fm-hero>
    {%- if S.show_leaves -%}<canvas class="fm-leaves" data-fm-leaves></canvas>{%- endif -%}
    <div class="wrap" style="position:relative;z-index:2">
      <span class="eyebrow">{{ S.hero_eyebrow }}</span>
      <h1><span class="ln"><span>{{ S.hero_title }}</span></span></h1>
      {%- if S.hero_script != blank -%}<span class="script">{{ S.hero_script }}</span>{%- endif -%}
      {%- if S.hero_sub != blank -%}<p class="sub">{{ S.hero_sub }}</p>{%- endif -%}
      <div class="btnrow">
        {%- if S.hero_cta != blank -%}<a class="btn" href="{{ S.hero_cta_url | default: '#fm-lineup' }}">{{ S.hero_cta }}</a>{%- endif -%}
        {%- if S.hero_cta2 != blank -%}<a class="btn btn--ghost" href="{{ S.hero_cta2_url | default: '#fm-menu' }}">{{ S.hero_cta2 }}</a>{%- endif -%}
      </div>
    </div>
    {%- if S.hero_img != blank or request.design_mode -%}
    <div class="frame" style="position:relative;z-index:2">
      {%- if S.hero_img != blank -%}
        <picture>
          {%- if S.hero_img_m != blank -%}<source media="(max-width:749px)" srcset="{{ S.hero_img_m | image_url: width: 1000 }}">{%- endif -%}
          <img src="{{ S.hero_img | image_url: width: 2200 }}" alt="{{ S.hero_alt | escape }}" data-plx="24">
        </picture>
      {%- else -%}
        <div class="hint">Upload a hero image. Photo idea: a cozy fall flat lay, a latte with leaf latte art on a knit blanket, small pumpkins and a Syruvia bottle in warm afternoon light.</div>
      {%- endif -%}
    </div>
    {%- endif -%}
  </header>

  {%- if S.show_tick and S.tick_text != blank -%}
  <div class="fm-mq" aria-hidden="true">
    <div class="row">
      <div class="half">{%- for i in (1..4) -%}<span>{{ S.tick_text }}</span>{%- endfor -%}</div>
      <div class="half">{%- for i in (1..4) -%}<span>{{ S.tick_text }}</span>{%- endfor -%}</div>
    </div>
  </div>
  {%- endif -%}

  <section class="fm-intro">
    <div class="wrap">
      <div class="fm-rev">
        <span class="eyebrow">{{ S.intro_kick }}</span>
        <h2 class="big">{{ S.intro_big }}</h2>
        <p>{{ S.intro_p }}</p>
      </div>
      <div class="stats">
        {%- if S.f1_l != blank -%}<div class="stat fm-rev"><span class="l">{{ S.f1_l }}</span><span class="v">{{ S.f1_v }}</span></div>{%- endif -%}
        {%- if S.f2_l != blank -%}<div class="stat fm-rev" style="transition-delay:.08s"><span class="l">{{ S.f2_l }}</span><span class="v">{{ S.f2_v }}</span></div>{%- endif -%}
        {%- if S.f3_l != blank -%}<div class="stat fm-rev" style="transition-delay:.16s"><span class="l">{{ S.f3_l }}</span><span class="v">{{ S.f3_v }}</span></div>{%- endif -%}
      </div>
    </div>
  </section>

  <section class="fm-shop" id="fm-lineup">
    <div class="wrap">
      <div class="headrow fm-rev">
        <span class="eyebrow">{{ S.feat_kick }}</span>
        <h2 class="h2">{{ S.feat_title }}</h2>
      </div>
      <div class="fm-grid" data-fm-stagger>
        {%- assign shown = 0 -%}
        {%- if coll != blank -%}
          {%- for fp in coll.products limit: 12 -%}
            {%- if fp.available -%}
              {%- render 'fm-fall-card', fp: fp, sett: S -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for fp in coll.products limit: 12 -%}
            {%- unless fp.available -%}
              {%- if shown < 12 -%}
                {%- render 'fm-fall-card', fp: fp, sett: S -%}
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if shown == 0 and request.design_mode -%}
          <p style="grid-column:1/-1;text-align:center;opacity:.6">No products found. Set the collection handle in section settings.</p>
        {%- endif -%}
      </div>
      {%- if S.seeall != blank -%}
      <div class="seeall-row fm-rev"><a class="btn btn--ghost" href="{{ S.seeall_url | default: end_url }}">{{ S.seeall }}</a></div>
      {%- endif -%}
    </div>
  </section>

  {%- assign cozy_blocks = section.blocks | where: 'type', 'box' -%}
  {%- if cozy_blocks.size > 0 -%}
  <section class="fm-cozy">
    <div class="wrap">
      <div class="headrow fm-rev">
        <span class="eyebrow">{{ S.cozy_kick }}</span>
        <h2 class="h2">{{ S.cozy_title }}</h2>
      </div>
      <div class="boxes">
        {%- for block in cozy_blocks -%}
        <div class="box fm-rev" style="--i:{{ forloop.index0 }};--bxbg:{{ block.settings.bg | default: '#3c2415' }};--bxtx:{{ block.settings.tx | default: '#FFFBF4' }};transition-delay:{{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          <span class="n">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if S.band_img != blank or request.design_mode -%}
  <div class="fm-band">
    <div class="wrap">
      <div class="media fm-rev">
        {%- if S.band_img != blank -%}
          <img src="{{ S.band_img | image_url: width: 2400 }}" alt="{{ S.band_alt | escape }}" data-plx="34">
          {%- if S.band_cap != blank -%}<p class="cap">{{ S.band_cap }}</p>{%- endif -%}
        {%- else -%}
          <div class="hint">Upload a full width lifestyle image. Photo idea: golden hour light through a window, a steaming mug on a wooden table, plaid blanket, leaves on the sill.</div>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- assign rec_blocks = section.blocks | where: 'type', 'recipe' -%}
  {%- if rec_blocks.size > 0 -%}
  <section class="fm-menu" id="fm-menu">
    <div class="wrap">
      <div class="headrow fm-rev">
        <span class="eyebrow">{{ S.menu_kick }}</span>
        <h2 class="h2">{{ S.menu_title }}</h2>
      </div>
      {%- for block in rec_blocks -%}
      <div class="mrow fm-rev" style="transition-delay:{{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
        {%- if block.settings.tag != blank -%}<span class="schip">{{ block.settings.tag }}</span>{%- endif -%}
        <div>
          <h3><span class="no">{{ forloop.index | prepend: '0' }}</span>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
        <div class="im">
          {%- if block.settings.img != blank -%}
            <img src="{{ block.settings.img | image_url: width: 440 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- elsif request.design_mode -%}
            <div class="hint">{{ block.settings.hint }}</div>
          {%- endif -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- if S.show_giant and S.giant_text != blank -%}
  <div class="fm-giant" aria-hidden="true">
    <div class="row">
      <div class="half"><span class="word">{{ S.giant_text }}</span><span class="word fill">{{ S.giant_text }}</span><span class="word">{{ S.giant_text }}</span></div>
      <div class="half"><span class="word">{{ S.giant_text }}</span><span class="word fill">{{ S.giant_text }}</span><span class="word">{{ S.giant_text }}</span></div>
    </div>
  </div>
  {%- endif -%}

  <section class="fm-end">
    <div class="card fm-rev">
      <h2>{{ S.end_title }}</h2>
      {%- if S.end_sub != blank -%}<p>{{ S.end_sub }}</p>{%- endif -%}
      {%- if S.end_cta != blank -%}<a class="btn" href="{{ end_url }}">{{ S.end_cta }}</a>{%- endif -%}
    </div>
  </section>

</div>

<script>
(function(){
  var root=document.getElementById('fm-{{ section.id }}');
  if(!root)return;
  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* hero entrance */
  var hero=root.querySelector('[data-fm-hero]');
  if(hero){requestAnimationFrame(function(){requestAnimationFrame(function(){hero.classList.add('go');});});}

  /* reveals */
  var revs=root.querySelectorAll('.fm-rev');
  if('IntersectionObserver' in window && !reduced){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
    },{threshold:.12,rootMargin:'0px 0px -6% 0px'});
    var grid=root.querySelector('[data-fm-stagger]');
    if(grid){
      Array.prototype.forEach.call(grid.children,function(c,i){
        if(c.classList.contains('fm-rev'))c.style.transitionDelay=(i%4)*0.07+'s';
      });
    }
    Array.prototype.forEach.call(revs,function(el){io.observe(el);});
  }else{
    Array.prototype.forEach.call(revs,function(el){el.classList.add('in');});
  }

  /* parallax */
  var plx=Array.prototype.slice.call(root.querySelectorAll('[data-plx]'));
  if(plx.length && !reduced){
    var tick=false;
    var run=function(){
      tick=false;
      var vh=window.innerHeight;
      plx.forEach(function(img){
        var host=img.closest('.frame')||img.closest('.media')||img;
        var box=host.getBoundingClientRect();
        if(box.bottom<0||box.top>vh)return;
        var prog=(box.top+box.height/2-vh/2)/(vh/2+box.height/2);
        var amp=parseFloat(img.getAttribute('data-plx'))||24;
        img.style.transform='translateY('+(-prog*amp)+'px)';
      });
    };
    var onScroll=function(){if(!tick){tick=true;requestAnimationFrame(run);}};
    window.addEventListener('scroll',onScroll,{passive:true});
    window.addEventListener('resize',onScroll);
    run();
  }

  /* drifting leaves, subtle */
  var lc=root.querySelector('[data-fm-leaves]');
  if(lc && !reduced){
    var ctx=lc.getContext('2d'),W,H,leaves=[],running=true;
    var tones=['rgba(226,143,38,.4)','rgba(200,110,40,.38)','rgba(140,70,30,.3)'];
    var size=function(){
      var r=lc.parentElement.getBoundingClientRect();
      W=lc.width=r.width;H=lc.height=r.height;
    };
    size();window.addEventListener('resize',size);
    for(var i=0;i<18;i++){
      leaves.push({
        x:Math.random()*2000,y:Math.random()*1200,
        rx:4+Math.random()*5,ry:2+Math.random()*2.5,
        v:.3+Math.random()*.45,w:Math.random()*Math.PI*2,
        rot:Math.random()*Math.PI*2,rv:(Math.random()-.5)*.02,
        c:tones[i%3]
      });
    }
    var draw=function(){
      if(!running)return;
      ctx.clearRect(0,0,W,H);
      leaves.forEach(function(f){
        f.y+=f.v;f.w+=.01;f.x+=Math.sin(f.w)*.5;f.rot+=f.rv;
        if(f.y>H+8){f.y=-8;f.x=Math.random()*W;}
        ctx.save();
        ctx.translate(f.x%W,f.y);ctx.rotate(f.rot);
        ctx.fillStyle=f.c;
        ctx.beginPath();ctx.ellipse(0,0,f.rx,f.ry,0,0,6.283);ctx.fill();
        ctx.restore();
      });
      requestAnimationFrame(draw);
    };
    document.addEventListener('visibilitychange',function(){
      running=!document.hidden;if(running)requestAnimationFrame(draw);
    });
    draw();
  }
})();
</script>

