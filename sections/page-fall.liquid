{%- comment -%}
  Syruvia Fall Mood page. Cozy editorial seasonal landing, "Powered by Pump(kin)!".
  Prefix: fm-. Sections: notice strip, hero with drifting leaves, ticker, intro,
  lineup, cozy tiles, image band, cozy menu (recipes), giant type marquee, closing CTA.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Instrument+Sans:wght@400;500;600&display=swap"></noscript>

{%- liquid
  assign S = section.settings
  assign coll = collections[S.collection_handle]
  assign end_url = S.end_url
  if end_url == blank and coll != blank
    assign end_url = coll.url
  endif
  if end_url == blank
    assign end_url = '/collections/all'
  endif
-%}

<style>
#fm-{{ section.id }}{
  --butter:{{ S.c_butter | default: '#FBF4E6' }};
  --espresso:{{ S.c_espresso | default: '#3B2416' }};
  --pump:{{ S.c_pump | default: '#C2611E' }};
  --gold:{{ S.c_gold | default: '#DCA54A' }};
  --paper:#ffffff;
  --line:rgba(59,36,22,.14);
  --serif:'Fraunces',Georgia,'Times New Roman',serif;
  --sans:'Instrument Sans',system-ui,-apple-system,sans-serif;
  --ease:cubic-bezier(.16,1,.3,1);
  background:var(--butter);color:var(--espresso);font-family:var(--sans);
  font-size:16px;line-height:1.6;overflow-x:clip;position:relative;
}
#fm-{{ section.id }} *{box-sizing:border-box;margin:0;}
#fm-{{ section.id }} img{max-width:100%;display:block;}
#fm-{{ section.id }} a{color:inherit;}
#fm-{{ section.id }} .wrap{max-width:1200px;margin:0 auto;padding:0 24px;}

/* ---------- type ---------- */
#fm-{{ section.id }} .kick{
  font-family:var(--sans);font-weight:600;font-size:11px;letter-spacing:.22em;
  text-transform:uppercase;color:var(--pump);display:block;
}
#fm-{{ section.id }} .h2{
  font-family:var(--serif);font-variation-settings:'opsz' 100;font-weight:420;
  font-size:clamp(2rem,4.6vw,3.4rem);line-height:1.08;letter-spacing:-.01em;
  margin-top:14px;text-wrap:balance;
}
#fm-{{ section.id }} .h2 em,#fm-{{ section.id }} .big em{font-style:italic;font-weight:380;color:var(--pump);}

/* ---------- reveal ---------- */
#fm-{{ section.id }} .fm-rev{opacity:0;transform:translateY(22px);transition:opacity .7s var(--ease),transform .7s var(--ease);}
#fm-{{ section.id }} .fm-rev.in{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){
  #fm-{{ section.id }} .fm-rev{opacity:1;transform:none;transition:none;}
}

/* ---------- notice strip ---------- */
#fm-{{ section.id }} .fm-strip{
  background:var(--espresso);color:var(--butter);text-align:center;
  padding:10px 20px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;
}

/* ---------- hero ---------- */
#fm-{{ section.id }} .fm-hero{background:var(--butter);padding:clamp(80px,11vw,130px) 0 0;position:relative;overflow:hidden;}
#fm-{{ section.id }} .fm-hero .eyebrow{
  font-size:11px;letter-spacing:.26em;text-transform:uppercase;font-weight:600;color:var(--pump);
}
#fm-{{ section.id }} .fm-hero h1{
  font-family:var(--serif);font-variation-settings:'opsz' 144;font-weight:400;
  font-size:clamp(3.4rem,12vw,8rem);line-height:.96;letter-spacing:-.02em;margin-top:20px;color:var(--espresso);
}
#fm-{{ section.id }} .fm-hero h1 .ln{display:block;overflow:hidden;}
#fm-{{ section.id }} .fm-hero h1 .ln span{display:block;transform:translateY(112%);transition:transform 1s var(--ease);}
#fm-{{ section.id }} .fm-hero.go h1 .ln span{transform:none;}
#fm-{{ section.id }} .fm-hero .script{
  font-family:var(--serif);font-style:italic;font-variation-settings:'opsz' 144;font-weight:380;
  font-size:clamp(1.5rem,4.2vw,2.6rem);color:var(--pump);margin-top:14px;
  display:inline-block;transform:rotate(-2deg) translateY(14px);opacity:0;
  transition:opacity .8s var(--ease) .3s,transform .8s var(--ease) .3s;
}
#fm-{{ section.id }} .fm-hero.go .script{opacity:1;transform:rotate(-2deg);}
#fm-{{ section.id }} .fm-hero .sub{
  max-width:520px;margin-top:22px;font-size:1.05rem;line-height:1.65;color:rgba(59,36,22,.75);
  opacity:0;transform:translateY(14px);transition:opacity .8s var(--ease) .45s,transform .8s var(--ease) .45s;
}
#fm-{{ section.id }} .fm-hero .ctas{
  display:flex;gap:26px;align-items:center;margin-top:32px;flex-wrap:wrap;
  opacity:0;transform:translateY(14px);transition:opacity .8s var(--ease) .6s,transform .8s var(--ease) .6s;
}
#fm-{{ section.id }} .fm-hero.go .sub,#fm-{{ section.id }} .fm-hero.go .ctas{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){
  #fm-{{ section.id }} .fm-hero h1 .ln span,#fm-{{ section.id }} .fm-hero .script,#fm-{{ section.id }} .fm-hero .sub,#fm-{{ section.id }} .fm-hero .ctas{transform:none;opacity:1;transition:none;}
  #fm-{{ section.id }} .fm-hero .script{transform:rotate(-2deg);}
}
#fm-{{ section.id }} .btn{
  display:inline-block;background:var(--pump);color:var(--butter);text-decoration:none;
  font-weight:600;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;
  padding:16px 32px;border-radius:999px;transition:transform .35s var(--ease),filter .35s var(--ease);
}
#fm-{{ section.id }} .btn:hover{transform:translateY(-2px);filter:brightness(1.06);}
#fm-{{ section.id }} .lnk{
  font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;text-decoration:none;
  border-bottom:1px solid rgba(59,36,22,.35);padding-bottom:4px;transition:border-color .3s;
}
#fm-{{ section.id }} .lnk:hover{border-color:var(--pump);}
#fm-{{ section.id }} .fm-hero .frame{
  margin-top:clamp(44px,6.5vw,76px);position:relative;overflow:hidden;border-radius:14px 14px 0 0;
  aspect-ratio:21/9;background:rgba(59,36,22,.06);
}
#fm-{{ section.id }} .fm-hero .frame img{width:100%;height:118%;object-fit:cover;will-change:transform;}
#fm-{{ section.id }} .fm-hero .frame .hint{
  position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;
  padding:24px;color:rgba(59,36,22,.5);font-size:.85rem;line-height:1.5;
  border:1px dashed rgba(59,36,22,.25);border-radius:14px 14px 0 0;
}
@media (max-width:749px){
  #fm-{{ section.id }} .fm-hero{text-align:center;}
  #fm-{{ section.id }} .fm-hero .sub{margin-left:auto;margin-right:auto;}
  #fm-{{ section.id }} .fm-hero .ctas{justify-content:center;}
  #fm-{{ section.id }} .fm-hero .frame{aspect-ratio:4/5;}
}

/* ---------- ticker ---------- */
#fm-{{ section.id }} .fm-tick{background:var(--pump);color:var(--butter);overflow:hidden;padding:12px 0;}
#fm-{{ section.id }} .fm-tick .row{display:flex;width:max-content;animation:fmmq 36s linear infinite;}
#fm-{{ section.id }} .fm-tick .half{display:flex;align-items:center;white-space:nowrap;font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:600;}
#fm-{{ section.id }} .fm-tick .half span{padding:0 18px;}
@keyframes fmmq{to{transform:translateX(-50%);}}
@media (prefers-reduced-motion:reduce){#fm-{{ section.id }} .fm-tick .row{animation:none;}}

/* ---------- intro editorial ---------- */
#fm-{{ section.id }} .fm-intro{padding:clamp(80px,11vw,150px) 0;}
#fm-{{ section.id }} .fm-intro .grid{display:grid;grid-template-columns:7fr 5fr;gap:clamp(40px,6vw,96px);align-items:start;}
#fm-{{ section.id }} .fm-intro .big{
  font-family:var(--serif);font-variation-settings:'opsz' 120;font-weight:400;
  font-size:clamp(2.2rem,5.4vw,4.2rem);line-height:1.06;letter-spacing:-.015em;text-wrap:balance;
}
#fm-{{ section.id }} .fm-intro p{margin-top:4px;font-size:1rem;line-height:1.75;color:rgba(59,36,22,.78);}
#fm-{{ section.id }} .facts{margin-top:40px;}
#fm-{{ section.id }} .facts .f{
  display:flex;justify-content:space-between;gap:16px;align-items:baseline;
  border-top:1px solid var(--line);padding:14px 0;
}
#fm-{{ section.id }} .facts .f:last-child{border-bottom:1px solid var(--line);}
#fm-{{ section.id }} .facts .l{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;color:rgba(59,36,22,.55);}
#fm-{{ section.id }} .facts .v{font-family:var(--serif);font-size:1.05rem;font-weight:450;}
@media (max-width:849px){
  #fm-{{ section.id }} .fm-intro .grid{grid-template-columns:1fr;}
  #fm-{{ section.id }} .fm-intro{text-align:center;}
  #fm-{{ section.id }} .facts .f{text-align:left;}
}

/* ---------- lineup ---------- */
#fm-{{ section.id }} .fm-shop{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:clamp(72px,10vw,130px) 0;}
#fm-{{ section.id }} .headrow{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:clamp(32px,5vw,56px);}
#fm-{{ section.id }} .fm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:22px;}
#fm-{{ section.id }} .fm-card{position:relative;display:flex;flex-direction:column;}
#fm-{{ section.id }} .fm-card .ph{
  position:relative;display:block;aspect-ratio:4/5;overflow:hidden;border-radius:12px;background:#F5EBDB;
}
#fm-{{ section.id }} .fm-grid .fm-card:nth-child(3n+1) .ph{background:#F8ECD9;}
#fm-{{ section.id }} .fm-grid .fm-card:nth-child(3n+2) .ph{background:#F5E3D0;}
#fm-{{ section.id }} .fm-grid .fm-card:nth-child(3n+3) .ph{background:#EFE9D8;}
#fm-{{ section.id }} .fm-card .ph img{width:100%;height:100%;object-fit:contain;padding:10%;transition:transform .8s var(--ease);}
#fm-{{ section.id }} .fm-card:hover .ph img{transform:scale(1.05) rotate(-1.5deg);}
#fm-{{ section.id }} .fm-card .flag{
  position:absolute;top:12px;left:12px;background:var(--espresso);color:var(--butter);
  font-size:9px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;padding:6px 10px;border-radius:999px;z-index:2;
}
#fm-{{ section.id }} .fm-card.soon .ph img{filter:grayscale(.25);opacity:.75;}
#fm-{{ section.id }} .fm-card .veil{
  position:absolute;left:12px;right:12px;bottom:12px;background:rgba(255,255,255,.92);color:var(--espresso);
  text-align:center;font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;padding:9px 8px;border-radius:999px;
}
#fm-{{ section.id }} .fm-card .b{padding:16px 2px 0;display:flex;flex-direction:column;gap:6px;flex:1;}
#fm-{{ section.id }} .fm-card .t{
  font-family:var(--serif);font-size:1.1rem;font-weight:480;line-height:1.25;text-decoration:none;
}
#fm-{{ section.id }} .fm-card .t:hover{color:var(--pump);}
#fm-{{ section.id }} .fm-card .pr{font-size:.9rem;color:rgba(59,36,22,.65);font-variant-numeric:tabular-nums;}
#fm-{{ section.id }} .fm-card .pr s{margin-left:8px;opacity:.55;}
#fm-{{ section.id }} .fm-card form{margin-top:auto;}
#fm-{{ section.id }} .fm-card .atc{
  margin-top:10px;width:100%;background:none;border:1px solid var(--espresso);color:var(--espresso);
  font-family:var(--sans);font-weight:600;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;
  padding:12px 10px;border-radius:999px;cursor:pointer;transition:background .35s var(--ease),color .35s var(--ease);
}
#fm-{{ section.id }} .fm-card .atc:hover{background:var(--espresso);color:var(--butter);}
#fm-{{ section.id }} .fm-card .atc[disabled]{border-color:var(--line);color:rgba(59,36,22,.4);cursor:default;background:none;}
@media (max-width:749px){
  #fm-{{ section.id }} .fm-grid{grid-template-columns:repeat(2,1fr);gap:14px;}
  #fm-{{ section.id }} .fm-card .t{font-size:.98rem;}
  #fm-{{ section.id }} .headrow{flex-direction:column;align-items:center;text-align:center;}
}

/* ---------- cozy tiles ---------- */
#fm-{{ section.id }} .fm-cozy{padding:clamp(80px,11vw,150px) 0;}
#fm-{{ section.id }} .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:clamp(32px,5vw,56px);}
#fm-{{ section.id }} .tile{
  border-radius:16px;padding:30px 28px;min-height:290px;display:flex;flex-direction:column;justify-content:space-between;gap:34px;
}
#fm-{{ section.id }} .tile .no{font-family:var(--serif);font-style:italic;font-size:1rem;opacity:.6;}
#fm-{{ section.id }} .tile h3{font-family:var(--serif);font-weight:430;font-size:clamp(1.5rem,2.4vw,1.9rem);line-height:1.12;letter-spacing:-.01em;}
#fm-{{ section.id }} .tile p{margin-top:10px;font-size:.95rem;line-height:1.6;opacity:.82;}
@media (max-width:849px){
  #fm-{{ section.id }} .tiles{grid-template-columns:1fr;gap:16px;}
  #fm-{{ section.id }} .tile{position:sticky;top:calc(92px + var(--i)*14px);min-height:0;gap:22px;text-align:left;}
  #fm-{{ section.id }} .fm-cozy{text-align:center;}
}

/* ---------- image band ---------- */
#fm-{{ section.id }} .fm-band{position:relative;overflow:hidden;height:clamp(340px,55vw,560px);background:var(--espresso);}
#fm-{{ section.id }} .fm-band img{position:absolute;top:0;left:0;width:100%;height:120%;object-fit:cover;will-change:transform;}
#fm-{{ section.id }} .fm-band .cap{
  position:absolute;left:0;right:0;bottom:26px;text-align:center;color:var(--butter);
  font-family:var(--serif);font-style:italic;font-size:clamp(1.05rem,2.2vw,1.4rem);text-shadow:0 1px 14px rgba(0,0,0,.35);padding:0 20px;
}
#fm-{{ section.id }} .fm-band .hint{
  position:absolute;top:20px;left:20px;right:20px;bottom:20px;display:flex;align-items:center;justify-content:center;text-align:center;
  color:rgba(251,244,230,.6);font-size:.85rem;border:1px dashed rgba(251,244,230,.3);border-radius:14px;padding:20px;
}

/* ---------- cozy menu ---------- */
#fm-{{ section.id }} .fm-menu{background:var(--paper);padding:clamp(80px,11vw,150px) 0;border-bottom:1px solid var(--line);}
#fm-{{ section.id }} .menu-list{margin-top:clamp(28px,4vw,48px);}
#fm-{{ section.id }} .mrow{
  display:grid;grid-template-columns:70px 1fr 130px;gap:24px;align-items:center;
  border-top:1px solid var(--line);padding:26px 0;transition:background .4s var(--ease);
}
#fm-{{ section.id }} .mrow:last-child{border-bottom:1px solid var(--line);}
#fm-{{ section.id }} .mrow:hover{background:var(--butter);}
#fm-{{ section.id }} .mrow .no{font-family:var(--serif);font-style:italic;font-size:1.4rem;color:rgba(59,36,22,.4);padding-left:8px;}
#fm-{{ section.id }} .mrow h3{font-family:var(--serif);font-weight:440;font-size:clamp(1.4rem,3vw,1.9rem);letter-spacing:-.01em;line-height:1.15;}
#fm-{{ section.id }} .mrow .tag{
  display:inline-block;margin-left:14px;vertical-align:middle;font-family:var(--sans);
  font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--pump);
  border:1px solid currentColor;border-radius:999px;padding:4px 10px;
}
#fm-{{ section.id }} .mrow p{margin-top:8px;font-size:.95rem;line-height:1.6;color:rgba(59,36,22,.72);max-width:560px;}
#fm-{{ section.id }} .mrow .im{aspect-ratio:1/1;border-radius:12px;overflow:hidden;background:#F5EBDB;}
#fm-{{ section.id }} .mrow .im img{width:100%;height:100%;object-fit:cover;}
#fm-{{ section.id }} .mrow .im .hint{
  display:flex;align-items:center;justify-content:center;height:100%;padding:10px;text-align:center;
  font-size:.65rem;line-height:1.4;color:rgba(59,36,22,.5);border:1px dashed var(--line);border-radius:12px;
}
@media (max-width:749px){
  #fm-{{ section.id }} .mrow{grid-template-columns:1fr;gap:14px;text-align:center;}
  #fm-{{ section.id }} .mrow .no{padding:0;}
  #fm-{{ section.id }} .mrow .tag{margin-left:10px;}
  #fm-{{ section.id }} .mrow .im{max-width:220px;margin:0 auto;}
  #fm-{{ section.id }} .mrow p{margin-left:auto;margin-right:auto;}
  #fm-{{ section.id }} .fm-menu .headrow{align-items:center;text-align:center;}
}

/* ---------- giant type ---------- */
#fm-{{ section.id }} .fm-giant{background:var(--espresso);overflow:hidden;padding:clamp(48px,7vw,90px) 0;}
#fm-{{ section.id }} .fm-giant .row{display:flex;width:max-content;animation:fmmq 46s linear infinite;}
#fm-{{ section.id }} .fm-giant .half{display:flex;white-space:nowrap;}
#fm-{{ section.id }} .fm-giant .word{
  font-family:var(--serif);font-style:italic;font-variation-settings:'opsz' 144;font-weight:340;
  font-size:clamp(4rem,10vw,8.5rem);line-height:1;padding:0 36px;color:transparent;
  -webkit-text-stroke:1px rgba(251,244,230,.55);
}
#fm-{{ section.id }} .fm-giant .word.fill{color:var(--pump);-webkit-text-stroke:0;}
@media (prefers-reduced-motion:reduce){#fm-{{ section.id }} .fm-giant .row{animation:none;}}

/* ---------- closing ---------- */
#fm-{{ section.id }} .fm-end{background:var(--espresso);color:var(--butter);text-align:center;padding:clamp(90px,13vw,170px) 24px;border-top:1px solid rgba(251,244,230,.12);}
#fm-{{ section.id }} .fm-end h2{
  font-family:var(--serif);font-variation-settings:'opsz' 144;font-weight:380;
  font-size:clamp(2.6rem,7vw,5rem);line-height:1.02;letter-spacing:-.015em;text-wrap:balance;
}
#fm-{{ section.id }} .fm-end h2 em{font-style:italic;color:var(--gold);}
#fm-{{ section.id }} .fm-end p{margin:22px auto 0;max-width:440px;font-size:1rem;line-height:1.65;color:rgba(251,244,230,.82);}
#fm-{{ section.id }} .fm-end .btn{margin-top:36px;}

/* ---------- leaves ---------- */
#fm-{{ section.id }} .fm-leaves{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;}
</style>

<div id="fm-{{ section.id }}">

  {%- if S.topbar_text != blank -%}
  <div class="fm-strip">{{ S.topbar_text }}</div>
  {%- endif -%}

  <header class="fm-hero" data-fm-hero>
    {%- if S.show_leaves -%}<canvas class="fm-leaves" data-fm-leaves></canvas>{%- endif -%}
    <div class="wrap" style="position:relative;z-index:2">
      <span class="eyebrow">{{ S.hero_eyebrow }}</span>
      <h1><span class="ln"><span>{{ S.hero_title }}</span></span></h1>
      {%- if S.hero_script != blank -%}<span class="script">{{ S.hero_script }}</span>{%- endif -%}
      {%- if S.hero_sub != blank -%}<p class="sub">{{ S.hero_sub }}</p>{%- endif -%}
      <div class="ctas">
        {%- if S.hero_cta != blank -%}<a class="btn" href="{{ S.hero_cta_url | default: '#fm-lineup' }}">{{ S.hero_cta }}</a>{%- endif -%}
        {%- if S.hero_cta2 != blank -%}<a class="lnk" href="{{ S.hero_cta2_url | default: '#fm-menu' }}">{{ S.hero_cta2 }}</a>{%- endif -%}
      </div>
      {%- if S.hero_img != blank or request.design_mode -%}
      <div class="frame">
        {%- if S.hero_img != blank -%}
          <picture>
            {%- if S.hero_img_m != blank -%}<source media="(max-width:749px)" srcset="{{ S.hero_img_m | image_url: width: 1000 }}">{%- endif -%}
            <img src="{{ S.hero_img | image_url: width: 2200 }}" alt="{{ S.hero_alt | escape }}" data-plx="26">
          </picture>
        {%- else -%}
          <div class="hint">Upload a hero image. Photo idea: a cozy fall flat lay, a latte with leaf latte art on a knit blanket, small pumpkins and a Syruvia bottle in warm afternoon light.</div>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </header>

  {%- if S.show_tick and S.tick_text != blank -%}
  <div class="fm-tick" aria-hidden="true">
    <div class="row">
      <div class="half">{%- for i in (1..4) -%}<span>{{ S.tick_text }}</span>{%- endfor -%}</div>
      <div class="half">{%- for i in (1..4) -%}<span>{{ S.tick_text }}</span>{%- endfor -%}</div>
    </div>
  </div>
  {%- endif -%}

  <section class="fm-intro">
    <div class="wrap">
      <div class="grid">
        <div class="fm-rev">
          <span class="kick">{{ S.intro_kick }}</span>
          <h2 class="big" style="margin-top:16px">{{ S.intro_big }}</h2>
        </div>
        <div class="fm-rev" style="transition-delay:.12s">
          <p>{{ S.intro_p }}</p>
          <div class="facts">
            {%- if S.f1_l != blank -%}<div class="f"><span class="l">{{ S.f1_l }}</span><span class="v">{{ S.f1_v }}</span></div>{%- endif -%}
            {%- if S.f2_l != blank -%}<div class="f"><span class="l">{{ S.f2_l }}</span><span class="v">{{ S.f2_v }}</span></div>{%- endif -%}
            {%- if S.f3_l != blank -%}<div class="f"><span class="l">{{ S.f3_l }}</span><span class="v">{{ S.f3_v }}</span></div>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="fm-shop" id="fm-lineup">
    <div class="wrap">
      <div class="headrow fm-rev">
        <div>
          <span class="kick">{{ S.feat_kick }}</span>
          <h2 class="h2">{{ S.feat_title }}</h2>
        </div>
        {%- if S.seeall != blank -%}
        <a class="lnk" style="border-color:var(--line);color:var(--espresso)" href="{{ S.seeall_url | default: end_url }}">{{ S.seeall }}</a>
        {%- endif -%}
      </div>
      <div class="fm-grid" data-fm-stagger>
        {%- assign shown = 0 -%}
        {%- if coll != blank -%}
          {%- for fp in coll.products limit: 12 -%}
            {%- if fp.available -%}
              {%- render 'fm-fall-card', fp: fp, sett: S -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for fp in coll.products limit: 12 -%}
            {%- unless fp.available -%}
              {%- if shown < 12 -%}
                {%- render 'fm-fall-card', fp: fp, sett: S -%}
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if shown == 0 and request.design_mode -%}
          <p style="grid-column:1/-1;color:rgba(59,36,22,.5)">No products found. Set the collection handle in section settings.</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- assign cozy_blocks = section.blocks | where: 'type', 'box' -%}
  {%- if cozy_blocks.size > 0 -%}
  <section class="fm-cozy">
    <div class="wrap">
      <div class="fm-rev">
        <span class="kick">{{ S.cozy_kick }}</span>
        <h2 class="h2">{{ S.cozy_title }}</h2>
      </div>
      <div class="tiles">
        {%- for block in cozy_blocks -%}
        <div class="tile fm-rev" style="--i:{{ forloop.index0 }};background:{{ block.settings.bg | default: '#3B2416' }};color:{{ block.settings.tx | default: '#FBF4E6' }};transition-delay:{{ forloop.index0 | times: 0.1 }}s{% if block.settings.bordered %};border:1px solid var(--line){% endif %}" {{ block.shopify_attributes }}>
          <span class="no">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if S.band_img != blank or request.design_mode -%}
  <div class="fm-band">
    {%- if S.band_img != blank -%}
      <img src="{{ S.band_img | image_url: width: 2400 }}" alt="{{ S.band_alt | escape }}" data-plx="40">
      {%- if S.band_cap != blank -%}<p class="cap">{{ S.band_cap }}</p>{%- endif -%}
    {%- else -%}
      <div class="hint">Upload a full width lifestyle image. Photo idea: golden hour light through a window, a steaming mug on a wooden table, plaid blanket, leaves on the sill.</div>
    {%- endif -%}
  </div>
  {%- endif -%}

  {%- assign rec_blocks = section.blocks | where: 'type', 'recipe' -%}
  {%- if rec_blocks.size > 0 -%}
  <section class="fm-menu" id="fm-menu">
    <div class="wrap">
      <div class="headrow fm-rev">
        <div>
          <span class="kick">{{ S.menu_kick }}</span>
          <h2 class="h2">{{ S.menu_title }}</h2>
        </div>
      </div>
      <div class="menu-list">
        {%- for block in rec_blocks -%}
        <div class="mrow fm-rev" style="transition-delay:{{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          <span class="no">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h3>{{ block.settings.title }}{%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
          <div class="im">
            {%- if block.settings.img != blank -%}
              <img src="{{ block.settings.img | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- elsif request.design_mode -%}
              <div class="hint">{{ block.settings.hint }}</div>
            {%- endif -%}
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if S.show_giant and S.giant_text != blank -%}
  <div class="fm-giant" aria-hidden="true">
    <div class="row">
      <div class="half"><span class="word">{{ S.giant_text }}</span><span class="word fill">{{ S.giant_text }}</span><span class="word">{{ S.giant_text }}</span></div>
      <div class="half"><span class="word">{{ S.giant_text }}</span><span class="word fill">{{ S.giant_text }}</span><span class="word">{{ S.giant_text }}</span></div>
    </div>
  </div>
  {%- endif -%}

  <section class="fm-end">
    <div class="fm-rev">
      <h2>{{ S.end_title }}</h2>
      {%- if S.end_sub != blank -%}<p>{{ S.end_sub }}</p>{%- endif -%}
      {%- if S.end_cta != blank -%}<a class="btn" href="{{ end_url }}">{{ S.end_cta }}</a>{%- endif -%}
    </div>
  </section>

</div>

<script>
(function(){
  var root=document.getElementById('fm-{{ section.id }}');
  if(!root)return;
  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* hero entrance */
  var hero=root.querySelector('[data-fm-hero]');
  if(hero){requestAnimationFrame(function(){requestAnimationFrame(function(){hero.classList.add('go');});});}

  /* reveals */
  var revs=root.querySelectorAll('.fm-rev');
  if('IntersectionObserver' in window && !reduced){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
    },{threshold:.12,rootMargin:'0px 0px -6% 0px'});
    var grid=root.querySelector('[data-fm-stagger]');
    if(grid){
      Array.prototype.forEach.call(grid.children,function(c,i){
        if(c.classList.contains('fm-rev'))c.style.transitionDelay=(i%4)*0.07+'s';
      });
    }
    Array.prototype.forEach.call(revs,function(el){io.observe(el);});
  }else{
    Array.prototype.forEach.call(revs,function(el){el.classList.add('in');});
  }

  /* parallax */
  var plx=Array.prototype.slice.call(root.querySelectorAll('[data-plx]'));
  if(plx.length && !reduced){
    var tick=false;
    var run=function(){
      tick=false;
      var vh=window.innerHeight;
      plx.forEach(function(img){
        var host=img.closest('.frame')||img.closest('.fm-band')||img;
        var box=host.getBoundingClientRect();
        if(box.bottom<0||box.top>vh)return;
        var prog=(box.top+box.height/2-vh/2)/(vh/2+box.height/2);
        var amp=parseFloat(img.getAttribute('data-plx'))||24;
        img.style.transform='translateY('+(-prog*amp)+'px)';
      });
    };
    var onScroll=function(){if(!tick){tick=true;requestAnimationFrame(run);}};
    window.addEventListener('scroll',onScroll,{passive:true});
    window.addEventListener('resize',onScroll);
    run();
  }

  /* drifting leaves, subtle */
  var lc=root.querySelector('[data-fm-leaves]');
  if(lc && !reduced){
    var ctx=lc.getContext('2d'),W,H,leaves=[],running=true;
    var tones=['rgba(194,97,30,.4)','rgba(220,165,74,.42)','rgba(140,59,27,.32)'];
    var size=function(){
      var r=lc.parentElement.getBoundingClientRect();
      W=lc.width=r.width;H=lc.height=r.height;
    };
    size();window.addEventListener('resize',size);
    for(var i=0;i<18;i++){
      leaves.push({
        x:Math.random()*2000,y:Math.random()*1200,
        rx:4+Math.random()*5,ry:2+Math.random()*2.5,
        v:.3+Math.random()*.45,w:Math.random()*Math.PI*2,
        rot:Math.random()*Math.PI*2,rv:(Math.random()-.5)*.02,
        c:tones[i%3]
      });
    }
    var draw=function(){
      if(!running)return;
      ctx.clearRect(0,0,W,H);
      leaves.forEach(function(f){
        f.y+=f.v;f.w+=.01;f.x+=Math.sin(f.w)*.5;f.rot+=f.rv;
        if(f.y>H+8){f.y=-8;f.x=Math.random()*W;}
        ctx.save();
        ctx.translate(f.x%W,f.y);ctx.rotate(f.rot);
        ctx.fillStyle=f.c;
        ctx.beginPath();ctx.ellipse(0,0,f.rx,f.ry,0,0,6.283);ctx.fill();
        ctx.restore();
      });
      requestAnimationFrame(draw);
    };
    document.addEventListener('visibilitychange',function(){
      running=!document.hidden;if(running)requestAnimationFrame(draw);
    });
    draw();
  }
})();
</script>

