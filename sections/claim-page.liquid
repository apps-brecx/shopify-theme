</style>

<script>
(function(){
  function init(root){
    var form = root.querySelector('.cp-form');
    if (!form || form.dataset.syInit) return;
    form.dataset.syInit = '1';
    var dots      = root.querySelector('.cp-dots');
    var orderIn   = root.querySelector('.cp-order');
    var next1     = root.querySelector('.cp-next');
    var typesWrap = root.querySelector('.cp-types');
    var pickedEl  = root.querySelector('.cp-picked');
    var photoReq  = root.querySelector('[data-badge="photo"]');
    var msgReq    = root.querySelector('[data-badge="msg"]');
    var msgIn     = root.querySelector('.cp-msg');
    var filesIn   = root.querySelector('.cp-files');
    var fileList  = root.querySelector('.cp-filelist');
    var submitBtn = root.querySelector('.cp-submit');
    var statusEl  = root.querySelector('.cp-status');
    var doneEl    = root.querySelector('.cp-done');
    var doneText  = root.querySelector('.cp-done-p');
    var againBtn  = root.querySelector('.cp-again');
    var submitLabel = submitBtn ? submitBtn.textContent : 'Submit claim';
    var MAX_FILES = 10, MAX_FILE_BYTES = 10 * 1024 * 1024, MAX_TOTAL_BYTES = 35 * 1024 * 1024;

    /* Endpoint: section setting, else the floating widget's configured one. */
    var endpoint = (root.dataset.endpoint || '').trim();
    if (!endpoint){
      var w = document.getElementById('bb-floating-contact');
      endpoint = w ? (w.dataset.chatEndpoint || '').trim() : '';
    }
    endpoint = endpoint.replace(/\/+$/, '');
    var contactUrl = root.dataset.contactUrl || '/pages/contact-us';

    function openMessage(){
      var btn = document.getElementById('bb-float-btn');
      var modal = document.getElementById('bb-contact-modal');
      if (btn && modal && window.bbShowTab){
        if (modal.hidden) btn.click();
        window.bbShowTab('form');
        return;
      }
      window.location.href = contactUrl;
    }

    function makeKey(){
      return (window.crypto && crypto.randomUUID) ? crypto.randomUUID()
        : 'ck-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
    }
    var idemKey = makeKey();
    var picked = [];
    var sending = false;
    var chosenType = '';
    var needPhoto = false, needMsg = false;

    function contentChanged(){ if (!sending) idemKey = makeKey(); }
    function totalPicked(){ return picked.reduce(function(s, f){ return s + f.size; }, 0); }
    function setBadge(el, req){
      if (!el) return;
      el.textContent = req ? 'required' : 'optional';
      el.classList.toggle('is-opt', !req);
    }
    function syncNext(){ if (next1) next1.disabled = !(orderIn && (orderIn.value || '').trim()); }
    function canSubmit(){
      if (!chosenType) return false;
      if (needPhoto && picked.length === 0) return false;
      if (needMsg && !((msgIn && msgIn.value) || '').trim()) return false;
      return true;
    }
    function syncSubmit(){ if (submitBtn && !sending) submitBtn.disabled = !canSubmit(); }
    form.addEventListener('input', function(){ contentChanged(); syncNext(); syncSubmit(); });
    function status(msg, ok){
      if (!statusEl) return;
      statusEl.textContent = msg || '';
      statusEl.style.color = ok ? '#1a7f37' : '';
    }
    function goStep(n){
      Array.prototype.forEach.call(form.querySelectorAll('.cp-step'), function(s){
        s.classList.toggle('is-active', s.getAttribute('data-step') === String(n));
      });
      if (dots) Array.prototype.forEach.call(dots.querySelectorAll('.cp-dot'), function(d, i){
        d.classList.toggle('is-on', i < n);
      });
      status('');
    }

    /* Step 1 → 2 only after the order number checks out against the same
       /track lookup the Track page uses. A definitive "not found" blocks the
       step and points at the message form; network/worker trouble fails OPEN
       (the claim intake re-validates server-side). Cached so Back→Next
       doesn't re-fetch. */
    var checking = false;
    var okOrder = null;
    function claimCta(msg){
      if (!statusEl) return;
      statusEl.style.color = '';
      statusEl.textContent = '';
      statusEl.appendChild(document.createTextNode(msg + ' '));
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cp-cta';
      btn.textContent = 'Send us a message instead';
      btn.addEventListener('click', openMessage);
      statusEl.appendChild(btn);
    }
    /* Classify the /track answer. found/notfound are definitive; a 400 is the
       worker REJECTING the input as not-an-order-number (definitive — must
       block, NOT fail open); a 429 is the rate limit (block and ask to wait).
       Only genuine worker/network trouble stays fail-open. */
    async function checkOrder(v){
      var ctrl  = ('AbortController' in window) ? new AbortController() : null;
      var timer = ctrl && setTimeout(function(){ ctrl.abort(); }, 12000);
      try {
        var res = await fetch(endpoint + '/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ order_number: v }),
          signal: ctrl ? ctrl.signal : undefined
        });
        var data = null;
        try { data = await res.json(); } catch(e){}
        if (res.ok && data && data.ok) return { state: data.found ? 'found' : 'notfound' };
        if (res.status === 400) return { state: 'invalid', msg: (data && data.error) || 'Please enter a valid order number.' };
        if (res.status === 429) return { state: 'busy' };
        return { state: 'unknown' };   /* worker error → fail open */
      } catch(e){
        return { state: 'unknown' };   /* network error → fail open */
      } finally {
        if (timer) clearTimeout(timer);
      }
    }
    if (next1) next1.addEventListener('click', async function(){
      if (checking) return;
      var v = (orderIn.value || '').trim();
      if (!v){ status('Please enter your order number.'); orderIn.focus(); return; }
      /* Format gate BEFORE any network: order numbers are 4-20 digits (the
         worker's own rule). Without this, garbage input rode the fail-open
         path straight past verification. */
      var digits = v.replace(/[^0-9]/g, '');
      if (digits.length < 4 || digits.length > 20){
        status('Hmm, that doesn’t look like an order number — it’s the long number from your confirmation email, like 154008582984.');
        orderIn.focus();
        return;
      }
      if (!endpoint || v === okOrder){ goStep(2); return; }
      checking = true;
      var lbl = next1.textContent;
      next1.disabled = true;
      next1.textContent = 'Checking…';
      status('');
      var check = await checkOrder(v);
      checking = false;
      next1.textContent = lbl;
      next1.disabled = false;
      syncNext();
      if (check.state === 'notfound'){
        claimCta('We couldn’t find that order number. Double-check it — brand-new orders can take a little while to appear.');
        orderIn.focus();
        return;
      }
      if (check.state === 'invalid'){ status(check.msg); orderIn.focus(); return; }
      if (check.state === 'busy'){ status('That’s a few checks in a row — give it a minute, then try again.'); return; }
      /* A different order = a different product list. Stale selections must
         never ride into the new order's claim (the picker's silent-skip
         path would otherwise submit order A's bullets on order B). */
      if (selItems.length){ selItems = []; contentChanged(); updateChip(); }
      okOrder = v;
      prefetchItems(v);   /* warm the product picker while they pick a type */
      goStep(2);
    });
    if (orderIn) orderIn.addEventListener('keydown', function(e){
      if (e.key === 'Enter'){ e.preventDefault(); if (next1) next1.click(); }
    });
    form.addEventListener('click', function(e){
      if (sending) return;
      var b = e.target.closest ? e.target.closest('.cp-back') : null;
      if (b && b.dataset.back) goStep(parseInt(b.dataset.back, 10));
    });

    function updateChip(){
      if (!pickedEl) return;
      pickedEl.textContent = '';
      if (!chosenType) return;
      var chip = document.createElement('span');
      chip.className = 'cp-chip';
      chip.textContent = chosenType + (selItems.length ? ' · ' + selItems.length + (selItems.length === 1 ? ' product' : ' products') : '');
      var chg = document.createElement('button');
      chg.type = 'button';
      chg.className = 'cp-chg';
      chg.textContent = 'change';
      chg.addEventListener('click', function(){ if (!sending) goStep(2); });
      pickedEl.appendChild(chip);
      pickedEl.appendChild(chg);
    }
    if (typesWrap) typesWrap.addEventListener('click', function(e){
      if (sending) return;
      var card = e.target.closest ? e.target.closest('.cp-type') : null;
      if (!card) return;
      Array.prototype.forEach.call(typesWrap.querySelectorAll('.cp-type'), function(c){
        c.classList.toggle('is-picked', c === card);
      });
      var newType = card.dataset.type || 'Other';
      /* Re-picking the same card is NOT a content change — the key must
         survive it so an unchanged resubmission still dedupes upstream. */
      var changed = newType !== chosenType;
      chosenType = newType;
      needPhoto = card.dataset.photo === '1';
      needMsg = card.dataset.msg === '1';
      setBadge(photoReq, needPhoto);
      setBadge(msgReq, needMsg);
      if (changed){ selItems = []; contentChanged(); }
      updateChip();
      syncSubmit();
      /* Product-related types detour through the "which product?" picker. */
      if (card.dataset.pick === '1'){ openPicker(); } else { goStep(3); }
    });

    /* ---- "Which product?" picker. Line items come from <endpoint>/order-items
       (order number only, titles + quantities — nothing else). Prefetched right
       after the order verifies so the popup usually opens instantly. ANY
       trouble fetching (outage, not found, empty) skips the popup — it can
       never block a claim. Chosen titles ride the message as a bullet list. */
    var pickEl    = root.querySelector('.cp-pick');
    var pickTitle = root.querySelector('.cp-pick-title');
    var pickList  = root.querySelector('.cp-pick-list');
    var pickAll   = root.querySelector('.cp-pick-allcb');
    var pickOk    = root.querySelector('.cp-pick-ok');
    var pickNote  = root.querySelector('.cp-pick-note');
    var selItems = [];   /* [{title, qty}] — qty = how many of that product are affected */
    var itemsCache = null, itemsFor = '', itemsLoading = null;
    var PICK_TITLES = {
      'Damaged in transit': 'Which product is damaged?',
      'Wrong item': 'Which product arrived wrong?',
      'Missing item': 'Which product is missing?'
    };
    async function loadItems(orderNum){
      if (itemsFor === orderNum && itemsCache) return itemsCache;
      if (!endpoint) return null;
      var ctrl  = ('AbortController' in window) ? new AbortController() : null;
      var timer = ctrl && setTimeout(function(){ ctrl.abort(); }, 12000);
      try {
        var res = await fetch(endpoint + '/order-items', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ order_number: orderNum }),
          signal: ctrl ? ctrl.signal : undefined
        });
        var data = await res.json();
        if (res.ok && data && data.ok && data.found && Array.isArray(data.items) && data.items.length){
          itemsCache = data.items;
          itemsFor = orderNum;
          return itemsCache;
        }
        return null;
      } catch(e){ return null; }
      finally { if (timer) clearTimeout(timer); }
    }
    function prefetchItems(orderNum){
      itemsLoading = loadItems(orderNum);
      itemsLoading.catch(function(){});
    }
    function renderPickList(items){
      pickList.textContent = '';
      if (pickNote) pickNote.hidden = true;
      items.forEach(function(it){
        var row = document.createElement('label');
        row.className = 'cp-pick-row';
        var cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.value = it.title;
        var prev = selItems.find(function(s){ return s.title === it.title; });
        cb.checked = !!prev;
        row.appendChild(cb);
        row.appendChild(document.createTextNode(it.title));
        if (it.quantity > 1){
          /* multi-quantity item: "× N" hint when unchecked, an
             affected-quantity chooser when checked */
          var q = document.createElement('span');
          q.className = 'cp-pick-qty';
          q.textContent = '× ' + it.quantity;
          q.hidden = cb.checked;
          row.appendChild(q);
          var sel = document.createElement('select');
          sel.className = 'cp-pick-qtysel';
          sel.setAttribute('aria-label', 'How many affected');
          for (var n = 1; n <= Math.min(it.quantity, 30); n++){
            var o = document.createElement('option');
            o.value = String(n);
            o.textContent = n + ' of ' + it.quantity;
            sel.appendChild(o);
          }
          sel.value = String(prev && prev.qty ? Math.min(prev.qty, it.quantity) : 1);
          sel.hidden = !cb.checked;
          row.appendChild(sel);
          cb.addEventListener('change', (function(qEl, selEl, cbEl){ return function(){
            qEl.hidden = cbEl.checked;
            selEl.hidden = !cbEl.checked;
            syncPickAll();
            if (pickNote) pickNote.hidden = true;
          }; })(q, sel, cb));
        } else {
          cb.addEventListener('change', function(){
            syncPickAll();
            if (pickNote) pickNote.hidden = true;
          });
        }
        pickList.appendChild(row);
      });
      syncPickAll();
    }
    function pickBoxes(){ return Array.prototype.slice.call(pickList.querySelectorAll('input[type="checkbox"]')); }
    function syncPickAll(){
      var boxes = pickBoxes();
      if (pickAll) pickAll.checked = boxes.length > 0 && boxes.every(function(b){ return b.checked; });
    }
    if (pickAll) pickAll.addEventListener('change', function(){
      pickBoxes().forEach(function(b){
        b.checked = pickAll.checked;
        var row = b.closest('label');
        var q = row && row.querySelector('.cp-pick-qty');
        var sel = row && row.querySelector('.cp-pick-qtysel');
        if (q) q.hidden = pickAll.checked;
        if (sel) sel.hidden = !pickAll.checked;
      });
      if (pickNote) pickNote.hidden = true;
    });
    var pickGen = 0;   /* invalidates in-flight opens — a stale continuation must never touch a newer popup */
    async function openPicker(){
      if (!pickEl){ goStep(3); return; }
      var gen = ++pickGen;
      var orderNum = (orderIn.value || '').trim();
      pickTitle.textContent = PICK_TITLES[chosenType] || 'Which product?';
      pickList.innerHTML = '<div class="cp-pick-empty">Loading your order…</div>';
      if (pickAll) pickAll.checked = false;
      if (pickNote) pickNote.hidden = true;
      pickEl.hidden = false;
      var items = await (itemsLoading || loadItems(orderNum)) || await loadItems(orderNum);
      if (gen !== pickGen || !pickEl || pickEl.hidden) return;   /* superseded or skipped while loading */
      if (!items || !items.length){
        /* No list for THIS order — never keep an earlier order's selection. */
        if (selItems.length){ selItems = []; contentChanged(); updateChip(); }
        pickEl.hidden = true; goStep(3); return;
      }
      /* One product, one unit: nothing to choose — auto-select it. */
      if (items.length === 1 && (items[0].quantity || 1) === 1){
        var auto = [{ title: items[0].title, qty: 1 }];
        if (JSON.stringify(auto) !== JSON.stringify(selItems)) contentChanged();
        selItems = auto;
        pickEl.hidden = true;
        updateChip();
        goStep(3);
        return;
      }
      renderPickList(items);
    }
    if (pickOk) pickOk.addEventListener('click', function(){
      if (!pickEl) return;
      var next = pickBoxes().filter(function(b){ return b.checked; }).map(function(b){
        var row = b.closest('label');
        var sel = row && row.querySelector('.cp-pick-qtysel');
        return { title: b.value, qty: sel ? (parseInt(sel.value, 10) || 1) : 1 };
      });
      /* No Skip button any more: identifying the product is required. */
      if (!next.length){ if (pickNote) pickNote.hidden = false; return; }
      pickGen++;          /* any in-flight open is now stale */
      if (JSON.stringify(next) !== JSON.stringify(selItems)) contentChanged();
      selItems = next;
      pickEl.hidden = true;
      updateChip();
      goStep(3);
    });
    /* Backdrop click = cancel: close the popup and stay on the type step —
       nothing commits; re-picking a type reopens the list. */
    if (pickEl) pickEl.addEventListener('click', function(e){
      if (e.target === pickEl){ pickGen++; pickEl.hidden = true; }
    });

    function renderFiles(){
      if (!fileList) return;
      fileList.textContent = '';
      picked.forEach(function(f, i){
        var row = document.createElement('div');
        row.className = 'cp-file';
        var nm = document.createElement('span');
        nm.textContent = f.name + ' (' + (f.size / 1048576).toFixed(1) + ' MB)';
        var rm = document.createElement('button');
        rm.type = 'button';
        rm.setAttribute('aria-label', 'Remove ' + f.name);
        rm.textContent = '✕';
        rm.addEventListener('click', function(){ picked.splice(i, 1); renderFiles(); contentChanged(); });
        row.appendChild(nm);
        row.appendChild(rm);
        fileList.appendChild(row);
      });
      syncSubmit();
    }
    if (filesIn) filesIn.addEventListener('change', function(){
      status('');
      Array.prototype.forEach.call(filesIn.files, function(f){
        if (picked.length >= MAX_FILES){ status('You can attach up to ' + MAX_FILES + ' photos.'); return; }
        if (f.size > MAX_FILE_BYTES){ status('“' + f.name + '” is over 10 MB — please use a smaller photo.'); return; }
        if (totalPicked() + f.size > MAX_TOTAL_BYTES){ status('Photos can total 35 MB — “' + f.name + '” doesn’t fit. Remove one or use smaller photos.'); return; }
        var dup = picked.some(function(p){ return p.name === f.name && p.size === f.size; });
        if (!dup){ picked.push(f); contentChanged(); }
      });
      filesIn.value = '';
      renderFiles();
    });

    function setSending(on){
      sending = on;
      form.classList.toggle('is-sending', on);
      if (submitBtn){
        submitBtn.textContent = on ? 'Submitting…' : submitLabel;
        if (on) submitBtn.disabled = true; else syncSubmit();
      }
    }
    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if (sending) return;
      if (!endpoint){ claimCta('Claims aren’t set up yet.'); return; }
      var orderVal = (orderIn.value || '').trim();
      if (!orderVal){ goStep(1); status('Please enter your order number.'); return; }
      if (!chosenType){ goStep(2); status('Please pick what went wrong.'); return; }
      if (needPhoto && picked.length === 0){ status('Please attach at least one photo of the item — the team needs it to resolve this.'); return; }
      var msgVal = (msgIn ? msgIn.value : '').trim();
      if (needMsg && !msgVal){ status('Please tell us what happened.'); if (msgIn) msgIn.focus(); return; }
      if (totalPicked() > MAX_TOTAL_BYTES){ status('Photos can total 35 MB — please remove one or use smaller photos.'); return; }

      /* The picker's chosen products lead the message as a bullet list so
         the claim email names exactly which items are affected. */
      var msgOut = msgVal;
      if (selItems.length){
        var head = chosenType === 'Damaged in transit' ? 'Damaged product(s):'
          : chosenType === 'Wrong item' ? 'Wrong product(s) received:'
          : chosenType === 'Missing item' ? 'Missing product(s):' : 'Product(s):';
        msgOut = head + '\n' + selItems.map(function(s){ return '• ' + s.title + (s.qty > 1 ? ' × ' + s.qty : ''); }).join('\n') + (msgVal ? '\n\n' + msgVal : '');
      }
      var fd = new FormData();
      fd.set('order_id', orderVal);
      fd.set('type', chosenType);
      fd.set('message', msgOut);
      fd.set('page_url', String(location.href).slice(0, 500));
      fd.set('idempotencyKey', idemKey);
      picked.forEach(function(f){ fd.append('files', f, f.name); });

      setSending(true);
      status('Submitting your claim — this can take a few seconds…');
      var ctrl  = ('AbortController' in window) ? new AbortController() : null;
      var timer = ctrl && setTimeout(function(){ ctrl.abort(); }, 90000);
      try {
        var res = await fetch(endpoint + '/claim', { method: 'POST', body: fd, signal: ctrl ? ctrl.signal : undefined });
        var data = null;
        try { data = await res.json(); } catch(err){}
        if (res.ok && data && data.ok && data.reference){
          form.hidden = true;
          if (dots) dots.hidden = true;
          if (doneEl){
            doneEl.hidden = false;
            if (doneText) doneText.textContent = 'Your reference is ' + data.reference + '. Our reply goes to the email on your order.';
          }
          status('');
        } else {
          var raw = (data && data.error) ? String(data.error) : '';
          /* A not-yet-updated Worker routes /claim into its chat handler (raw
             errors) or still demands an email the form no longer has — both
             would confuse customers, so map them to a friendly line. */
          var stale = /invalid json|payload too large|empty message|worker secrets|origin not allowed|^too many requests$|email/i.test(raw);
          if (raw && !stale) status(raw);
          else claimCta('Claims aren’t available right now — please try again later.');
        }
      } catch(err){
        status('Something went wrong — please try again. Resubmitting is safe, it won’t create a duplicate.');
      } finally {
        if (timer) clearTimeout(timer);
        setSending(false);
      }
    });

    if (againBtn) againBtn.addEventListener('click', function(){
      form.reset();
      picked = [];
      selItems = [];
      chosenType = '';
      needPhoto = false;
      needMsg = false;
      renderFiles();
      setBadge(photoReq, false);
      setBadge(msgReq, false);
      if (pickedEl) pickedEl.textContent = '';
      if (typesWrap) Array.prototype.forEach.call(typesWrap.querySelectorAll('.cp-type'), function(c){ c.classList.remove('is-picked'); });
      idemKey = makeKey();
      form.hidden = false;
      if (dots) dots.hidden = false;
      if (doneEl) doneEl.hidden = true;
      syncNext();
      goStep(1);
    });

    /* Initial gate state (also covers browsers that restore form values on
       back-navigation, which the markup's static disabled can't know about). */
    syncNext();
    syncSubmit();
  }
  function boot(){
    Array.prototype.forEach.call(document.querySelectorAll('[data-sy-claim-root]'), init);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>

{% schema %}
{
  "name": "Claim Page",
  "tag": "section",
  "class": "section-claim-page",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open a claim" },
    { "type": "text", "id": "lede", "label": "Intro text", "default": "Something wrong with your order? Tell us and we’ll make it right." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit claim" },
    { "type": "header", "content": "Wiring" },
    { "type": "text", "id": "chat_endpoint", "label": "Worker endpoint (optional)", "info": "Leave blank to reuse the floating chat widget's endpoint." },
    { "type": "url", "id": "contact_url", "label": "Contact page (fallback)", "info": "Used by “Send us a message” when the floating widget isn't on the page." }
  ],
  "presets": [{ "name": "Claim Page" }]
}
{% endschema %}
