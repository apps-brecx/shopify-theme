  .sy-cpage .cp-drop{display:flex;align-items:center;justify-content:center;gap:8px;border:2px dashed var(--ink);border-radius:14px;background:#fff;color:var(--ink);font-weight:700;font-size:14px;padding:18px 12px;cursor:pointer;transition:background .12s}
