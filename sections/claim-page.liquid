  .sy-cpage .cp-picked:empty{display:none}
  .sy-cpage .cp-chip{background:var(--ink);color:var(--butter);border-radius:var(--r-pill);padding:7px 14px;font-family:var(--display);font-size:11.5px;letter-spacing:.05em;text-transform:uppercase}
  .sy-cpage .cp-chg{border:0;background:none;color:#8a7a68;font-family:var(--serif);font-size:12.5px;text-decoration:underline;cursor:pointer;padding:0}
