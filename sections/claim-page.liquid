  .sy-cpage .cp-filelist:empty{display:none}
  .sy-cpage .cp-file{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink);background:var(--shell);border:1.5px solid var(--ink);border-radius:10px;padding:6px 10px}
