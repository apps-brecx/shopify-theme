      {%- if s.banner_top_m != blank -%}<img class="m" src="{{ s.banner_top_m | image_url: width: 1200 }}" alt="{{ s.banner_top_alt | default: 'Syrup Pouches' | escape }}" loading="lazy">{%- endif -%}
      {%- if s.banner_top_link != blank -%}</a>{%- endif -%}
