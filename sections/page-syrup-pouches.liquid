{%- comment -%}
  Syrup Pouches — VIP launch page (Syruvia) · v4 "members first".
  Brand-true: cream bg, espresso type (Archivo Black display, Josefin Sans body),
  one orange accent, thin-rule cards with small offset shadows.
  v4 adds: hard VIP gate (visitors see only a banner + sign-in — no product content),
  stick-render hero ("The First Ever Syrup Pouches" flanked by floating pouches),
  "Flavor On The Go!" scroll-drift statement, pickable featured-product blocks,
  and an animated Syruvia Credits membership card (live vip.points metafield,
  count-up on scroll, hover tilt) pushing members to earn & redeem.
  Kept from v3: falling-pouch parallax, picture bands, about rows, flavor grid.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign rad = s.card_radius | default: 16 -%}
{%- assign ccbg = s.cc_bg | default: '#3c2415' -%}
{%- assign cl = collections[s.collection_handle] -%}

{%- assign allowed = false -%}
{%- case s.access_mode -%}
  {%- when 'everyone' -%}{%- assign allowed = true -%}
  {%- when 'vip_tag' -%}{%- if customer and customer.tags contains 'VIP' -%}{%- assign allowed = true -%}{%- endif -%}
  {%- else -%}{%- if customer -%}{%- assign allowed = true -%}{%- endif -%}
{%- endcase -%}

{%- assign logo_top = 'sp-logo-syrup.svg' | asset_url -%}
{%- assign logo_main = 'sp-logo-pouches.svg' | asset_url -%}
{%- if s.logo_top != blank -%}{%- assign logo_top = s.logo_top | image_url: width: 600 -%}{%- endif -%}
{%- if s.logo_main != blank -%}{%- assign logo_main = s.logo_main | image_url: width: 1000 -%}{%- endif -%}

{%- comment -%} Pouch stick renders — editor images override the uploaded defaults {%- endcomment -%}
{%- assign stick_defaults = 'https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download_f9ef59ce-471e-4ce8-a869-d172f6435a9c.webp?v=1784903214|https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download_f5cca5a9-bc12-4a90-a4d6-13a46d9b82f5.webp?v=1784903210|https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download_3b0e558e-fc82-425f-bb49-0f3fc1ca978d.webp?v=1784903209|https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download.webp?v=1784903207' | split: '|' -%}
{%- assign st1 = stick_defaults[0] -%}{%- if s.stick_1 != blank -%}{%- assign st1 = s.stick_1 | image_url: width: 480 -%}{%- endif -%}
{%- assign st2 = stick_defaults[1] -%}{%- if s.stick_2 != blank -%}{%- assign st2 = s.stick_2 | image_url: width: 480 -%}{%- endif -%}
{%- assign st3 = stick_defaults[2] -%}{%- if s.stick_3 != blank -%}{%- assign st3 = s.stick_3 | image_url: width: 480 -%}{%- endif -%}
{%- assign st4 = stick_defaults[3] -%}{%- if s.stick_4 != blank -%}{%- assign st4 = s.stick_4 | image_url: width: 480 -%}{%- endif -%}

{%- comment -%} Locked-view banner — editor images override the uploaded defaults {%- endcomment -%}
{%- assign lock_d = 'https://cdn.shopify.com/s/files/1/0861/1106/0252/files/Banner_3.png?v=1784903618' -%}
{%- assign lock_m = 'https://cdn.shopify.com/s/files/1/0861/1106/0252/files/Banner_3_Mobile.png?v=1784903619' -%}
{%- if s.lock_banner != blank -%}{%- assign lock_d = s.lock_banner | image_url: width: 2600 -%}{%- endif -%}
{%- if s.lock_banner_m != blank -%}{%- assign lock_m = s.lock_banner_m | image_url: width: 1400 -%}{%- endif -%}

{%- assign vip_pts = customer.metafields.vip.points.value | default: 0 -%}
{%- assign vip_life = customer.metafields.vip.lifetime.value | default: vip_pts -%}
{%- assign login_next = routes.account_login_url | append: '?return_url=' | append: request.path -%}
{%- assign register_next = routes.account_register_url | append: '?return_url=' | append: request.path -%}

{%- assign f1 = s.feat_prod_1 -%}
{%- assign f2 = s.feat_prod_2 -%}
{%- if f1 == blank and cl != blank and cl.products.size > 0 -%}{%- assign f1 = cl.products[0] -%}{%- endif -%}
{%- if f2 == blank and cl != blank and cl.products.size > 1 -%}{%- assign f2 = cl.products[1] -%}{%- endif -%}

{%- capture live_titles -%}{%- if cl != blank -%}{%- for p in cl.products limit: 50 -%}{{ p.title | downcase }}|{%- endfor -%}{%- endif -%}{%- endcapture -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Josefin+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&display=swap">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Josefin+Sans:wght@300;400;600;700&display=swap"></noscript>

<style>
  #sp-{{ section.id }}{
    --ink:{{ s.color_ink | default: '#1a1a1a' }};
    --brand:{{ s.color_brand | default: '#3c2415' }};
    --bg:{{ s.color_bg | default: '#FFFBF4' }};
    --paper:{{ s.color_paper | default: '#ffffff' }};
    --orange:{{ s.color_orange | default: '#e28f26' }};
    --pop:{{ s.color_pop | default: '#C8252B' }};
    --butter:{{ s.cc_gold | default: '#FCE2A0' }};
    --sf:#2F7DC4;
    --rule-c:{{ s.color_rule | default: '#3c2415' }};
    --wrap:{{ s.wrap_max | default: 1120 }}px;
    --rad:{{ rad }}px;
    --display:'Archivo Black','Josefin Sans',system-ui,sans-serif;
    --serif:'Josefin Sans',system-ui,sans-serif;
    --rule:1.5px solid var(--rule-c);
    background:var(--bg);color:var(--ink);font-family:var(--serif);position:relative;overflow-x:clip;font-size:16px;line-height:1.6;scroll-behavior:smooth;
  }
  #sp-{{ section.id }} *{box-sizing:border-box;}
  #sp-{{ section.id }} .sp-wrap{max-width:var(--wrap);margin:0 auto;padding:0 22px;}
  #sp-{{ section.id }} .sp-eyebrow{font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.18em;text-transform:uppercase;display:inline-block;padding:6px 14px;border:var(--rule);border-radius:999px;background:var(--paper);color:var(--brand);}
  #sp-{{ section.id }} .sp-h2{font-family:var(--display);font-weight:400;font-size:clamp(26px,5vw,44px);line-height:1;letter-spacing:-.005em;text-transform:uppercase;margin:14px 0 0;color:var(--brand);text-wrap:balance;}
  #sp-{{ section.id }} .sp-h2 em{font-family:var(--serif);font-weight:300;font-style:italic;text-transform:none;letter-spacing:0;color:var(--orange);}
  #sp-{{ section.id }} .sp-lead{font-size:clamp(15px,2vw,17.5px);color:var(--ink);opacity:.8;max-width:56ch;margin:14px auto 0;}
  #sp-{{ section.id }} .sp-rev{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .7s cubic-bezier(.2,.7,.2,1);}
  #sp-{{ section.id }} .sp-rev.in{opacity:1;transform:none;}
  #sp-{{ section.id }} .sp-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:var(--display);font-weight:400;font-size:13.5px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;padding:16px 30px;border:var(--rule);border-radius:999px;cursor:pointer;transition:transform .14s ease,box-shadow .14s ease,background .14s ease;background:var(--brand);color:var(--bg);box-shadow:3px 3px 0 rgba(60,36,21,.25);}
  #sp-{{ section.id }} .sp-btn--ghost{background:var(--paper);color:var(--brand);box-shadow:none;}
  #sp-{{ section.id }} .sp-btn--butter{background:var(--butter);color:var(--brand);box-shadow:3px 3px 0 rgba(0,0,0,.28);}
  @media(hover:hover){
    #sp-{{ section.id }} .sp-btn:hover{transform:translateY(-2px);box-shadow:4px 5px 0 rgba(60,36,21,.28);}
    #sp-{{ section.id }} .sp-btn--ghost:hover{background:#FFF3DC;}
  }
  #sp-{{ section.id }} .sp-btnrow{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
  @media(max-width:560px){#sp-{{ section.id }} .sp-btnrow .sp-btn{width:100%;}}
  #sp-{{ section.id }} .sp-sep{border:0;border-top:2px solid var(--rule-c);opacity:.14;margin:0;}
  #sp-{{ section.id }} .sp-section{padding:clamp(56px,8vw,96px) 0;}

  /* ===== LOCKED VIEW (not signed in) ===== */
  #sp-{{ section.id }} .sp-lock-bn{display:block;overflow:hidden;}
  #sp-{{ section.id }} .sp-lock-bn img{display:block;width:100%;height:auto;animation:spkb{{ section.id }} 12s ease-out both;}
  #sp-{{ section.id }} .sp-lock-bn .m{display:none;}
  @media(max-width:760px){
    #sp-{{ section.id }} .sp-lock-bn .d{display:none;}
    #sp-{{ section.id }} .sp-lock-bn .m{display:block;}
  }
  @keyframes spkb{{ section.id }}{from{transform:scale(1.045);}to{transform:scale(1);}}
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-lock-bn img{animation:none;}}
  #sp-{{ section.id }} .sp-lock-wrap{padding-bottom:clamp(48px,7vw,84px);}
  #sp-{{ section.id }} .sp-lock-card{position:relative;z-index:2;max-width:620px;margin:clamp(-38px,-5vw,-64px) auto 0;background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 8px);box-shadow:5px 5px 0 rgba(60,36,21,.16);padding:36px 28px 30px;text-align:center;}
  #sp-{{ section.id }} .sp-lock-card .lock{width:48px;height:48px;border-radius:50%;border:var(--rule);background:var(--bg);display:inline-flex;align-items:center;justify-content:center;}
  #sp-{{ section.id }} .sp-lock-card .lock svg{width:20px;height:20px;color:var(--brand);}
  #sp-{{ section.id }} .sp-lock-card h1{font-family:var(--display);font-weight:400;font-size:clamp(21px,4.6vw,29px);text-transform:uppercase;color:var(--brand);margin:14px 0 0;line-height:1.05;}
  #sp-{{ section.id }} .sp-lock-card p{font-size:14.5px;opacity:.8;margin:12px auto 0;max-width:46ch;}
  #sp-{{ section.id }} .sp-lock-card .sp-btnrow{margin-top:22px;}
  #sp-{{ section.id }} .sp-lock-card .mini{font-size:12.5px;opacity:.6;margin-top:16px;}
  #sp-{{ section.id }} .sp-lock-card .mini a{color:var(--brand);font-weight:700;}

  /* ===== SCENE: hero + statement + picks, with subtle falling pouches ===== */
  #sp-{{ section.id }} .sp-scene{position:relative;overflow:clip;}
  #sp-{{ section.id }} .sp-rain{position:absolute;inset:0;z-index:1;pointer-events:none;}
  #sp-{{ section.id }} .sp-rain-item{position:absolute;will-change:transform;filter:drop-shadow(0 10px 18px rgba(60,36,21,.16));}
  #sp-{{ section.id }} .sp-rain-item img{display:block;width:100%;height:auto;}
  #sp-{{ section.id }} .sp-rain-item.far{opacity:.5;filter:drop-shadow(0 6px 10px rgba(60,36,21,.10)) blur(1px);}
  @media(max-width:700px){#sp-{{ section.id }} .sp-rain-item.m-hide{display:none;}}
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-rain{display:none;}}
  #sp-{{ section.id }} .sp-scene > *:not(.sp-rain){position:relative;z-index:2;}

  /* HERO — headline flanked by floating sticks */
  #sp-{{ section.id }} .sp-hero{position:relative;min-height:92svh;display:flex;align-items:center;justify-content:center;padding:clamp(40px,7vw,72px) 0 clamp(64px,9vw,96px);text-align:center;background:linear-gradient(180deg,{{ s.hero_g1 | default: '#FFFBF4' }} 0%,{{ s.hero_g2 | default: '#FFF3DC' }} 100%);}
  #sp-{{ section.id }} .sp-hero .sp-wrap{position:relative;z-index:2;}
  #sp-{{ section.id }} .sp-viptag{display:inline-flex;align-items:center;gap:8px;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--brand);border:var(--rule);border-radius:999px;background:var(--paper);padding:8px 16px;}
  #sp-{{ section.id }} .sp-viptag .dot{width:7px;height:7px;border-radius:50%;background:var(--pop);}
  #sp-{{ section.id }} .sp-logo{margin:24px auto 0;max-width:min(380px,64vw);will-change:transform;transform-origin:center top;}
  #sp-{{ section.id }} .sp-logo .top{display:block;width:52%;margin:0 auto;}
  #sp-{{ section.id }} .sp-logo .main{display:block;width:100%;margin:6px auto 0;}
  #sp-{{ section.id }} .sp-logo img{width:100%;height:auto;display:block;}
  #sp-{{ section.id }} .sp-h1{font-family:var(--display);font-weight:400;font-size:clamp(32px,7vw,68px);line-height:.98;letter-spacing:-.005em;text-transform:uppercase;color:var(--brand);margin:22px auto 0;max-width:16ch;text-wrap:balance;}
  #sp-{{ section.id }} .sp-h1 em{font-family:var(--serif);font-weight:300;font-style:italic;text-transform:none;letter-spacing:0;color:var(--orange);}
  #sp-{{ section.id }} .sp-sub{font-size:clamp(16px,2.2vw,19px);margin:20px auto 0;max-width:46ch;color:var(--ink);opacity:.82;font-weight:300;}
  #sp-{{ section.id }} .sp-meta{font-family:var(--display);font-weight:400;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--brand);margin-top:18px;opacity:.75;}
  #sp-{{ section.id }} .sp-hero .sp-btnrow{margin-top:26px;}
  #sp-{{ section.id }} .sp-ptsline{display:inline-block;margin-top:18px;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--brand);text-decoration:none;background:var(--paper);border:var(--rule);border-radius:999px;padding:11px 18px;line-height:1.7;max-width:100%;box-shadow:2px 2px 0 rgba(60,36,21,.14);transition:transform .14s ease;}
  #sp-{{ section.id }} .sp-ptsline b{color:var(--orange);font-size:13px;}
  @media(hover:hover){#sp-{{ section.id }} .sp-ptsline:hover{transform:translateY(-2px);}}
  #sp-{{ section.id }} .sp-stick{position:absolute;z-index:1;pointer-events:none;will-change:transform;}
  #sp-{{ section.id }} .sp-stick .in{display:block;animation:spbob{{ section.id }} 5.6s ease-in-out infinite alternate;filter:drop-shadow(0 16px 24px rgba(60,36,21,.20));}
  #sp-{{ section.id }} .sp-stick img{width:100%;height:auto;display:block;}
  #sp-{{ section.id }} .sp-stick .in{animation:spfly{{ section.id }} .9s cubic-bezier(.2,.85,.3,1) both, spbob{{ section.id }} 5.6s ease-in-out 1.15s infinite alternate;}
  #sp-{{ section.id }} .sp-stick.s2 .in{animation-delay:.12s,1.3s;animation-duration:.9s,6.4s;}
  #sp-{{ section.id }} .sp-stick.s3 .in{animation-delay:.2s,1.4s;animation-duration:.9s,5s;}
  #sp-{{ section.id }} .sp-stick.s4 .in{animation-delay:.3s,1.5s;animation-duration:.9s,6.9s;}
  @keyframes spfly{{ section.id }}{from{opacity:0;transform:rotate(var(--r,0deg)) translateX(var(--fx,60px)) translateY(26px) scale(.78);}to{opacity:1;transform:rotate(var(--r,0deg)) translateX(0) translateY(0) scale(1);}}
  @keyframes spbob{{ section.id }}{from{transform:rotate(var(--r,0deg)) translateY(0);}to{transform:rotate(var(--r,0deg)) translateY(-13px);}}
  #sp-{{ section.id }} .sp-stick.s1{left:2%;top:13%;width:clamp(64px,12vw,168px);}
  #sp-{{ section.id }} .sp-stick.s2{left:6%;top:62%;width:clamp(54px,9vw,126px);}
  #sp-{{ section.id }} .sp-stick.s3{left:86%;top:11%;width:clamp(58px,11vw,150px);}
  #sp-{{ section.id }} .sp-stick.s4{left:81%;top:58%;width:clamp(68px,13vw,182px);}
  @media(max-width:700px){
    #sp-{{ section.id }} .sp-hero{padding-bottom:120px;}
    #sp-{{ section.id }} .sp-logo{max-width:56vw;}
    #sp-{{ section.id }} .sp-h1{font-size:clamp(29px,8vw,44px);}
    #sp-{{ section.id }} .sp-sub{font-size:15px;}
    #sp-{{ section.id }} .sp-hero .sp-btnrow{margin-top:22px;}
    #sp-{{ section.id }} .sp-stick.s1{left:-5%;top:3%;width:clamp(52px,15vw,76px);}
    #sp-{{ section.id }} .sp-stick.s3{left:auto;right:-5%;top:3%;width:clamp(50px,14vw,72px);}
    #sp-{{ section.id }} .sp-stick.s2,#sp-{{ section.id }} .sp-stick.s4{display:none;}
    #sp-{{ section.id }} .sp-stick.m-off{display:none;}
  }
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-stick .in{animation:none;}}
  #sp-{{ section.id }} .sp-cue{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:3;width:38px;height:38px;border-radius:50%;background:var(--paper);border:var(--rule);display:flex;align-items:center;justify-content:center;animation:spcue{{ section.id }} 2s ease-in-out infinite;}
  #sp-{{ section.id }} .sp-cue svg{width:15px;height:15px;color:var(--brand);}
  @keyframes spcue{{ section.id }}{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(7px)}}
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-cue{animation:none;}}
  #sp-{{ section.id }} .sp-unlocked{max-width:600px;margin:0 auto 8px;border:var(--rule);background:var(--paper);color:var(--brand);border-radius:999px;padding:12px 18px;text-align:center;font-family:var(--display);font-weight:400;font-size:12px;letter-spacing:.1em;text-transform:uppercase;}
  #sp-{{ section.id }} .sp-unlocked b{color:#2b6b53;}

  /* COUNTDOWN BAR — sticky launch timer */
  #sp-{{ section.id }} .sp-count{position:sticky;top:0;z-index:60;display:flex;align-items:center;justify-content:center;gap:8px 14px;flex-wrap:wrap;background:var(--brand);color:var(--bg);padding:10px 16px;border-bottom:var(--rule);text-align:center;}
  #sp-{{ section.id }} .sp-count .lb{font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.14em;text-transform:uppercase;}
  #sp-{{ section.id }} .sp-count .tm{font-family:var(--display);font-weight:400;font-size:17px;letter-spacing:.08em;color:var(--butter);font-variant-numeric:tabular-nums;}

  /* BANNER BUTTON */
  #sp-{{ section.id }} .sp-band-btn{text-align:center;padding:18px 22px 0;}

  /* INFO BOXES */
  #sp-{{ section.id }} .sp-boxes .grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:32px;}
  @media(min-width:760px){#sp-{{ section.id }} .sp-boxes .grid{grid-template-columns:repeat(3,1fr);}}
  #sp-{{ section.id }} .sp-box{background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 4px);box-shadow:3px 3px 0 rgba(60,36,21,.12);padding:28px 20px;text-align:center;}
  #sp-{{ section.id }} .sp-box .n{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--orange);color:#fff;border:var(--rule);font-family:var(--display);font-size:15px;margin-bottom:14px;}
  #sp-{{ section.id }} .sp-box h3{font-family:var(--display);font-weight:400;font-size:16px;text-transform:uppercase;color:var(--brand);margin:0;line-height:1.15;}
  #sp-{{ section.id }} .sp-box p{font-size:14.5px;opacity:.8;margin:10px 0 0;line-height:1.55;}

  /* STICK GALLERY — snap carousel */
  #sp-{{ section.id }} .sp-gal .rail{display:flex;gap:18px;overflow-x:auto;padding:14px 22px 20px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  #sp-{{ section.id }} .sp-gal .rail::-webkit-scrollbar{display:none;}
  #sp-{{ section.id }} .sp-gal .rail > :first-child{margin-left:auto;}
  #sp-{{ section.id }} .sp-gal .rail > :last-child{margin-right:auto;}
  #sp-{{ section.id }} .sp-gal .card{flex:0 0 auto;width:min(230px,60vw);scroll-snap-align:center;background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 4px);padding:20px 16px;box-shadow:3px 3px 0 rgba(60,36,21,.12);transform:rotate(-2.2deg);transition:transform .25s ease;}
  #sp-{{ section.id }} .sp-gal .card:nth-child(even){transform:rotate(2.2deg);}
  @media(hover:hover){#sp-{{ section.id }} .sp-gal .card:hover{transform:rotate(0deg) translateY(-6px);}}
  #sp-{{ section.id }} .sp-gal .card img{width:100%;height:auto;display:block;}
  #sp-{{ section.id }} .sp-gal .note{text-align:center;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--brand);opacity:.7;margin-top:12px;padding:0 22px;}

  /* LAUNCH RIBBON — scrolling marquee */
  #sp-{{ section.id }} .sp-mq{overflow:hidden;background:var(--orange);border-top:var(--rule);border-bottom:var(--rule);padding:11px 0;}
  #sp-{{ section.id }} .sp-mq .tr{display:flex;gap:40px;white-space:nowrap;width:max-content;animation:spmq{{ section.id }} 24s linear infinite;}
  #sp-{{ section.id }} .sp-mq span{font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;color:#fff;}
  @keyframes spmq{{ section.id }}{to{transform:translateX(-50%);}}
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-mq .tr{animation:none;}}

  /* SYRUP PROGRESS BAR — fills as you scroll the page */
  #sp-{{ section.id }} .sp-pourbar{position:fixed;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,var(--orange),#c9761a);z-index:2147482000;border-radius:0 999px 999px 0;pointer-events:none;}

  /* badge pulse + tile cascade */
  @media (prefers-reduced-motion: no-preference){
    #sp-{{ section.id }} .sp-badge:not(.sf){animation:sppulse{{ section.id }} 2.6s ease-in-out infinite;}
    @keyframes sppulse{{ section.id }}{0%,100%{transform:scale(1);}50%{transform:scale(1.07);}}
    #sp-{{ section.id }} .sp-grid .sp-tile:nth-child(6n+2){transition-delay:.05s;}
    #sp-{{ section.id }} .sp-grid .sp-tile:nth-child(6n+3){transition-delay:.1s;}
    #sp-{{ section.id }} .sp-grid .sp-tile:nth-child(6n+4){transition-delay:.15s;}
    #sp-{{ section.id }} .sp-grid .sp-tile:nth-child(6n+5){transition-delay:.2s;}
    #sp-{{ section.id }} .sp-grid .sp-tile:nth-child(6n){transition-delay:.25s;}
  }

  /* STATEMENT — Flavor On The Go! */
  #sp-{{ section.id }} .sp-say{padding:clamp(64px,10vw,120px) 0;text-align:center;overflow:clip;}
  #sp-{{ section.id }} .sp-say .l1,#sp-{{ section.id }} .sp-say .l2{display:block;font-family:var(--display);font-weight:400;text-transform:uppercase;line-height:.92;will-change:transform;}
  #sp-{{ section.id }} .sp-say .l1{font-size:clamp(52px,12vw,148px);color:var(--brand);}
  #sp-{{ section.id }} .sp-say .l2{font-size:clamp(40px,9.5vw,116px);color:transparent;-webkit-text-stroke:2.5px var(--orange);text-stroke:2.5px var(--orange);}
  @media(max-width:560px){#sp-{{ section.id }} .sp-say .l2{-webkit-text-stroke-width:1.8px;}}
  #sp-{{ section.id }} .sp-say .sub{font-size:clamp(15px,2.2vw,18px);opacity:.78;font-weight:300;max-width:52ch;margin:22px auto 0;}

  /* PICKS — featured pouch cards */
  #sp-{{ section.id }} .sp-live .sp-head{text-align:center;margin-bottom:34px;}
  #sp-{{ section.id }} .sp-duo{display:grid;grid-template-columns:1fr;gap:20px;max-width:860px;margin:0 auto;}
  @media(min-width:700px){#sp-{{ section.id }} .sp-duo{grid-template-columns:1fr 1fr;}}
  #sp-{{ section.id }} .sp-duo.wide{max-width:none;}
  @media(min-width:960px){#sp-{{ section.id }} .sp-duo.wide{grid-template-columns:repeat(3,1fr);}}
  #sp-{{ section.id }} .sp-feat{position:relative;display:flex;flex-direction:column;background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 4px);overflow:hidden;text-decoration:none;color:var(--ink);transition:transform .18s ease,box-shadow .18s ease;box-shadow:3px 3px 0 rgba(60,36,21,.12);}
  @media(hover:hover){#sp-{{ section.id }} a.sp-feat:hover{transform:translateY(-4px);box-shadow:5px 7px 0 rgba(60,36,21,.16);}}
  #sp-{{ section.id }} .sp-feat .ph{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;border-bottom:var(--rule);padding:22px;background:var(--bg);}
  #sp-{{ section.id }} .sp-feat .ph img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .3s ease;}
  @media(hover:hover){#sp-{{ section.id }} a.sp-feat:hover .ph img{transform:scale(1.05) rotate(-2deg);}}
  #sp-{{ section.id }} .sp-feat .b{padding:20px 18px 22px;text-align:center;display:flex;flex-direction:column;gap:8px;flex:1;}
  #sp-{{ section.id }} .sp-feat .t{font-family:var(--display);font-weight:400;font-size:16px;line-height:1.15;text-transform:uppercase;color:var(--brand);}
  #sp-{{ section.id }} .sp-feat .p{font-family:var(--display);font-weight:400;font-size:17px;color:var(--brand);}
  #sp-{{ section.id }} .sp-feat .cta{margin-top:auto;font-family:var(--display);font-weight:400;font-size:12px;letter-spacing:.12em;text-transform:uppercase;background:var(--brand);color:var(--bg);border-radius:999px;padding:13px 18px;}
  #sp-{{ section.id }} .sp-flag{position:absolute;top:12px;left:12px;z-index:2;font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:var(--pop);border-radius:999px;padding:6px 12px;}
  #sp-{{ section.id }} .sp-flag.sf{background:var(--sf);left:auto;right:12px;}

  /* CREDITS — membership card */
  #sp-{{ section.id }} .sp-cred .sp-head{text-align:center;margin-bottom:34px;}
  #sp-{{ section.id }} .sp-cred-card{position:relative;max-width:960px;margin:0 auto;color:#FFFBF4;background:radial-gradient(130% 160% at 88% -12%, {{ ccbg | color_lighten: 12 }}, {{ ccbg }} 55%, {{ ccbg | color_darken: 8 }});border:var(--rule);border-radius:calc(var(--rad) + 10px);box-shadow:6px 6px 0 rgba(60,36,21,.22);overflow:hidden;transition:transform .25s ease;will-change:transform;}
  #sp-{{ section.id }} .sp-cred-card .grain{position:absolute;inset:0;opacity:.35;mix-blend-mode:soft-light;background-image:radial-gradient(rgba(255,255,255,.5) 1px, transparent 1.4px);background-size:11px 11px;pointer-events:none;}
  #sp-{{ section.id }} .sp-cred-card .deco{position:absolute;right:-26px;bottom:-34px;width:clamp(110px,16vw,190px);transform:rotate(-14deg);opacity:.9;pointer-events:none;filter:drop-shadow(0 12px 20px rgba(0,0,0,.3));}
  @media(max-width:600px){#sp-{{ section.id }} .sp-cred-card .deco{width:92px;right:-20px;bottom:-24px;opacity:.5;}}
  #sp-{{ section.id }} .cc-grid{position:relative;display:grid;grid-template-columns:1fr;gap:26px;padding:clamp(26px,4.5vw,44px);}
  @media(min-width:780px){#sp-{{ section.id }} .cc-grid{grid-template-columns:1.05fr 1fr;gap:clamp(26px,4vw,52px);align-items:center;}}
  #sp-{{ section.id }} .cc-chip{display:inline-flex;align-items:center;gap:7px;font-family:var(--display);font-weight:400;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);background:var(--butter);border-radius:999px;padding:7px 14px;}
  #sp-{{ section.id }} .cc-num{font-family:var(--display);font-weight:400;font-size:clamp(56px,10vw,104px);line-height:1;color:var(--butter);margin-top:16px;letter-spacing:-.01em;font-variant-numeric:tabular-nums;}
  #sp-{{ section.id }} .cc-lbl{font-family:var(--display);font-weight:400;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#FFFBF4;opacity:.9;margin-top:8px;}
  #sp-{{ section.id }} .cc-life{font-size:13px;opacity:.65;margin-top:10px;}
  #sp-{{ section.id }} .cc-join{font-size:14.5px;opacity:.85;margin-top:14px;max-width:38ch;}
  #sp-{{ section.id }} .cc-earn-h{font-family:var(--display);font-weight:400;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--butter);}
  #sp-{{ section.id }} .cc-earn{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:10px;}
  #sp-{{ section.id }} .cc-earn li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;line-height:1.45;opacity:.94;}
  #sp-{{ section.id }} .cc-earn .pl{flex:0 0 auto;width:20px;height:20px;margin-top:1px;border-radius:50%;background:rgba(255,255,255,.14);border:1.5px solid rgba(255,255,255,.55);display:inline-flex;align-items:center;justify-content:center;font-family:var(--display);font-size:11px;color:var(--butter);}
  #sp-{{ section.id }} .cc-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px;}
  #sp-{{ section.id }} .cc-btns .sp-btn{box-shadow:3px 3px 0 rgba(0,0,0,.3);}
  #sp-{{ section.id }} .cc-btns .sp-btn--line{background:transparent;color:#FFFBF4;border-color:rgba(255,255,255,.6);box-shadow:none;}
  @media(hover:hover){#sp-{{ section.id }} .cc-btns .sp-btn--line:hover{background:rgba(255,255,255,.1);}}
  @media(max-width:560px){#sp-{{ section.id }} .cc-btns .sp-btn{width:100%;}}

  /* PICTURE BANDS */
  #sp-{{ section.id }} .sp-band a{display:block;line-height:0;}
  #sp-{{ section.id }} .sp-band img{display:block;width:100%;height:auto;}
  #sp-{{ section.id }} .sp-band .m{display:none;}
  @media(max-width:760px){
    #sp-{{ section.id }} .sp-band .has-m.d{display:none;}
    #sp-{{ section.id }} .sp-band .m{display:block;}
  }

  /* ABOUT rows — editorial */
  #sp-{{ section.id }} .sp-about .sp-row{display:grid;grid-template-columns:1fr;gap:22px;align-items:center;margin-bottom:clamp(40px,6vw,64px);}
  #sp-{{ section.id }} .sp-about .sp-row:last-child{margin-bottom:0;}
  #sp-{{ section.id }} .sp-about img{width:100%;height:auto;display:block;border:var(--rule);border-radius:calc(var(--rad) + 4px);}
  #sp-{{ section.id }} .sp-about .txt h3{font-family:var(--display);font-weight:400;font-size:clamp(22px,3.6vw,32px);text-transform:uppercase;color:var(--brand);margin:0;line-height:1.02;}
  #sp-{{ section.id }} .sp-about .txt h3 em{font-family:var(--serif);font-weight:300;font-style:italic;text-transform:none;color:var(--orange);}
  #sp-{{ section.id }} .sp-about .txt p{font-size:15.5px;opacity:.8;margin:12px 0 0;max-width:52ch;}
  @media(min-width:820px){
    #sp-{{ section.id }} .sp-about .sp-row{grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);}
    #sp-{{ section.id }} .sp-about .sp-row.flip .media{order:2;}
  }

  /* GRID */
  #sp-{{ section.id }} .sp-shop{scroll-margin-top:80px;}
  #sp-{{ section.id }} .sp-head{text-align:center;}
  #sp-{{ section.id }} .sp-search{max-width:420px;margin:24px auto 0;position:relative;}
  #sp-{{ section.id }} .sp-search svg{position:absolute;left:17px;top:50%;transform:translateY(-50%);width:17px;height:17px;color:var(--brand);opacity:.55;pointer-events:none;}
  #sp-{{ section.id }} .sp-search input{width:100%;font-family:var(--serif);font-size:15px;padding:13px 20px 13px 45px;border:var(--rule);border-radius:999px;background:var(--paper);color:var(--ink);outline:none;transition:box-shadow .15s ease;-webkit-appearance:none;}
  #sp-{{ section.id }} .sp-search input:focus{box-shadow:2px 2px 0 rgba(60,36,21,.16);}
  #sp-{{ section.id }} .sp-search input::placeholder{color:var(--ink);opacity:.45;}
  #sp-{{ section.id }} .sp-noresults{display:none;text-align:center;border:1.5px dashed var(--rule-c);border-radius:var(--rad);padding:26px 18px;background:var(--paper);opacity:.8;margin-top:4px;}
  #sp-{{ section.id }} .sp-tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:18px 0 26px;}
  #sp-{{ section.id }} .sp-tab{font-family:var(--display);font-weight:400;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;border:var(--rule);border-radius:999px;padding:10px 20px;background:var(--paper);color:var(--brand);cursor:pointer;transition:background .15s ease,color .15s ease;}
  #sp-{{ section.id }} .sp-tab.on{background:var(--brand);color:var(--bg);}
  #sp-{{ section.id }} .sp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
  @media(min-width:640px){#sp-{{ section.id }} .sp-grid{grid-template-columns:repeat(3,1fr);}}
  @media(min-width:960px){#sp-{{ section.id }} .sp-grid{grid-template-columns:repeat(4,1fr);}}
  #sp-{{ section.id }} .sp-tile{position:relative;display:flex;flex-direction:column;background:var(--paper);border:var(--rule);border-radius:var(--rad);overflow:hidden;text-decoration:none;color:var(--ink);transition:transform .16s ease,box-shadow .16s ease;}
  @media(hover:hover){#sp-{{ section.id }} a.sp-tile:hover{transform:translateY(-3px);box-shadow:3px 5px 0 rgba(60,36,21,.14);}}
  #sp-{{ section.id }} .sp-tile .ph{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;border-bottom:var(--rule);background:var(--bg);padding:14px;}
  #sp-{{ section.id }} .sp-tile .ph img{max-width:100%;max-height:100%;object-fit:contain;}
  #sp-{{ section.id }} .sp-tile .b{padding:14px 12px 16px;text-align:center;display:flex;flex-direction:column;gap:6px;flex:1;}
  #sp-{{ section.id }} .sp-tile .t{font-family:var(--display);font-weight:400;font-size:12.5px;line-height:1.2;text-transform:uppercase;letter-spacing:.02em;color:var(--brand);}
  #sp-{{ section.id }} .sp-tile .p{margin-top:auto;font-family:var(--display);font-weight:400;font-size:14.5px;color:var(--brand);}
  #sp-{{ section.id }} .sp-deal{display:inline-flex;align-items:center;gap:5px;font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.08em;text-transform:uppercase;background:var(--orange);color:#fff;border-radius:999px;padding:5px 11px;line-height:1.3;}
  #sp-{{ section.id }} .sp-tile .sp-deal{margin:2px auto 0;}
  #sp-{{ section.id }} .sp-feat .sp-deal{margin:0 auto;}
  #sp-{{ section.id }} .sp-badge{position:absolute;top:10px;left:10px;z-index:2;font-family:var(--display);font-weight:400;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--pop);border-radius:999px;padding:5px 10px;}
  #sp-{{ section.id }} .sp-badge.sf{background:var(--sf);left:auto;right:10px;}
  /* coming soon — photo shown but visibly muted (tint overlay + soft grayscale) */
  #sp-{{ section.id }} .sp-tile.soon .ph{background:#FFF3DC;position:relative;}
  #sp-{{ section.id }} .sp-tile.soon .ph img{filter:grayscale(.55) contrast(.94);opacity:.6;}
  #sp-{{ section.id }} .sp-tile.soon .ph::after{content:'';position:absolute;inset:0;background:{{ s.soon_tint | default: '#FFF3DC' }};opacity:.35;pointer-events:none;}
  #sp-{{ section.id }} .sp-tile.soon .b{background:{{ s.soon_tint | default: '#FFF3DC' }};}
  #sp-{{ section.id }} .sp-tile.soon .b .t{opacity:.75;}
  #sp-{{ section.id }} .sp-tile.soon .ph .fl{font-family:var(--display);font-weight:400;font-size:clamp(14px,3vw,17px);line-height:1.15;text-transform:uppercase;color:var(--brand);text-align:center;padding:0 12px;opacity:.85;}
  #sp-{{ section.id }} .sp-soonov{position:absolute;top:10px;left:10px;z-index:3;}
  #sp-{{ section.id }} .sp-soonov .cs{font-family:var(--display);font-weight:400;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--brand);background:var(--paper);border:var(--rule);border-radius:999px;padding:5px 10px;}
  #sp-{{ section.id }} .sp-tile.soon .b .dt{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-family:var(--display);color:var(--orange);}
  #sp-{{ section.id }} .sp-empty{text-align:center;border:1.5px dashed var(--rule-c);border-radius:var(--rad);padding:30px 18px;background:var(--paper);opacity:.85;}
  #sp-{{ section.id }} .sp-note{text-align:center;font-size:13px;opacity:.65;margin-top:22px;}

  /* mobile — collection-style list rows for the lineup */
  @media(max-width:640px){
    #sp-{{ section.id }} .sp-grid{grid-template-columns:1fr;gap:12px;}
    #sp-{{ section.id }} .sp-tile{flex-direction:row;align-items:stretch;border-radius:calc(var(--rad) + 2px);}
    #sp-{{ section.id }} .sp-tile .ph{width:118px;min-width:118px;aspect-ratio:1/1;border-bottom:none;border-right:var(--rule);padding:10px;}
    #sp-{{ section.id }} .sp-tile .b{flex:1;justify-content:center;align-items:center;padding:14px 12px;gap:7px;}
    #sp-{{ section.id }} .sp-tile .t{font-size:14.5px;}
    #sp-{{ section.id }} .sp-tile .p{margin-top:0;font-size:15.5px;}
    #sp-{{ section.id }} .sp-tile.soon .b .dt{margin-top:0;}
    #sp-{{ section.id }} .sp-tile.soon .ph .fl{font-size:12.5px;}
    #sp-{{ section.id }} .sp-badge{top:8px;left:8px;}
    #sp-{{ section.id }} .sp-badge.sf{left:auto;right:8px;}
    #sp-{{ section.id }} .sp-soonov{top:8px;left:8px;}
  }

  /* mobile — center everything */
  @media(max-width:760px){
    #sp-{{ section.id }} .sp-about .txt{text-align:center;}
    #sp-{{ section.id }} .sp-about .txt p{margin-left:auto;margin-right:auto;}
    #sp-{{ section.id }} .cc-left{text-align:center;}
    #sp-{{ section.id }} .cc-earn-h{text-align:center;}
    #sp-{{ section.id }} .cc-earn{max-width:340px;margin-left:auto;margin-right:auto;}
    #sp-{{ section.id }} .cc-btns{justify-content:center;}
    #sp-{{ section.id }} .cc-join{margin-left:auto;margin-right:auto;}
    #sp-{{ section.id }} .sp-lead,#sp-{{ section.id }} .sp-note{margin-left:auto;margin-right:auto;}
  }

  @media (prefers-reduced-motion: reduce){
    #sp-{{ section.id }} .sp-rev{opacity:1;transform:none;}
  }
</style>

<section id="sp-{{ section.id }}">
{%- if allowed -%}

  {%- if s.show_progress -%}<div class="sp-pourbar" data-pour-bar aria-hidden="true"></div>{%- endif -%}

  {%- if s.count_enable and s.count_start != blank -%}
  <div class="sp-count" data-count-bar data-start="{{ s.count_start | strip }}" data-tz="{{ s.count_tz | default: '-04:00' }}" data-hours="{{ s.count_hours | default: 72 }}">
    <span class="lb">{{ s.count_label | default: 'Launch deal ends in' }}</span>
    <span class="tm" data-count-time>--:--:--</span>
  </div>
  {%- endif -%}

  <div class="sp-scene" data-scene>
    {%- if s.show_rain -%}
    <div class="sp-rain" aria-hidden="true" data-rain>
      {%- assign rain_slots = 'rain_1,rain_2,rain_3,rain_4,rain_5,rain_6,rain_7,rain_8' | split: ',' -%}
      {%- assign cfg_left = '5,80,14,68,89,28,55,9' | split: ',' -%}
      {%- assign cfg_size = '110,130,88,150,96,120,84,115' | split: ',' -%}
      {%- assign cfg_speed = '0.26,0.18,0.34,0.14,0.30,0.22,0.38,0.16' | split: ',' -%}
      {%- assign cfg_rot = '-8,6,-4,9,-11,5,7,-6' | split: ',' -%}
      {%- assign cfg_top = '44,52,60,48,74,56,66,84' | split: ',' -%}
      {%- assign cfg_far = ',,far,,far,,far,' | split: ',' -%}
      {%- assign rain_any = false -%}
      {%- for slot in rain_slots -%}
        {%- assign img = s[slot] -%}
        {%- if img != blank -%}{%- assign rain_any = true -%}
          {%- assign i = forloop.index0 -%}
          <div class="sp-rain-item {{ cfg_far[i] }}{% if i > 2 %} m-hide{% endif %}" data-speed="{{ cfg_speed[i] }}" data-rot="{{ cfg_rot[i] }}" style="left:{{ cfg_left[i] }}%;top:{{ cfg_top[i] }}%;width:clamp(60px,{{ cfg_size[i] | divided_by: 12 }}vw,{{ cfg_size[i] }}px);transform:rotate({{ cfg_rot[i] }}deg);">
            <img src="{{ img | image_url: width: 400 }}" alt="" loading="lazy">
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- unless rain_any -%}
        {%- for i in (0..7) -%}
          {%- assign m4 = i | modulo: 4 -%}
          <div class="sp-rain-item {{ cfg_far[i] }}{% if i > 2 %} m-hide{% endif %}" data-speed="{{ cfg_speed[i] }}" data-rot="{{ cfg_rot[i] }}" style="left:{{ cfg_left[i] }}%;top:{{ cfg_top[i] }}%;width:clamp(52px,{{ cfg_size[i] | divided_by: 14 }}vw,{{ cfg_size[i] | times: 0.8 | round }}px);transform:rotate({{ cfg_rot[i] }}deg);">
            <img src="{{ stick_defaults[m4] }}" alt="" loading="lazy">
          </div>
        {%- endfor -%}
      {%- endunless -%}
    </div>
    {%- endif -%}

    {%- comment -%} ===== HERO ===== {%- endcomment -%}
    <div class="sp-hero">
      {%- if s.show_sticks -%}
      {%- assign moff = '' -%}{%- unless s.sticks_mobile -%}{%- assign moff = ' m-off' -%}{%- endunless -%}
      <div class="sp-stick s1{{ moff }}" data-pspeed="0.16" data-pour="1" aria-hidden="true"><span class="in" style="--r:-10deg;--fx:-72px;"><img src="{{ st1 }}" alt="" loading="eager"></span></div>
      <div class="sp-stick s2{{ moff }}" data-pspeed="0.30" data-pour="1" aria-hidden="true"><span class="in" style="--r:8deg;--fx:-72px;"><img src="{{ st2 }}" alt="" loading="eager"></span></div>
      <div class="sp-stick s3{{ moff }}" data-pspeed="0.22" data-pour="-1" aria-hidden="true"><span class="in" style="--r:10deg;--fx:72px;"><img src="{{ st3 }}" alt="" loading="eager"></span></div>
      <div class="sp-stick s4{{ moff }}" data-pspeed="0.12" data-pour="-1" aria-hidden="true"><span class="in" style="--r:-7deg;--fx:72px;"><img src="{{ st4 }}" alt="" loading="eager"></span></div>
      {%- endif -%}
      <div class="sp-wrap">
        {%- if s.vip_badge != blank -%}<span class="sp-viptag sp-rev"><span class="dot"></span>{{ s.vip_badge }}</span>{%- endif -%}
        <div class="sp-logo sp-rev" data-hero-logo>
          <span class="top"><img src="{{ logo_top }}" alt="Syrup" loading="eager"></span>
          <span class="main"><img src="{{ logo_main }}" alt="Pouches" loading="eager"></span>
        </div>
        <h1 class="sp-h1 sp-rev">{{ s.hero_title | default: 'The First Ever <em>Syrup Pouches</em>' }}</h1>
        {%- if s.hero_sub != blank -%}<p class="sp-sub sp-rev">{{ s.hero_sub }}</p>{%- endif -%}
        <p class="sp-meta sp-rev">{{ s.chip1 | default: 'Regular' }} &middot; {{ s.chip2 | default: 'Sugar-Free' }} &middot; {{ s.chip3 | default: '50 flavors' }}</p>
        <div class="sp-btnrow sp-rev">
          <a class="sp-btn" href="{% if s.show_grid %}#sp-shop-{{ section.id }}{% else %}#sp-live-{{ section.id }}{% endif %}">{{ s.shop_btn | default: 'Shop now' }}</a>
          {%- if s.collection_btn_url != blank -%}<a class="sp-btn sp-btn--ghost" href="{{ s.collection_btn_url }}">{{ s.collection_btn_text | default: 'View the collection' }}</a>{%- endif -%}
        </div>
        {%- if customer and s.show_credits -%}
        {%- capture pts_b -%}<b>{{ vip_pts }}</b>{%- endcapture -%}
        {%- assign teaser = s.pts_teaser | default: 'You’ve got [points] credits — see what they do' -%}
        <div class="sp-rev"><a class="sp-ptsline" href="#sp-cred-{{ section.id }}">&#9733; {{ teaser | replace: '[points]', pts_b }}</a></div>
        {%- endif -%}
      </div>
      <a class="sp-cue" href="#sp-say-{{ section.id }}" aria-label="Scroll down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 l6 6 6-6"/></svg></a>
