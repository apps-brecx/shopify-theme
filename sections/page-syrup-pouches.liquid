    {%- capture picks_html -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'product' -%}{%- continue -%}{%- endif -%}
        {%- assign fp = block.settings.product -%}
        {%- if fp == blank -%}{%- continue -%}{%- endif -%}
        {%- assign picks_count = picks_count | plus: 1 -%}
        {%- assign tdl = fp.title | downcase -%}
        {%- assign issf = false -%}{%- if tdl contains 'sugar free' or tdl contains 'sugar-free' -%}{%- assign issf = true -%}{%- endif -%}
        <a class="sp-feat sp-rev" href="{{ fp.url }}" {{ block.shopify_attributes }}>
          <span class="sp-flag">{{ block.settings.badge | default: s.live_badge | default: 'Live now' }}</span>
          {%- if issf -%}<span class="sp-flag sf">{{ s.sf_badge | default: '0g sugar' }}</span>{%- endif -%}
          <span class="ph">{%- if fp.featured_image -%}<img src="{{ fp.featured_image | image_url: width: 720 }}" alt="{{ fp.title | escape }}" loading="lazy">{%- endif -%}</span>
          <span class="b">
            <span class="t">{{ fp.title | replace: '(USA)', '' | strip }}</span>
            <span class="p">{{ fp.price | money }}</span>
            {%- if s.show_deal and s.deal_text != blank -%}<span class="sp-deal">{{ s.deal_text }}</span>{%- endif -%}
            <span class="cta">{{ s.feat_cta | default: 'Shop now' }} &rarr;</span>
          </span>
        </a>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if picks_count == 0 -%}
      {%- capture picks_html -%}
        {%- for fi in (1..2) -%}
          {%- if fi == 1 -%}{%- assign fp = f1 -%}{%- else -%}{%- assign fp = f2 -%}{%- endif -%}
          {%- if fp == blank -%}{%- continue -%}{%- endif -%}
          {%- assign picks_count = picks_count | plus: 1 -%}
          {%- assign tdl = fp.title | downcase -%}
          {%- assign issf = false -%}{%- if tdl contains 'sugar free' or tdl contains 'sugar-free' -%}{%- assign issf = true -%}{%- endif -%}
          <a class="sp-feat sp-rev" href="{{ fp.url }}">
            <span class="sp-flag">{{ s.live_badge | default: 'Live now' }}</span>
            {%- if issf -%}<span class="sp-flag sf">{{ s.sf_badge | default: '0g sugar' }}</span>{%- endif -%}
            <span class="ph">{%- if fp.featured_image -%}<img src="{{ fp.featured_image | image_url: width: 720 }}" alt="{{ fp.title | escape }}" loading="lazy">{%- endif -%}</span>
            <span class="b">
              <span class="t">{{ fp.title | replace: '(USA)', '' | strip }}</span>
              <span class="p">{{ fp.price | money }}</span>
              {%- if s.show_deal and s.deal_text != blank -%}<span class="sp-deal">{{ s.deal_text }}</span>{%- endif -%}
              <span class="cta">{{ s.feat_cta | default: 'Shop now' }} &rarr;</span>
            </span>
          </a>
        {%- endfor -%}
      {%- endcapture -%}
    {%- endif -%}
    {%- if picks_count > 0 -%}
    <div class="sp-live sp-section" id="sp-live-{{ section.id }}">
      <div class="sp-wrap">
        <div class="sp-head sp-rev">
          {%- if s.feat_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.feat_eyebrow }}</span>{%- endif -%}
          <h2 class="sp-h2">{{ s.feat_title | default: 'Shop <em>Pouches</em>' }}</h2>
        </div>
        <div class="sp-duo{% if picks_count > 2 %} wide{% endif %}">{{ picks_html }}</div>
        {%- if s.feat_seeall != blank -%}
        <div class="sp-btnrow sp-rev" style="margin-top:30px;">
          <a class="sp-btn sp-btn--ghost" href="{{ s.feat_seeall_url | default: '/collections/syrup-pouches' }}">{{ s.feat_seeall }} &rarr;</a>
        </div>
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}
    {%- endif -%}
  </div>{%- comment -%} /sp-scene {%- endcomment -%}

  {%- comment -%} ===== INFO BOXES ===== {%- endcomment -%}
  {%- assign box_count = 0 -%}
  {%- capture boxes_html -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'box' -%}{%- continue -%}{%- endif -%}
      {%- assign box_count = box_count | plus: 1 -%}
      <div class="sp-box sp-rev" {{ block.shopify_attributes }}>
        <span class="n">{{ box_count }}</span>
        {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if box_count > 0 -%}
  <hr class="sp-sep">
  <div class="sp-boxes sp-section">
    <div class="sp-wrap">
      <div class="sp-head sp-rev">
        {%- if s.boxes_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.boxes_eyebrow }}</span>{%- endif -%}
        <h2 class="sp-h2">{{ s.boxes_title | default: 'Little pouch. <em>Big flavor.</em>' }}</h2>
      </div>
      <div class="grid">{{ boxes_html }}</div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== STICK GALLERY ===== {%- endcomment -%}
  {%- if s.show_gallery -%}
  <hr class="sp-sep">
  <div class="sp-gal sp-section">
    <div class="sp-head sp-rev" style="padding:0 22px;">
      {%- if s.gallery_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.gallery_eyebrow }}</span>{%- endif -%}
      <h2 class="sp-h2">{{ s.gallery_title | default: 'This is the stick' }}</h2>
      {%- if s.gallery_sub != blank -%}<p class="sp-lead">{{ s.gallery_sub }}</p>{%- endif -%}
    </div>
    <div class="rail sp-rev" style="margin-top:26px;">
      {%- assign gal_any = false -%}
      {%- assign gal_slots = 'gal_1,gal_2,gal_3,gal_4,gal_5,gal_6' | split: ',' -%}
      {%- for slot in gal_slots -%}
        {%- assign gimg = s[slot] -%}
        {%- if gimg != blank -%}{%- assign gal_any = true -%}
        <div class="card"><img src="{{ gimg | image_url: width: 600 }}" alt="Syrup Pouch stick" loading="lazy"></div>
        {%- endif -%}
      {%- endfor -%}
      {%- unless gal_any -%}
        {%- for i in (0..3) -%}
        <div class="card"><img src="{{ stick_defaults[i] }}" alt="Syrup Pouch stick" loading="lazy"></div>
        {%- endfor -%}
      {%- endunless -%}
    </div>
    {%- if s.gallery_note != blank -%}<p class="note">{{ s.gallery_note }}</p>{%- endif -%}
  </div>
  {%- endif -%}

  {%- comment -%} ===== MORE FLAVORS COMING SOON ===== {%- endcomment -%}
  {%- if s.soon_title != blank -%}
  <hr class="sp-sep">
  <div class="sp-section">
    <div class="sp-wrap sp-head sp-rev">
      {%- if s.soon_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.soon_eyebrow }}</span>{%- endif -%}
      <h2 class="sp-h2">{{ s.soon_title }}</h2>
      {%- if s.soon_sub != blank -%}<p class="sp-lead">{{ s.soon_sub }}</p>{%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== VIP CREDITS ===== {%- endcomment -%}
  {%- if s.show_credits -%}
  <hr class="sp-sep">
  <div class="sp-cred sp-section" id="sp-cred-{{ section.id }}">
    <div class="sp-wrap">
      <div class="sp-head sp-rev">
        {%- if s.credits_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.credits_eyebrow }}</span>{%- endif -%}
        <h2 class="sp-h2">{{ s.credits_title | default: 'Your <em>Syruvia Credits</em>' }}</h2>
      </div>
      <div class="sp-cred-card sp-rev" data-tilt>
        <span class="grain" aria-hidden="true"></span>
        <img class="deco" src="{{ st4 }}" alt="" loading="lazy" aria-hidden="true">
        <div class="cc-grid">
          <div class="cc-left">
            <span class="cc-chip">&#9733; {{ s.cc_member_label | default: 'VIP member' }}{% if customer.first_name != blank %} &middot; {{ customer.first_name }}{% endif %}</span>
            {%- if customer -%}
              <div class="cc-num" data-count="{{ vip_pts }}">0</div>
              <div class="cc-lbl">{{ s.credits_unit | default: 'Syruvia Credits' }}</div>
              <div class="cc-life">{{ s.credits_lifetime_label | default: 'Earned all-time:' }} {{ vip_life }}</div>
            {%- else -%}
              <div class="cc-num">&#9733;</div>
              <p class="cc-join">{{ s.credits_join_text | default: 'Create a free account and start earning credits on every single order.' }}</p>
            {%- endif -%}
          </div>
          <div class="cc-right">
            <div class="cc-earn-h">{{ s.earn_title | default: 'Get more credits' }}</div>
            <ul class="cc-earn">
              {%- if s.earn1 != blank -%}<li><span class="pl">+</span>{{ s.earn1 }}</li>{%- endif -%}
              {%- if s.earn2 != blank -%}<li><span class="pl">+</span>{{ s.earn2 }}</li>{%- endif -%}
              {%- if s.earn3 != blank -%}<li><span class="pl">+</span>{{ s.earn3 }}</li>{%- endif -%}
              {%- if s.earn4 != blank -%}<li><span class="pl">+</span>{{ s.earn4 }}</li>{%- endif -%}
            </ul>
            <div class="cc-btns">
              {%- if customer -%}
                <a class="sp-btn sp-btn--butter" href="{{ s.rewards_link | default: '/apps/vip/rewards' }}">{{ s.rewards_btn | default: 'Earn & redeem' }}</a>
              {%- else -%}
                <a class="sp-btn sp-btn--butter" href="{{ register_next }}">{{ s.gate_join | default: 'Join VIP — it’s free' }}</a>
              {%- endif -%}
              <a class="sp-btn sp-btn--line" href="#sp-shop-{{ section.id }}">{{ s.credits_btn2 | default: 'Spend them on pouches' }}</a>
            </div>
          </div>
        </div>
      </div>
      {%- if s.credits_note != blank -%}<p class="sp-note">{{ s.credits_note }}</p>{%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== PICTURE 1 ===== {%- endcomment -%}
  {%- if s.band1_img != blank -%}
  <div class="sp-band">
    <img class="d {% if s.band1_img_m != blank %}has-m{% endif %}" src="{{ s.band1_img | image_url: width: 2400 }}" alt="{{ s.band1_alt | default: 'Syrup Pouches' | escape }}" loading="lazy">
    {%- if s.band1_img_m != blank -%}<img class="m" src="{{ s.band1_img_m | image_url: width: 1200 }}" alt="{{ s.band1_alt | default: 'Syrup Pouches' | escape }}" loading="lazy">{%- endif -%}
  </div>
  {%- endif -%}

  {%- comment -%} ===== ABOUT ===== {%- endcomment -%}
  {%- if s.show_about -%}
  <hr class="sp-sep">
  <div class="sp-about sp-section">
    <div class="sp-wrap">
      {%- if s.row1_img != blank or s.row1_title != blank -%}
      <div class="sp-row sp-rev">
        <div class="media">{%- if s.row1_img != blank -%}<img src="{{ s.row1_img | image_url: width: 1200 }}" alt="{{ s.row1_title | escape }}" loading="lazy">{%- endif -%}</div>
        <div class="txt">{%- if s.row1_title != blank -%}<h3>{{ s.row1_title }}</h3>{%- endif -%}{%- if s.row1_text != blank -%}<p>{{ s.row1_text }}</p>{%- endif -%}</div>
      </div>
      {%- endif -%}
      {%- if s.row2_img != blank or s.row2_title != blank -%}
      <div class="sp-row flip sp-rev">
        <div class="media">{%- if s.row2_img != blank -%}<img src="{{ s.row2_img | image_url: width: 1200 }}" alt="{{ s.row2_title | escape }}" loading="lazy">{%- endif -%}</div>
        <div class="txt">{%- if s.row2_title != blank -%}<h3>{{ s.row2_title }}</h3>{%- endif -%}{%- if s.row2_text != blank -%}<p>{{ s.row2_text }}</p>{%- endif -%}</div>
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== PICTURE 2 ===== {%- endcomment -%}
  {%- if s.band2_img != blank -%}
  <div class="sp-band"><img src="{{ s.band2_img | image_url: width: 2400 }}" alt="{{ s.band2_alt | default: 'Syrup Pouches' | escape }}" loading="lazy"></div>
  {%- endif -%}

  {%- comment -%} ===== GRID ===== {%- endcomment -%}
  {%- if s.show_grid -%}
  <hr class="sp-sep">
  <div class="sp-shop sp-section" id="sp-shop-{{ section.id }}">
    <div class="sp-wrap">
      <div class="sp-head sp-rev">
        {%- if s.grid_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.grid_eyebrow }}</span>{%- endif -%}
        <h2 class="sp-h2">{{ s.grid_title | default: '50 flavors. <em>Pick yours.</em>' }}</h2>
      </div>
      {%- if s.show_search -%}
      <div class="sp-search sp-rev">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="search" data-spsearch placeholder="{{ s.search_placeholder | default: 'Search flavors…' | escape }}" aria-label="Search flavors" autocomplete="off">
      </div>
      {%- endif -%}
      {%- if s.show_tabs -%}
      <div class="sp-tabs sp-rev" role="tablist">
        <button class="sp-tab on" data-filter="all">{{ s.tab_all | default: 'All' }}</button>
        <button class="sp-tab" data-filter="reg">{{ s.tab_reg | default: 'Regular' }}</button>
        <button class="sp-tab" data-filter="sf">{{ s.tab_sf | default: 'Sugar-Free' }}</button>
      </div>
      {%- endif -%}
      <div class="sp-grid" data-grid>
        {%- if cl != blank and cl.products.size > 0 -%}
          {%- comment -%} in-stock first in collection order (Best Selling), then out-of-stock A→Z
              by full title so all Sugar Free flavors group together under S {%- endcomment -%}
          {%- assign soon_sorted = cl.products | sort: 'title' -%}
          {%- assign passes = 'live,soon' | split: ',' -%}
          {%- for pass in passes -%}
          {%- if pass == 'live' -%}{%- assign plist = cl.products -%}{%- else -%}{%- assign plist = soon_sorted -%}{%- endif -%}
          {%- for pr in plist limit: 50 -%}
            {%- if pass == 'live' -%}{%- unless pr.available -%}{%- continue -%}{%- endunless -%}
            {%- else -%}{%- if pr.available -%}{%- continue -%}{%- endif -%}{%- endif -%}
            {%- assign tdl = pr.title | downcase -%}
            {%- assign kind = 'reg' -%}
            {%- if tdl contains 'sugar free' or tdl contains 'sugar-free' -%}{%- assign kind = 'sf' -%}{%- endif -%}
            {%- assign disp = pr.title | replace: '(USA)', '' | replace: 'Syrup Pouches', '' | strip -%}
            {%- if disp == blank -%}{%- assign disp = pr.title -%}{%- endif -%}
            {%- if pr.available -%}
            <a class="sp-tile sp-rev" data-kind="{{ kind }}" data-name="{{ tdl | escape }}" href="{{ pr.url }}">
              <span class="sp-badge">{{ s.preorder_badge | default: 'New' }}</span>
              {%- if kind == 'sf' -%}<span class="sp-badge sf">{{ s.sf_badge | default: '0g sugar' }}</span>{%- endif -%}
              <span class="ph">{%- if pr.featured_image -%}<img src="{{ pr.featured_image | image_url: width: 480 }}" alt="{{ pr.title | escape }}" loading="lazy">{%- endif -%}</span>
              <span class="b"><span class="t">{{ disp }}</span><span class="p">{{ pr.price | money }}</span>{%- if s.show_deal and s.deal_text != blank -%}<span class="sp-deal">{{ s.deal_text }}</span>{%- endif -%}</span>
            </a>
            {%- else -%}
            <div class="sp-tile soon sp-rev" data-kind="{{ kind }}" data-name="{{ tdl | escape }}">
              <span class="sp-soonov"><span class="cs">{{ s.coming_label | default: 'Coming soon' }}</span></span>
              {%- if kind == 'sf' -%}<span class="sp-badge sf">{{ s.sf_badge | default: '0g sugar' }}</span>{%- endif -%}
              <span class="ph">{%- if pr.featured_image -%}<img src="{{ pr.featured_image | image_url: width: 480 }}" alt="{{ pr.title | escape }}" loading="lazy">{%- else -%}<span class="fl">{{ disp }}</span>{%- endif -%}</span>
              <span class="b"><span class="t">{{ disp }}</span><span class="dt">{{ s.coming_label | default: 'Coming soon' }}</span>{%- if s.show_deal and s.deal_text != blank -%}<span class="sp-deal">{{ s.deal_text }}</span>{%- endif -%}</span>
            </div>
            {%- endif -%}
          {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign lists = 'reg,sf' | split: ',' -%}
        {%- for kindv in lists -%}
          {%- if kindv == 'reg' -%}{%- assign raw = s.upcoming_regular -%}{%- else -%}{%- assign raw = s.upcoming_sf -%}{%- endif -%}
          {%- if raw != blank -%}
            {%- assign lines = raw | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- assign fname = parts[0] | strip -%}
              {%- if fname == blank -%}{%- continue -%}{%- endif -%}
              {%- assign fkey = fname | downcase -%}
              {%- if kindv == 'sf' -%}{%- assign fkey = 'sugar free ' | append: fkey -%}{%- endif -%}
              {%- if live_titles contains fkey -%}{%- continue -%}{%- endif -%}
              {%- assign fdate = '' -%}{%- if parts.size > 1 -%}{%- assign fdate = parts[1] | strip -%}{%- endif -%}
              <div class="sp-tile soon sp-rev" data-kind="{{ kindv }}" data-name="{{ fname | downcase | escape }}">
                <span class="sp-soonov"><span class="cs">{{ s.coming_label | default: 'Coming soon' }}</span></span>
                {%- if kindv == 'sf' -%}<span class="sp-badge sf">{{ s.sf_badge | default: '0g sugar' }}</span>{%- endif -%}
                <span class="ph"><span class="fl">{{ fname }}</span></span>
                <span class="b"><span class="dt">{% if fdate != blank %}{{ fdate }}{% else %}{{ s.coming_label | default: 'Coming soon' }}{% endif %}</span></span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="sp-noresults" data-noresults>{{ s.search_empty | default: 'No flavors match your search — try another name.' }}</div>
      {%- if cl == blank -%}
        <div class="sp-empty" style="margin-top:14px;">Set the collection handle in the section settings (&ldquo;{{ s.collection_handle }}&rdquo; not found) &mdash; live pouch products will appear here automatically.</div>
      {%- endif -%}
      {%- if s.grid_note != blank -%}<p class="sp-note">{{ s.grid_note }}</p>{%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== PICTURE 3 ===== {%- endcomment -%}
  {%- if s.band3_img != blank -%}
  <div class="sp-band"><img src="{{ s.band3_img | image_url: width: 2400 }}" alt="{{ s.band3_alt | default: 'Syrup Pouches' | escape }}" loading="lazy"></div>
  {%- endif -%}

{%- else -%}

  {%- comment -%} ===== LOCKED VIEW — banner + sign in, nothing else ===== {%- endcomment -%}
  <div class="sp-lock-wrap">
    <a class="sp-lock-bn" href="{{ login_next }}" aria-label="{{ s.gate_title | default: 'VIP early access' | escape }} — sign in">
      <img class="d" src="{{ lock_d }}" alt="{{ s.gate_title | default: 'VIP early access' | escape }}">
      <img class="m" src="{{ lock_m }}" alt="">
    </a>
    <div class="sp-wrap">
      <div class="sp-lock-card sp-rev">
        <span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11 V8 a4 4 0 0 1 8 0 v3"/></svg></span>
        <h1>{{ s.gate_title | default: 'Pre-order is VIP-only right now' }}</h1>
        <p>{{ s.gate_text | default: 'VIP membership is free. Create an account (or sign in) and you can pre-order every pouch flavor before everyone else. Open to all on Monday.' }}</p>
        <div class="sp-btnrow">
