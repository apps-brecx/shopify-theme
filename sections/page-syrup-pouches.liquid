{%- comment -%}
  Syrup Pouches — launch page (Syruvia) · v5 "banner-led commerce".
  Structure: sticky 72h countdown → full-bleed top banner (defaults to uploaded
  Banner 3, optional link + button) → launch ribbon → numbered info boxes →
  FLAVOR ON THE GO statement → real product cards with quick add-to-cart
  (blocks, collection fallback) → See-all to collection → stick gallery
  carousel → more-flavors-coming-soon band → optional picture bands.
  Brand-true: cream bg, espresso type (Archivo Black display, Josefin Sans
  body), orange accent, thin-rule cards with offset shadows. Every text,
  image, color and toggle is editable. All motion respects reduced-motion.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign rad = s.card_radius | default: 16 -%}
{%- assign cl = collections[s.collection_handle] -%}

{%- assign allowed = false -%}
{%- case s.access_mode -%}
  {%- when 'everyone' -%}{%- assign allowed = true -%}
  {%- when 'vip_tag' -%}{%- if customer and customer.tags contains 'VIP' -%}{%- assign allowed = true -%}{%- endif -%}
  {%- else -%}{%- if customer -%}{%- assign allowed = true -%}{%- endif -%}
{%- endcase -%}

{%- comment -%} Uploaded defaults so the page looks finished with zero editor work {%- endcomment -%}
{%- assign banner_d = 'https://cdn.shopify.com/s/files/1/0861/1106/0252/files/Banner_3.png?v=1784903618' -%}
{%- assign banner_m = 'https://cdn.shopify.com/s/files/1/0861/1106/0252/files/Banner_3_Mobile.png?v=1784903619' -%}
{%- if s.hero_banner != blank -%}{%- assign banner_d = s.hero_banner | image_url: width: 2600 -%}{%- endif -%}
{%- if s.hero_banner_m != blank -%}{%- assign banner_m = s.hero_banner_m | image_url: width: 1400 -%}{%- endif -%}

{%- assign stick_defaults = 'https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download_f9ef59ce-471e-4ce8-a869-d172f6435a9c.webp?v=1784903214|https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download_f5cca5a9-bc12-4a90-a4d6-13a46d9b82f5.webp?v=1784903210|https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download_3b0e558e-fc82-425f-bb49-0f3fc1ca978d.webp?v=1784903209|https://cdn.shopify.com/s/files/1/0861/1106/0252/files/download.webp?v=1784903207' | split: '|' -%}

{%- assign login_next = routes.account_login_url | append: '?return_url=' | append: request.path -%}
{%- assign register_next = routes.account_register_url | append: '?return_url=' | append: request.path -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Josefin+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&display=swap">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Josefin+Sans:wght@300;400;600;700&display=swap"></noscript>

<style>
  #sp-{{ section.id }}{
    --ink:{{ s.color_ink | default: '#1a1a1a' }};
    --brand:{{ s.color_brand | default: '#3c2415' }};
    --bg:{{ s.color_bg | default: '#FFFBF4' }};
    --paper:{{ s.color_paper | default: '#ffffff' }};
    --orange:{{ s.color_orange | default: '#e28f26' }};
    --pop:{{ s.color_pop | default: '#C8252B' }};
    --butter:#FCE2A0;
    --sf:#2F7DC4;
    --rule-c:{{ s.color_rule | default: '#3c2415' }};
    --wrap:{{ s.wrap_max | default: 1120 }}px;
    --rad:{{ rad }}px;
    --display:'Archivo Black','Josefin Sans',system-ui,sans-serif;
    --serif:'Josefin Sans',system-ui,sans-serif;
    --rule:1.5px solid var(--rule-c);
    background:var(--bg);color:var(--ink);font-family:var(--serif);position:relative;overflow-x:clip;font-size:16px;line-height:1.6;scroll-behavior:smooth;
  }
  #sp-{{ section.id }} *{box-sizing:border-box;}
  #sp-{{ section.id }} .sp-wrap{max-width:var(--wrap);margin:0 auto;padding:0 22px;}
  #sp-{{ section.id }} .sp-eyebrow{font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.18em;text-transform:uppercase;display:inline-block;padding:6px 14px;border:var(--rule);border-radius:999px;background:var(--paper);color:var(--brand);}
  #sp-{{ section.id }} .sp-h2{font-family:var(--display);font-weight:400;font-size:clamp(26px,5vw,44px);line-height:1;letter-spacing:-.005em;text-transform:uppercase;margin:14px 0 0;color:var(--brand);text-wrap:balance;}
  #sp-{{ section.id }} .sp-h2 em{font-family:var(--serif);font-weight:300;font-style:italic;text-transform:none;letter-spacing:0;color:var(--orange);}
  #sp-{{ section.id }} .sp-lead{font-size:clamp(15px,2vw,17.5px);color:var(--ink);opacity:.8;max-width:56ch;margin:14px auto 0;}
  #sp-{{ section.id }} .sp-head{text-align:center;}
  #sp-{{ section.id }} .sp-rev{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .7s cubic-bezier(.2,.7,.2,1);}
  #sp-{{ section.id }} .sp-rev.in{opacity:1;transform:none;}
  #sp-{{ section.id }} .sp-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:var(--display);font-weight:400;font-size:13.5px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;padding:16px 30px;border:var(--rule);border-radius:999px;cursor:pointer;transition:transform .14s ease,box-shadow .14s ease,background .14s ease;background:var(--brand);color:var(--bg);box-shadow:3px 3px 0 rgba(60,36,21,.25);}
  #sp-{{ section.id }} .sp-btn--ghost{background:var(--paper);color:var(--brand);box-shadow:none;}
  @media(hover:hover){
    #sp-{{ section.id }} .sp-btn:hover{transform:translateY(-2px);box-shadow:4px 5px 0 rgba(60,36,21,.28);}
    #sp-{{ section.id }} .sp-btn--ghost:hover{background:#FFF3DC;}
  }
  #sp-{{ section.id }} .sp-btnrow{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
  @media(max-width:560px){#sp-{{ section.id }} .sp-btnrow .sp-btn{width:100%;}}
  #sp-{{ section.id }} .sp-sep{border:0;border-top:2px solid var(--rule-c);opacity:.14;margin:0;}
  #sp-{{ section.id }} .sp-section{padding:clamp(52px,7vw,88px) 0;}

  /* COUNTDOWN — sticky top bar */
  #sp-{{ section.id }} .sp-count{position:sticky;top:0;z-index:60;display:flex;align-items:center;justify-content:center;gap:8px 14px;flex-wrap:wrap;background:var(--brand);color:var(--bg);padding:10px 16px;border-bottom:var(--rule);text-align:center;}
  #sp-{{ section.id }} .sp-count .lb{font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.14em;text-transform:uppercase;}
  #sp-{{ section.id }} .sp-count .tm{font-family:var(--display);font-weight:400;font-size:17px;letter-spacing:.08em;color:var(--butter);font-variant-numeric:tabular-nums;}

  /* SYRUP PROGRESS BAR */
  #sp-{{ section.id }} .sp-pourbar{position:fixed;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,var(--orange),#c9761a);z-index:2147482000;border-radius:0 999px 999px 0;pointer-events:none;}

  /* TOP BANNER — the hero */
  #sp-{{ section.id }} .sp-hero{position:relative;overflow:hidden;}
  #sp-{{ section.id }} .sp-hero a{display:block;line-height:0;}
  #sp-{{ section.id }} .sp-hero img{display:block;width:100%;height:auto;animation:spkb{{ section.id }} 11s ease-out both;}
  #sp-{{ section.id }} .sp-hero .m{display:none;}
  @media(max-width:760px){
    #sp-{{ section.id }} .sp-hero .d{display:none;}
    #sp-{{ section.id }} .sp-hero .m{display:block;}
  }
  @keyframes spkb{{ section.id }}{from{transform:scale(1.04);}to{transform:scale(1);}}
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-hero img{animation:none;}}
  #sp-{{ section.id }} .sp-hero-btn{text-align:center;padding:20px 22px 6px;}

  /* LAUNCH RIBBON */
  #sp-{{ section.id }} .sp-mq{overflow:hidden;background:var(--orange);border-top:var(--rule);border-bottom:var(--rule);padding:11px 0;margin-top:18px;}
  #sp-{{ section.id }} .sp-mq .tr{display:flex;gap:40px;white-space:nowrap;width:max-content;animation:spmq{{ section.id }} 24s linear infinite;}
  #sp-{{ section.id }} .sp-mq span{font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;color:#fff;}
  @keyframes spmq{{ section.id }}{to{transform:translateX(-50%);}}
  @media (prefers-reduced-motion: reduce){#sp-{{ section.id }} .sp-mq .tr{animation:none;}}

  /* INFO BOXES */
  #sp-{{ section.id }} .sp-boxes .grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:32px;}
  @media(min-width:760px){#sp-{{ section.id }} .sp-boxes .grid{grid-template-columns:repeat(3,1fr);}}
  #sp-{{ section.id }} .sp-box{background:var(--bxbg,var(--paper));color:var(--bxtx,var(--ink));border:var(--rule);border-radius:calc(var(--rad) + 4px);box-shadow:4px 4px 0 rgba(60,36,21,.18);padding:28px 20px;text-align:center;}
  #sp-{{ section.id }} .sp-box .n{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--paper);color:var(--brand);border:var(--rule);font-family:var(--display);font-size:15px;margin-bottom:14px;box-shadow:2px 2px 0 rgba(60,36,21,.2);}
  #sp-{{ section.id }} .sp-box h3{font-family:var(--display);font-weight:400;font-size:16px;text-transform:uppercase;color:var(--bxtx,var(--brand));margin:0;line-height:1.15;}
  #sp-{{ section.id }} .sp-box p{font-size:14.5px;opacity:.9;margin:10px 0 0;line-height:1.55;}
  /* mobile — sticky stacking cards */
  @media(max-width:759px){
    #sp-{{ section.id }} .sp-boxes .grid{gap:18px;}
    #sp-{{ section.id }} .sp-box{position:sticky;top:calc(96px + (var(--i,0) * 16px));box-shadow:0 -8px 22px rgba(60,36,21,.14);}
  }

  /* POUCH STORY — numbers strip + boxed statement cards */
  #sp-{{ section.id }} .sp-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:34px;}
  @media(min-width:760px){#sp-{{ section.id }} .sp-stats{grid-template-columns:repeat(4,1fr);gap:16px;}}
  #sp-{{ section.id }} .sp-stat{border:var(--rule);border-radius:calc(var(--rad) + 4px);box-shadow:4px 4px 0 rgba(60,36,21,.18);padding:24px 12px 20px;text-align:center;}
  #sp-{{ section.id }} .sp-stat .nrow{font-family:var(--display);font-weight:400;font-size:clamp(36px,8vw,56px);line-height:1;font-variant-numeric:tabular-nums;}
  #sp-{{ section.id }} .sp-stat .u{font-size:.45em;margin-left:3px;text-transform:uppercase;}
  #sp-{{ section.id }} .sp-stat .lb{font-family:var(--display);font-weight:400;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;margin-top:9px;opacity:.9;line-height:1.45;padding:0 4px;}
  #sp-{{ section.id }} .sp-stat.c1{background:var(--orange);color:#fff;}
  #sp-{{ section.id }} .sp-stat.c2{background:var(--butter);color:var(--brand);}
  #sp-{{ section.id }} .sp-stat.c3{background:var(--sf);color:#fff;}
  #sp-{{ section.id }} .sp-stat.c4{background:var(--brand);color:var(--butter);}
  #sp-{{ section.id }} .sp-story .srow{position:relative;display:grid;grid-template-columns:1fr;gap:22px;align-items:center;margin-top:clamp(34px,5vw,52px);background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 8px);box-shadow:4px 4px 0 rgba(60,36,21,.14);padding:clamp(24px,4.5vw,44px);}
  #sp-{{ section.id }} .sp-story .srow.alt{background:#FFF3DC;}
  @media(min-width:820px){
    #sp-{{ section.id }} .sp-story .srow{grid-template-columns:1.05fr 1fr;gap:clamp(28px,5vw,60px);}
    #sp-{{ section.id }} .sp-story .srow.alt .smedia{order:-1;}
  }
  #sp-{{ section.id }} .sp-story .schip{position:absolute;top:-15px;left:24px;z-index:2;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.12em;text-transform:uppercase;background:var(--orange);color:#fff;border:var(--rule);border-radius:999px;padding:7px 15px;box-shadow:2px 2px 0 rgba(60,36,21,.2);}
  #sp-{{ section.id }} .sp-story .srow.alt .schip{background:var(--sf);}
  #sp-{{ section.id }} .sp-story .sbig{font-family:var(--display);font-weight:400;font-size:clamp(30px,6vw,54px);line-height:.98;letter-spacing:-.005em;text-transform:uppercase;color:var(--brand);margin:0;text-wrap:balance;}
  #sp-{{ section.id }} .sp-story .sbig em{font-family:var(--serif);font-style:italic;font-weight:300;text-transform:none;letter-spacing:0;color:var(--orange);}
  #sp-{{ section.id }} .sp-story .srow.alt .sbig em{color:var(--sf);}
  #sp-{{ section.id }} .sp-story .ssub{font-size:clamp(15px,2vw,17.5px);opacity:.82;margin:14px 0 0;max-width:46ch;line-height:1.6;}
  #sp-{{ section.id }} .sp-story .smedia img{width:100%;height:auto;display:block;border:var(--rule);border-radius:calc(var(--rad) + 2px);box-shadow:3px 3px 0 rgba(60,36,21,.12);}
  #sp-{{ section.id }} .sp-story .sph{border:1.5px dashed var(--rule-c);border-radius:calc(var(--rad) + 2px);background:rgba(255,255,255,.55);min-height:200px;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;font-size:13.5px;opacity:.65;}
  #sp-{{ section.id }} .sp-story .srow.noimg{grid-template-columns:1fr;text-align:center;}
  #sp-{{ section.id }} .sp-story .srow.noimg .ssub{margin-left:auto;margin-right:auto;}
  @media(max-width:819px){
    #sp-{{ section.id }} .sp-story .srow{text-align:center;}
    #sp-{{ section.id }} .sp-story .ssub{margin-left:auto;margin-right:auto;}
    #sp-{{ section.id }} .sp-story .schip{left:50%;transform:translateX(-50%);}
  }

  /* STATEMENT */
  #sp-{{ section.id }} .sp-say{padding:clamp(56px,9vw,110px) 0;text-align:center;overflow:clip;}
  #sp-{{ section.id }} .sp-say .l1,#sp-{{ section.id }} .sp-say .l2{display:block;font-family:var(--display);font-weight:400;text-transform:uppercase;line-height:.92;will-change:transform;}
  #sp-{{ section.id }} .sp-say .l1{font-size:clamp(52px,12vw,148px);color:var(--brand);}
  #sp-{{ section.id }} .sp-say .l2{font-size:clamp(40px,9.5vw,116px);color:transparent;-webkit-text-stroke:2.5px var(--orange);}
  @media(max-width:560px){#sp-{{ section.id }} .sp-say .l2{-webkit-text-stroke-width:1.8px;}}
  #sp-{{ section.id }} .sp-say .sub{font-size:clamp(15px,2.2vw,18px);opacity:.78;font-weight:300;max-width:52ch;margin:22px auto 0;}

  /* PRODUCT LISTINGS — real cards with quick add */
  #sp-{{ section.id }} .sp-prods{display:grid;grid-template-columns:1fr;gap:18px;margin-top:34px;}
  @media(min-width:700px){#sp-{{ section.id }} .sp-prods{grid-template-columns:repeat(3,1fr);}}
  #sp-{{ section.id }} .sp-card{position:relative;display:flex;flex-direction:column;background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 6px);overflow:hidden;box-shadow:3px 3px 0 rgba(60,36,21,.12);transition:transform .18s ease,box-shadow .18s ease;}
  @media(hover:hover){#sp-{{ section.id }} .sp-card:hover{transform:translateY(-4px);box-shadow:5px 7px 0 rgba(60,36,21,.16);}}
  #sp-{{ section.id }} .sp-card .ph{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:var(--bg);border-bottom:var(--rule);padding:22px;text-decoration:none;}
  #sp-{{ section.id }} .sp-card .ph img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .3s ease;}
  @media(hover:hover){#sp-{{ section.id }} .sp-card:hover .ph img{transform:scale(1.05) rotate(-2deg);}}
  #sp-{{ section.id }} .sp-card .b{display:flex;flex-direction:column;gap:8px;padding:18px 18px 20px;text-align:center;flex:1;}
  #sp-{{ section.id }} .sp-card .kick{font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--sf);}
  #sp-{{ section.id }} .sp-card .t{font-family:var(--display);font-weight:400;font-size:16px;line-height:1.15;text-transform:uppercase;color:var(--brand);text-decoration:none;}
  #sp-{{ section.id }} .sp-card .pr{font-family:var(--display);font-weight:400;font-size:17px;color:var(--brand);}
  #sp-{{ section.id }} .sp-card .pr s{opacity:.45;font-size:14px;margin-left:7px;}
  #sp-{{ section.id }} .sp-deal{display:inline-flex;align-items:center;gap:5px;font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.08em;text-transform:uppercase;background:var(--orange);color:#fff;border-radius:999px;padding:5px 11px;line-height:1.3;margin:0 auto;}
  #sp-{{ section.id }} .sp-card form{margin-top:auto;}
  #sp-{{ section.id }} .sp-card .atc{width:100%;font-family:var(--display);font-weight:400;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;background:var(--brand);color:var(--bg);border:var(--rule);border-radius:999px;padding:14px 18px;cursor:pointer;transition:transform .14s ease,box-shadow .14s ease;box-shadow:2px 2px 0 rgba(60,36,21,.22);}
  @media(hover:hover){#sp-{{ section.id }} .sp-card .atc:hover{transform:translateY(-2px);box-shadow:3px 4px 0 rgba(60,36,21,.26);}}
  #sp-{{ section.id }} .sp-card .atc[disabled]{background:var(--bg);color:var(--brand);opacity:.65;cursor:default;box-shadow:none;}
  #sp-{{ section.id }} .sp-flag{position:absolute;top:12px;left:12px;z-index:2;font-family:var(--display);font-weight:400;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:var(--pop);border-radius:999px;padding:6px 12px;}
  @media (prefers-reduced-motion: no-preference){
    #sp-{{ section.id }} .sp-flag{animation:sppulse{{ section.id }} 2.6s ease-in-out infinite;}
    @keyframes sppulse{{ section.id }}{0%,100%{transform:scale(1);}50%{transform:scale(1.07);}}
    #sp-{{ section.id }} .sp-prods .sp-card:nth-child(3n+2).sp-rev{transition-delay:.08s;}
    #sp-{{ section.id }} .sp-prods .sp-card:nth-child(3n).sp-rev{transition-delay:.16s;}
  }
  #sp-{{ section.id }} .sp-flag.soonf{background:var(--brand);animation:none;}
  #sp-{{ section.id }} .sp-seeall{margin-top:30px;}

  /* STICK GALLERY */
  #sp-{{ section.id }} .sp-gal .rail{display:flex;gap:18px;overflow-x:auto;padding:14px 22px 20px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  #sp-{{ section.id }} .sp-gal .rail::-webkit-scrollbar{display:none;}
  #sp-{{ section.id }} .sp-gal .rail > :first-child{margin-left:auto;}
  #sp-{{ section.id }} .sp-gal .rail > :last-child{margin-right:auto;}
  #sp-{{ section.id }} .sp-gal .card{flex:0 0 auto;width:min(230px,60vw);scroll-snap-align:center;background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 4px);padding:20px 16px;box-shadow:3px 3px 0 rgba(60,36,21,.12);transform:rotate(-2.2deg);transition:transform .25s ease;}
  #sp-{{ section.id }} .sp-gal .card:nth-child(even){transform:rotate(2.2deg);}
  @media(hover:hover){#sp-{{ section.id }} .sp-gal .card:hover{transform:rotate(0deg) translateY(-6px);}}
  #sp-{{ section.id }} .sp-gal .card img{width:100%;height:auto;display:block;}
  #sp-{{ section.id }} .sp-gal .note{text-align:center;font-family:var(--display);font-weight:400;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--brand);opacity:.7;margin-top:12px;padding:0 22px;}

  /* PICTURE BANDS */
  #sp-{{ section.id }} .sp-band a{display:block;line-height:0;}
  #sp-{{ section.id }} .sp-band img{display:block;width:100%;height:auto;}
  #sp-{{ section.id }} .sp-band .m{display:none;}
  @media(max-width:760px){
    #sp-{{ section.id }} .sp-band .has-m.d{display:none;}
    #sp-{{ section.id }} .sp-band .m{display:block;}
  }

  /* LOCKED VIEW */
  #sp-{{ section.id }} .sp-lock-wrap{padding-bottom:clamp(48px,7vw,84px);}
  #sp-{{ section.id }} .sp-lock-card{position:relative;z-index:2;max-width:620px;margin:clamp(-38px,-5vw,-64px) auto 0;background:var(--paper);border:var(--rule);border-radius:calc(var(--rad) + 8px);box-shadow:5px 5px 0 rgba(60,36,21,.16);padding:36px 28px 30px;text-align:center;}
  #sp-{{ section.id }} .sp-lock-card h1{font-family:var(--display);font-weight:400;font-size:clamp(21px,4.6vw,29px);text-transform:uppercase;color:var(--brand);margin:0;line-height:1.05;}
  #sp-{{ section.id }} .sp-lock-card p{font-size:14.5px;opacity:.8;margin:12px auto 0;max-width:46ch;}
  #sp-{{ section.id }} .sp-lock-card .sp-btnrow{margin-top:22px;}

  /* mobile — product cards become collection-style list rows */
  @media(max-width:640px){
    #sp-{{ section.id }} .sp-prods{grid-template-columns:1fr;gap:14px;}
    #sp-{{ section.id }} .sp-card{flex-direction:row;align-items:stretch;}
    #sp-{{ section.id }} .sp-card .ph{width:132px;min-width:132px;aspect-ratio:1/1;border-bottom:none;border-right:var(--rule);padding:12px;}
    #sp-{{ section.id }} .sp-card .b{padding:14px 14px;justify-content:center;}
    #sp-{{ section.id }} .sp-card .t{font-size:14.5px;}
    #sp-{{ section.id }} .sp-card .pr{font-size:15px;}
    #sp-{{ section.id }} .sp-card .atc{padding:12px 14px;font-size:11.5px;}
    #sp-{{ section.id }} .sp-flag{top:8px;left:8px;}
  }

  @media (prefers-reduced-motion: reduce){
    #sp-{{ section.id }} .sp-rev{opacity:1;transform:none;}
  }
</style>

<section id="sp-{{ section.id }}">
{%- if allowed -%}

  {%- if s.show_progress -%}<div class="sp-pourbar" data-pour-bar aria-hidden="true"></div>{%- endif -%}

  {%- if s.count_enable and s.count_start != blank -%}
  <div class="sp-count" data-count-bar data-start="{{ s.count_start | strip }}" data-tz="{{ s.count_tz | default: '-04:00' }}" data-hours="{{ s.count_hours | default: 72 }}">
    <span class="lb">{{ s.count_label | default: 'Launch deal ends in' }}</span>
    <span class="tm" data-count-time>--:--:--</span>
  </div>
  {%- endif -%}

  {%- comment -%} ===== TOP BANNER (hero) ===== {%- endcomment -%}
  {%- assign hero_href = '/collections/syrup-pouches' -%}
  {%- if s.feat_seeall_url != blank -%}{%- assign hero_href = s.feat_seeall_url -%}{%- endif -%}
  {%- if s.hero_link != blank -%}{%- assign hero_href = s.hero_link -%}{%- endif -%}
  <div class="sp-hero">
    <a href="{{ hero_href }}" aria-label="{{ s.hero_alt | default: 'Syrup Pouches' | escape }}">
      <img class="d" src="{{ banner_d }}" alt="{{ s.hero_alt | default: 'Syrup Pouches' | escape }}" loading="eager">
      <img class="m" src="{{ banner_m }}" alt="{{ s.hero_alt | default: 'Syrup Pouches' | escape }}" loading="eager">
    </a>
  </div>
  {%- if s.show_marquee -%}
  {%- assign mqi = s.marquee_text | default: 'Just dropped · Syrup Pouches · Flavor On The Go' -%}
  <div class="sp-mq" aria-hidden="true"><div class="tr">{%- for i in (1..4) -%}<span>{{ mqi }}</span>{%- endfor -%}{%- for i in (1..4) -%}<span>{{ mqi }}</span>{%- endfor -%}</div></div>
  {%- endif -%}

  {%- comment -%} ===== INFO BOXES ===== {%- endcomment -%}
  {%- assign box_count = 0 -%}
  {%- capture boxes_html -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'box' -%}{%- continue -%}{%- endif -%}
      {%- assign box_count = box_count | plus: 1 -%}
      <div class="sp-box sp-rev" style="--bxbg:{{ block.settings.bg | default: '#e28f26' }};--bxtx:{{ block.settings.tx | default: '#ffffff' }};--i:{{ box_count | minus: 1 }};" {{ block.shopify_attributes }}>
        <span class="n">{{ box_count }}</span>
        {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if box_count > 0 -%}
  <div class="sp-boxes sp-section">
    <div class="sp-wrap">
      <div class="sp-head sp-rev">
        {%- if s.boxes_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.boxes_eyebrow }}</span>{%- endif -%}
        <h2 class="sp-h2">{{ s.boxes_title | default: 'Little pouch. <em>Big flavor.</em>' }}</h2>
      </div>
      <div class="grid">{{ boxes_html }}</div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== POUCH STORY ===== {%- endcomment -%}
  {%- assign story_count = 0 -%}
  {%- capture story_html -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'story' -%}{%- continue -%}{%- endif -%}
      {%- assign story_count = story_count | plus: 1 -%}
      {%- assign simg = block.settings.img -%}
      {%- assign alt_row = story_count | modulo: 2 -%}
      <div class="srow sp-rev{% if alt_row == 0 %} alt{% endif %}{% if simg == blank and request.design_mode != true %} noimg{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.chip != blank -%}<span class="schip">{{ block.settings.chip }}</span>{%- endif -%}
        <div class="stxt">
          {%- if block.settings.big != blank -%}<h3 class="sbig">{{ block.settings.big }}</h3>{%- endif -%}
          {%- if block.settings.sub != blank -%}<p class="ssub">{{ block.settings.sub }}</p>{%- endif -%}
        </div>
        {%- if simg != blank -%}
        <div class="smedia"><img src="{{ simg | image_url: width: 1200 }}" alt="{{ block.settings.big | strip_html | escape }}" loading="lazy"></div>
        {%- elsif request.design_mode -%}
        <div class="smedia"><div class="sph">{{ block.settings.hint | default: 'Upload a lifestyle photo here.' }}</div></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if story_count > 0 -%}
  <hr class="sp-sep">
  <div class="sp-story sp-section">
    <div class="sp-wrap">
      <div class="sp-head sp-rev">
        {%- if s.story_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.story_eyebrow }}</span>{%- endif -%}
        <h2 class="sp-h2">{{ s.story_title | default: 'Your favorite syrup. <em>Now in your pocket.</em>' }}</h2>
      </div>
      {%- if s.show_stats -%}
      <div class="sp-stats sp-rev">
        <div class="sp-stat c1">
          <div class="nrow"><span data-statnum="{{ s.stat1_n | default: '30' }}">{{ s.stat1_n | default: '30' }}</span>{%- if s.stat1_u != blank -%}<span class="u">{{ s.stat1_u }}</span>{%- endif -%}</div>
          {%- assign l1 = s.stat1_l | default: 'Pouches in every bag' -%}{%- if l1 != blank -%}<div class="lb">{{ l1 }}</div>{%- endif -%}
        </div>
        <div class="sp-stat c2">
          <div class="nrow"><span data-statnum="{{ s.stat2_n | default: '15' }}">{{ s.stat2_n | default: '15' }}</span><span class="u">{{ s.stat2_u | default: 'ml' }}</span></div>
          {%- assign l2 = s.stat2_l | default: 'Per stick · one perfect serving' -%}{%- if l2 != blank -%}<div class="lb">{{ l2 }}</div>{%- endif -%}
        </div>
        <div class="sp-stat c3">
          <div class="nrow"><span data-statnum="{{ s.stat3_n | default: '450' }}">{{ s.stat3_n | default: '450' }}</span><span class="u">{{ s.stat3_u | default: 'ml' }}</span></div>
          {%- assign l3 = s.stat3_l | default: 'Per bag · 15.2 fl oz total' -%}{%- if l3 != blank -%}<div class="lb">{{ l3 }}</div>{%- endif -%}
        </div>
        <div class="sp-stat c4">
          <div class="nrow"><span data-statnum="{{ s.stat4_n | default: '0' }}">{{ s.stat4_n | default: '0' }}</span><span class="u">{{ s.stat4_u | default: 'g' }}</span></div>
          {%- assign l4 = s.stat4_l | default: 'Sugar in the sugar-free line' -%}{%- if l4 != blank -%}<div class="lb">{{ l4 }}</div>{%- endif -%}
        </div>
      </div>
      {%- endif -%}
      {{ story_html }}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== STATEMENT ===== {%- endcomment -%}
  {%- if s.show_statement -%}
  <hr class="sp-sep">
  <div class="sp-say">
    <div class="sp-wrap">
      <span class="l1" data-drift="-0.055">{{ s.statement_l1 | default: 'Flavor' }}</span>
      <span class="l2" data-drift="0.075">{{ s.statement_l2 | default: 'On The Go!' }}</span>
      {%- if s.statement_sub != blank -%}<p class="sub sp-rev">{{ s.statement_sub }}</p>{%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== PRODUCT LISTINGS ===== {%- endcomment -%}
  {%- assign prod_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product' and block.settings.product != blank -%}{%- assign prod_count = prod_count | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- assign use_fallback = false -%}
  {%- if prod_count == 0 and cl != blank and cl.products.size > 0 -%}
    {%- assign use_fallback = true -%}
    {%- assign prod_count = cl.products.size -%}
  {%- endif -%}
  {%- if prod_count > 0 -%}
  <hr class="sp-sep">
  <div class="sp-section" id="sp-shop-{{ section.id }}">
    <div class="sp-wrap">
      <div class="sp-head sp-rev">
        {%- if s.feat_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.feat_eyebrow }}</span>{%- endif -%}
        <h2 class="sp-h2">{{ s.feat_title | default: 'Shop <em>Pouches</em>' }}</h2>
      </div>
      <div class="sp-prods">
      {%- comment -%} in-stock first, then out-of-stock as Coming Soon {%- endcomment -%}
      {%- assign passes = 'live,soon' | split: ',' -%}
      {%- if use_fallback -%}
        {%- assign shown = 0 -%}
        {%- for pass in passes -%}
          {%- for fp in cl.products limit: 48 -%}
            {%- if shown >= 6 -%}{%- break -%}{%- endif -%}
            {%- if pass == 'live' -%}{%- unless fp.available -%}{%- continue -%}{%- endunless -%}
            {%- else -%}{%- if fp.available -%}{%- continue -%}{%- endif -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'sp-pouch-card', fp: fp, sett: s -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for pass in passes -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'product' -%}{%- continue -%}{%- endif -%}
            {%- assign fp = block.settings.product -%}
            {%- if fp == blank -%}{%- continue -%}{%- endif -%}
            {%- if pass == 'live' -%}{%- unless fp.available -%}{%- continue -%}{%- endunless -%}
            {%- else -%}{%- if fp.available -%}{%- continue -%}{%- endif -%}{%- endif -%}
            {%- render 'sp-pouch-card', fp: fp, sett: s, badge_override: block.settings.badge, attrs: block.shopify_attributes -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
      </div>
      {%- if s.feat_seeall != blank -%}
      <div class="sp-btnrow sp-seeall sp-rev">
        <a class="sp-btn sp-btn--ghost" href="{{ s.feat_seeall_url | default: '/collections/syrup-pouches' }}">{{ s.feat_seeall }} &rarr;</a>
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== STICK GALLERY ===== {%- endcomment -%}
  {%- if s.show_gallery -%}
  <hr class="sp-sep">
  <div class="sp-gal sp-section">
    <div class="sp-head sp-rev" style="padding:0 22px;">
      {%- if s.gallery_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.gallery_eyebrow }}</span>{%- endif -%}
      <h2 class="sp-h2">{{ s.gallery_title | default: 'This is the <em>stick</em>' }}</h2>
      {%- if s.gallery_sub != blank -%}<p class="sp-lead">{{ s.gallery_sub }}</p>{%- endif -%}
    </div>
    <div class="rail sp-rev" style="margin-top:26px;">
      {%- assign gal_any = false -%}
      {%- assign gal_slots = 'gal_1,gal_2,gal_3,gal_4,gal_5,gal_6' | split: ',' -%}
      {%- for slot in gal_slots -%}
        {%- assign gimg = s[slot] -%}
        {%- if gimg != blank -%}{%- assign gal_any = true -%}
        <div class="card"><img src="{{ gimg | image_url: width: 600 }}" alt="Syrup Pouch stick" loading="lazy"></div>
        {%- endif -%}
      {%- endfor -%}
      {%- unless gal_any -%}
        {%- for i in (0..3) -%}
        <div class="card"><img src="{{ stick_defaults[i] }}" alt="Syrup Pouch stick" loading="lazy"></div>
        {%- endfor -%}
      {%- endunless -%}
    </div>
    {%- if s.gallery_note != blank -%}<p class="note">{{ s.gallery_note }}</p>{%- endif -%}
  </div>
  {%- endif -%}

  {%- comment -%} ===== MORE FLAVORS COMING SOON ===== {%- endcomment -%}
  {%- if s.soon_title != blank -%}
  <hr class="sp-sep">
  <div class="sp-section">
    <div class="sp-wrap sp-head sp-rev">
      {%- if s.soon_eyebrow != blank -%}<span class="sp-eyebrow">{{ s.soon_eyebrow }}</span>{%- endif -%}
      <h2 class="sp-h2">{{ s.soon_title }}</h2>
      {%- if s.soon_sub != blank -%}<p class="sp-lead">{{ s.soon_sub }}</p>{%- endif -%}
      {%- if s.soon_btn != blank -%}
      <div class="sp-btnrow sp-rev" style="margin-top:24px;">
        <a class="sp-btn" href="{{ s.feat_seeall_url | default: '/collections/syrup-pouches' }}">{{ s.soon_btn }}</a>
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ===== EXTRA PICTURE BANDS ===== {%- endcomment -%}
  {%- if s.band1_img != blank -%}
  <div class="sp-band">
    <img class="d {% if s.band1_img_m != blank %}has-m{% endif %}" src="{{ s.band1_img | image_url: width: 2400 }}" alt="{{ s.band1_alt | default: 'Syrup Pouches' | escape }}" loading="lazy">
    {%- if s.band1_img_m != blank -%}<img class="m" src="{{ s.band1_img_m | image_url: width: 1200 }}" alt="{{ s.band1_alt | default: 'Syrup Pouches' | escape }}" loading="lazy">{%- endif -%}
  </div>
  {%- endif -%}
  {%- if s.band2_img != blank -%}
  <div class="sp-band"><img src="{{ s.band2_img | image_url: width: 2400 }}" alt="{{ s.band2_alt | default: 'Syrup Pouches' | escape }}" loading="lazy"></div>
  {%- endif -%}

{%- else -%}

  {%- comment -%} ===== LOCKED VIEW ===== {%- endcomment -%}
  <div class="sp-lock-wrap">
    <div class="sp-hero">
      <a href="{{ login_next }}" aria-label="Sign in">
        <img class="d" src="{{ banner_d }}" alt="{{ s.gate_title | default: 'Members only' | escape }}">
        <img class="m" src="{{ banner_m }}" alt="">
      </a>
    </div>
    <div class="sp-wrap">
      <div class="sp-lock-card sp-rev">
        <h1>{{ s.gate_title | default: 'This drop is members-only right now' }}</h1>
        <p>{{ s.gate_text | default: 'Membership is free. Create an account (or sign in) to shop the drop.' }}</p>
        <div class="sp-btnrow">
          <a class="sp-btn" href="{{ login_next }}">{{ s.lock_cta | default: 'Shop now' }}</a>
          <a class="sp-btn sp-btn--ghost" href="{{ register_next }}">{{ s.gate_join | default: 'Join free' }}</a>
        </div>
      </div>
    </div>
  </div>

{%- endif -%}
</section>

<script>
(function(){
  var root=document.getElementById('sp-{{ section.id }}');
  if(!root) return;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if('IntersectionObserver' in window && !reduce){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });},{threshold:.1});
    root.querySelectorAll('.sp-rev').forEach(function(el){io.observe(el);});
  } else { root.querySelectorAll('.sp-rev').forEach(function(el){el.classList.add('in');}); }

  /* statement drift */
  var drifts=[].slice.call(root.querySelectorAll('[data-drift]'));
  if(drifts.length && !reduce){
    var dT=false;
    function drift(){
      dT=false;
      var vh=window.innerHeight||1;
      for(var k=0;k<drifts.length;k++){
        var dEl=drifts[k];
        var dsp=parseFloat(dEl.getAttribute('data-drift'))||0;
        var dr=dEl.getBoundingClientRect();
        var prog=(dr.top + dr.height/2 - vh/2)/vh;
        dEl.style.transform='translateX('+(prog*dsp*(window.innerWidth||1000)).toFixed(1)+'px)';
      }
    }
    window.addEventListener('scroll',function(){ if(!dT){dT=true;requestAnimationFrame(drift);} },{passive:true});
    drift();
  }

  /* 72h countdown bar */
  var cb=root.querySelector('[data-count-bar]');
  if(cb){
    var cst=(cb.getAttribute('data-start')||'').trim();
    if(/^\d{4}-\d{2}-\d{2}$/.test(cst)) cst+=' 00:00';
    var ctz=cb.getAttribute('data-tz')||'-04:00';
    var chrs=parseFloat(cb.getAttribute('data-hours'))||72;
    var startMs=Date.parse(cst.replace(' ','T')+ctz);
    var tEl=cb.querySelector('[data-count-time]');
    if(isNaN(startMs)||!tEl){ cb.style.display='none'; }
    else{
      var endMs=startMs+chrs*3600000;
      var capMs=chrs*3600000;
      var two=function(n){return n<10?'0'+n:''+n;};
      var tickC=function(){
        var left=endMs-Date.now();
        if(left<=0){ cb.style.display='none'; return; }
        if(left>capMs)left=capMs;
        var h=Math.floor(left/3600000),m=Math.floor(left%3600000/60000),s2=Math.floor(left%60000/1000);
        tEl.textContent=two(h)+':'+two(m)+':'+two(s2);
        setTimeout(tickC,1000);
      };
      tickC();
    }
  }

  /* numbers strip — count up when visible */
  var stats=[].slice.call(root.querySelectorAll('[data-statnum]'));
  if(stats.length){
    var runS=function(el){
      var raw=el.getAttribute('data-statnum');
      var t=parseFloat(raw);
      if(isNaN(t)||reduce){ el.textContent=raw; return; }
      var s0=null,d=1200;
      function st(ts){ if(!s0)s0=ts; var p=Math.min((ts-s0)/d,1); p=1-Math.pow(1-p,3); el.textContent=Math.round(t*p); if(p<1){requestAnimationFrame(st);}else{el.textContent=raw;} }
      requestAnimationFrame(st);
    };
    if('IntersectionObserver' in window){
      var io3=new IntersectionObserver(function(es){es.forEach(function(e){ if(e.isIntersecting){ runS(e.target); io3.unobserve(e.target); } });},{threshold:.6});
      stats.forEach(function(n){io3.observe(n);});
    } else { stats.forEach(runS); }
  }

  /* syrup progress bar */
  var pourBar=root.querySelector('[data-pour-bar]');
  if(pourBar){
    var pbT=false;
    function pb(){
      pbT=false;
      var r=root.getBoundingClientRect();
      var vh=window.innerHeight||1;
      var total=r.height-vh;
      var p=total>0?Math.min(Math.max(-r.top/total,0),1):0;
      pourBar.style.width=(p*100).toFixed(2)+'%';
    }
    window.addEventListener('scroll',function(){ if(!pbT){pbT=true;requestAnimationFrame(pb);} },{passive:true});
    window.addEventListener('resize',pb);
    pb();
  }

  /* launch confetti — one burst per session */
  {%- if s.show_confetti -%}
  if(!reduce && !sessionStorage.getItem('spconf{{ section.id }}')){
    try{ sessionStorage.setItem('spconf{{ section.id }}','1'); }catch(e){}
    var cv=document.createElement('canvas');
    cv.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:2147481000;';
    document.body.appendChild(cv);
    var cxx=cv.getContext('2d');
    var W=cv.width=window.innerWidth,H=cv.height=window.innerHeight;
    var cols=['#e28f26','#3c2415','#FCE2A0','#C8252B','#2F7DC4','#ffffff'];
    var ps=[];
    for(var ci=0;ci<90;ci++){ ps.push({x:Math.random()*W,y:-30-Math.random()*H*1.7,w:5+Math.random()*6,h:8+Math.random()*8,c:cols[ci%cols.length],v:1.5+Math.random()*2.1,r:Math.random()*Math.PI,vr:(Math.random()-.5)*.22,sw:Math.random()*6}); }
    var ct0=null;
    function ctick(ts){
      if(!ct0)ct0=ts;
      var el=ts-ct0;
      cxx.clearRect(0,0,W,H);
      for(var i=0;i<ps.length;i++){ var p=ps[i]; p.y+=p.v; p.x+=Math.sin(el/320+p.sw)*1.15; p.r+=p.vr;
        cxx.save(); cxx.translate(p.x,p.y); cxx.rotate(p.r); cxx.fillStyle=p.c; cxx.fillRect(-p.w/2,-p.h/2,p.w,p.h); cxx.restore(); }
      if(el<{{ s.confetti_secs | default: 5 | times: 1000 }}){ requestAnimationFrame(ctick); } else { cv.remove(); }
    }
    requestAnimationFrame(ctick);
  }
  {%- endif -%}
})();
</script>

{% schema %}
{
  "name": "Syrup Pouches Launch",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Who can see the page" },
    { "type": "select", "id": "access_mode", "label": "Access", "default": "everyone", "options": [
      { "value": "everyone", "label": "Everyone" },
      { "value": "signed_in", "label": "Signed-in members only" },
      { "value": "vip_tag", "label": "Strict: VIP tag only" }
    ] },
    { "type": "text", "id": "gate_title", "label": "Locked title", "default": "This drop is members-only right now" },
    { "type": "textarea", "id": "gate_text", "label": "Locked text", "default": "Membership is free. Create an account (or sign in) to shop the drop." },
    { "type": "text", "id": "lock_cta", "label": "Locked shop button", "default": "Shop now" },
    { "type": "text", "id": "gate_join", "label": "Locked join button", "default": "Join free" },
    { "type": "header", "content": "72-hour countdown" },
    { "type": "checkbox", "id": "count_enable", "label": "Countdown on (check when the clock starts)", "default": false },
    { "type": "text", "id": "count_start", "label": "Start date & time", "info": "Format: 2026-07-27 18:00 (your store's time). Timer runs for the hours below from this moment." },
    { "type": "range", "id": "count_hours", "label": "Countdown length (hours)", "min": 12, "max": 96, "step": 12, "default": 72 },
    { "type": "text", "id": "count_tz", "label": "Timezone offset", "default": "-04:00", "info": "-04:00 = New York summer time" },
    { "type": "text", "id": "count_label", "label": "Countdown label", "default": "Launch deal ends in" },
    { "type": "header", "content": "Top banner" },
    { "type": "paragraph", "content": "The page opens with this full-width banner. Defaults to your uploaded Banner 3 — replace any time." },
    { "type": "image_picker", "id": "hero_banner", "label": "Banner — desktop" },
    { "type": "image_picker", "id": "hero_banner_m", "label": "Banner — mobile" },
    { "type": "url", "id": "hero_link", "label": "Banner link — the whole banner is the button" },
    { "type": "text", "id": "hero_alt", "label": "Banner alt text", "default": "Syrup Pouches" },
