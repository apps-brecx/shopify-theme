<script>
(function(){
  var root=document.getElementById('sp-{{ section.id }}');
  if(!root) return;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if('IntersectionObserver' in window && !reduce){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });},{threshold:.1});
    root.querySelectorAll('.sp-rev').forEach(function(el){io.observe(el);});
  } else { root.querySelectorAll('.sp-rev').forEach(function(el){el.classList.add('in');}); }

  var scene=root.querySelector('[data-scene]');
  if(scene && !reduce){
    var drops=[].slice.call(scene.querySelectorAll('.sp-rain-item'));
    var sticks=[].slice.call(scene.querySelectorAll('.sp-stick'));
    var drifts=[].slice.call(scene.querySelectorAll('[data-drift]'));
    var heroLogo=scene.querySelector('[data-hero-logo]');
    var tick2=false;
    function fall(){
      tick2=false;
      var vh=window.innerHeight||1;
      var sr=scene.getBoundingClientRect();
      var sc=-sr.top; if(sc<0)sc=0;
      for(var i=0;i<drops.length;i++){
        var el=drops[i];
        var sp=parseFloat(el.getAttribute('data-speed'))||0.25;
        var rot=parseFloat(el.getAttribute('data-rot'))||0;
        el.style.transform='translateY('+(sc*sp).toFixed(1)+'px) rotate('+(rot + sc*0.024*(rot<0?-1:1)).toFixed(1)+'deg)';
      }
      for(var j=0;j<sticks.length;j++){
        var stEl=sticks[j];
        var psp=parseFloat(stEl.getAttribute('data-pspeed'))||0.2;
        var dir=parseFloat(stEl.getAttribute('data-pour'))||1;
        var pour=Math.min(sc/560,1);
        pour=1-Math.pow(1-pour,2);
        stEl.style.transform='translateY('+(-sc*psp).toFixed(1)+'px) rotate('+(pour*82*dir).toFixed(1)+'deg)';
      }
      for(var k=0;k<drifts.length;k++){
        var dEl=drifts[k];
        var dsp=parseFloat(dEl.getAttribute('data-drift'))||0;
        var dr=dEl.getBoundingClientRect();
        var prog=(dr.top + dr.height/2 - vh/2)/vh;
        dEl.style.transform='translateX('+(prog*dsp*(window.innerWidth||1000)).toFixed(1)+'px)';
      }
      if(heroLogo){
        var p=Math.min(sc/500,1);
        heroLogo.style.transform='scale('+(1-p*0.14).toFixed(3)+')';
        heroLogo.style.opacity=(1-p*0.2).toFixed(2);
      }
    }
    window.addEventListener('scroll',function(){ if(!tick2){tick2=true;requestAnimationFrame(fall);} },{passive:true});
    window.addEventListener('resize',fall);
    fall();
  }

  /* 72h countdown bar */
  var cb=root.querySelector('[data-count-bar]');
  if(cb){
    var cst=(cb.getAttribute('data-start')||'').trim();
    var ctz=cb.getAttribute('data-tz')||'-04:00';
    var chrs=parseFloat(cb.getAttribute('data-hours'))||72;
    var startMs=Date.parse(cst.replace(' ','T')+ctz);
    var tEl=cb.querySelector('[data-count-time]');
    if(isNaN(startMs)||!tEl){ cb.style.display='none'; }
    else{
      var endMs=startMs+chrs*3600000;
      var capMs=chrs*3600000;
      var two=function(n){return n<10?'0'+n:''+n;};
      var tickC=function(){
        var left=endMs-Date.now();
        if(left<=0){ cb.style.display='none'; return; }
        if(left>capMs)left=capMs;
        var h=Math.floor(left/3600000),m=Math.floor(left%3600000/60000),s2=Math.floor(left%60000/1000);
        tEl.textContent=two(h)+':'+two(m)+':'+two(s2);
        setTimeout(tickC,1000);
      };
      tickC();
    }
  }

  /* syrup progress bar — fills as you scroll the page */
  var pourBar=root.querySelector('[data-pour-bar]');
  if(pourBar){
    var pbT=false;
    function pb(){
      pbT=false;
      var r=root.getBoundingClientRect();
      var vh=window.innerHeight||1;
      var total=r.height-vh;
      var p=total>0?Math.min(Math.max(-r.top/total,0),1):0;
      pourBar.style.width=(p*100).toFixed(2)+'%';
    }
    window.addEventListener('scroll',function(){ if(!pbT){pbT=true;requestAnimationFrame(pb);} },{passive:true});
    window.addEventListener('resize',pb);
    pb();
  }

  /* launch confetti — one burst per session */
  {%- if s.show_confetti -%}
  if(scene && !reduce && !sessionStorage.getItem('spconf{{ section.id }}')){
    try{ sessionStorage.setItem('spconf{{ section.id }}','1'); }catch(e){}
    var cv=document.createElement('canvas');
    cv.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:2147481000;';
    document.body.appendChild(cv);
    var cxx=cv.getContext('2d');
    var W=cv.width=window.innerWidth,H=cv.height=window.innerHeight;
    var cols=['#e28f26','#3c2415','#FCE2A0','#C8252B','#2F7DC4','#ffffff'];
    var ps=[];
    for(var ci=0;ci<90;ci++){ ps.push({x:Math.random()*W,y:-30-Math.random()*H*0.6,w:5+Math.random()*6,h:8+Math.random()*8,c:cols[ci%cols.length],v:2.4+Math.random()*3.2,r:Math.random()*Math.PI,vr:(Math.random()-.5)*.22,sw:Math.random()*6}); }
    var ct0=null;
    function ctick(ts){
      if(!ct0)ct0=ts;
      var el=ts-ct0;
      cxx.clearRect(0,0,W,H);
      for(var i=0;i<ps.length;i++){ var p=ps[i]; p.y+=p.v; p.x+=Math.sin(el/320+p.sw)*1.15; p.r+=p.vr;
        cxx.save(); cxx.translate(p.x,p.y); cxx.rotate(p.r); cxx.fillStyle=p.c; cxx.fillRect(-p.w/2,-p.h/2,p.w,p.h); cxx.restore(); }
      if(el<2600){ requestAnimationFrame(ctick); } else { cv.remove(); }
    }
    requestAnimationFrame(ctick);
  }
  {%- endif -%}

  /* credits counter — counts up when the card scrolls into view */
  var nums=[].slice.call(root.querySelectorAll('[data-count]'));
  if(nums.length){
    var fmt=function(n){return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g,',');};
    var runCount=function(el){
      var t=parseInt(el.getAttribute('data-count'),10)||0;
      if(reduce){ el.textContent=fmt(t); return; }
      var s0=null,d=1300;
      function st(ts){ if(!s0)s0=ts; var p=Math.min((ts-s0)/d,1); p=1-Math.pow(1-p,3); el.textContent=fmt(Math.round(t*p)); if(p<1)requestAnimationFrame(st); }
      requestAnimationFrame(st);
    };
    if('IntersectionObserver' in window){
      var io2=new IntersectionObserver(function(es){es.forEach(function(e){ if(e.isIntersecting){ runCount(e.target); io2.unobserve(e.target); } });},{threshold:.5});
      nums.forEach(function(n){io2.observe(n);});
    } else { nums.forEach(runCount); }
  }

  /* credits card — gentle 3D tilt on pointer */
  var tc=root.querySelector('[data-tilt]');
  if(tc && !reduce && window.matchMedia&&window.matchMedia('(hover:hover)').matches){
    tc.addEventListener('pointermove',function(e){
      var r=tc.getBoundingClientRect();
      var x=(e.clientX-r.left)/r.width-.5;
      var y=(e.clientY-r.top)/r.height-.5;
      tc.style.transform='perspective(950px) rotateY('+(x*4).toFixed(2)+'deg) rotateX('+(-y*3).toFixed(2)+'deg)';
    });
    tc.addEventListener('pointerleave',function(){ tc.style.transform=''; });
  }

  /* lineup filtering — tabs + search combine */
  var tabs=[].slice.call(root.querySelectorAll('.sp-tab'));
  var tiles=[].slice.call(root.querySelectorAll('[data-grid] .sp-tile'));
  var searchEl=root.querySelector('[data-spsearch]');
  var noRes=root.querySelector('[data-noresults]');
  var curF='all', q='';
  function applyFilter(){
    var shown=0;
    tiles.forEach(function(el){
      var okKind=(curF==='all'||el.getAttribute('data-kind')===curF);
      var okQ=!q||(el.getAttribute('data-name')||'').indexOf(q)!==-1;
      var show=okKind&&okQ;
      el.style.display=show?'':'none';
      if(show)shown++;
    });
    if(noRes)noRes.style.display=shown?'none':'block';
  }
  tabs.forEach(function(tb){
    tb.addEventListener('click',function(){
      tabs.forEach(function(t){t.classList.toggle('on',t===tb);});
      curF=tb.getAttribute('data-filter');
      applyFilter();
    });
  });
  if(searchEl){
    searchEl.addEventListener('input',function(){ q=searchEl.value.trim().toLowerCase(); applyFilter(); });
  }
})();
</script>

