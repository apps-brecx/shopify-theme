    { "type": "text", "id": "band_cap", "label": "Caption", "default": "Slow mornings, loud kitchens, drinks for both." },

    { "type": "header", "content": "Holiday menu" },
    { "type": "text", "id": "menu_kick", "label": "Eyebrow", "default": "The holiday menu" },
    { "type": "text", "id": "menu_title", "label": "Title", "default": "Three drinks worth staying in for" },

    { "type": "header", "content": "Giant scrolling type" },
    { "type": "checkbox", "id": "show_giant", "label": "Show", "default": true },
    { "type": "text", "id": "giant_text", "label": "Text", "default": "Merry and mixable" },

    { "type": "header", "content": "Closing" },
    { "type": "text", "id": "end_title", "label": "Title", "default": "Make it a Syruvia season" },
    { "type": "textarea", "id": "end_sub", "label": "Subline", "default": "The flavors leave when winter does. Pour them while they are here." },
    { "type": "text", "id": "end_cta", "label": "Button label", "default": "Shop holiday" },
    { "type": "url", "id": "end_url", "label": "Button link (default: the collection)" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "c_cream", "label": "Cream background", "default": "#FAF6EE" },
    { "type": "color", "id": "c_pine", "label": "Pine", "default": "#14332A" },
    { "type": "color", "id": "c_berry", "label": "Berry", "default": "#A61E2A" },
    { "type": "color", "id": "c_gold", "label": "Gold", "default": "#C9A24B" }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Gift tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "color", "id": "bg", "label": "Background", "default": "#14332A" },
        { "type": "color", "id": "tx", "label": "Text color", "default": "#FAF6EE" },
        { "type": "checkbox", "id": "bordered", "label": "Add thin border (for light tiles)", "default": false }
      ]
    },
    {
      "type": "recipe",
      "name": "Menu recipe",
      "settings": [
        { "type": "text", "id": "title", "label": "Drink name" },
        { "type": "textarea", "id": "text", "label": "How to make it" },
        { "type": "text", "id": "tag", "label": "Small tag" },
        { "type": "image_picker", "id": "img", "label": "Photo" },
        { "type": "text", "id": "hint", "label": "Photo idea (shown in editor until you upload)" }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
